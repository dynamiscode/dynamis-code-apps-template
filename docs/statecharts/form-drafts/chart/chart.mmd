---
title: "A form that keeps your unsent text"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: done
    lg1: error
    lg2: active
  }
  class lg0 teal
  class lg1 orange
  class lg2 blue
  s0: Empty form
  s1: Left the page, nothing unsent
  s2: Text typed, draft kept
  s3: Sending
  s4: Left the page, draft kept in this tab
  s5: Error shown, your text kept
  s6: Saved, form empty
  [*] --> s0
  s0 --> s1: you leave (warned if unsaved)
  s0 --> s2: you type
  s1 --> s0: you come back
  s2 --> s0: you clear the field or you press Discard changes
  s2 --> s3: you submit
  s2 --> s4: you leave (warned if unsaved)
  s3 --> s5: the server rejects it
  s3 --> s6: the server saves it
  s4 --> s2: you come back
  s5 --> s0: you clear the field or you press Discard changes
  s5 --> s3: you submit
  s5 --> s4: you leave (warned if unsaved)
  s6 --> s1: you leave (warned if unsaved)
  s6 --> s2: you type
  class s0 blue
  class s2 blue
  class s5 orange
  class s6 teal
