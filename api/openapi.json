{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Dynamis Code Apps Template API",
    "version": "1.0.0",
    "description": "Stable v1 REST contract. Additive changes preserve authorization, ordering, errors, and side effects. Breaking changes require a new version or published migration window. Query collections use bounded filters, literal search, deterministic sorting, and opaque query-bound cursors. Errors use RFC 9457 Problem Details. See docs/api.md for the human-readable reference."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {"description": "Process is alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthAlive"}}}}
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {"description": "Required dependencies are ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthReady"}}}},
          "503": {"description": "A required dependency is unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthNotReady"}}}}
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "responses": {
          "200": {"description": "OpenAPI 3.1 contract", "content": {"application/json": {"schema": {"type": "object"}}}}
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginLocal",
        "description": "Limited to 10 attempts per source address per minute by default.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}},
        "responses": {
          "200": {"description": "Browser session created", "headers": {"Set-Cookie": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginResponse"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutLocal",
        "security": [{"sessionCookie": []}],
        "parameters": [{"$ref": "#/components/parameters/CSRFToken"}],
        "responses": {
          "204": {"description": "Local session revoked"},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/items": {
      "get": {
        "operationId": "listItems",
        "description": "Returns a deterministic page. Search is a trimmed, case-insensitive literal substring of title. The cursor is opaque and bound to status, search, and sort.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceId"},
          {"$ref": "#/components/parameters/ItemStatus"},
          {"$ref": "#/components/parameters/ItemSearch"},
          {"$ref": "#/components/parameters/ItemSort"},
          {"$ref": "#/components/parameters/PageLimit"},
          {"$ref": "#/components/parameters/PageCursor"}
        ],
        "responses": {
          "200": {"description": "Stable cursor page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemPage"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "post": {
        "operationId": "createItem",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateItemRequest"}}}},
        "responses": {
          "201": {"description": "Item created; identical replays return the original body", "headers": {"ETag": {"schema": {"type": "string"}}, "Location": {"schema": {"type": "string"}}, "Idempotency-Replayed": {"schema": {"type": "boolean"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/export": {
      "get": {
        "operationId": "exportWorkspace",
        "description": "Returns a bounded, point-in-time workspace export. Authentication secrets and transient records are excluded.",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {
          "200": {"description": "Workspace export", "headers": {"Content-Disposition": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceExport"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/files": {
      "get": {
        "operationId": "listFiles", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/PageLimit"}],
        "responses": {"200": {"description": "Ready workspace files", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FilePage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      },
      "post": {
        "operationId": "createFile", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/UploadFileRequest"}}, "application/json": {"schema": {"$ref": "#/components/schemas/InitiateFileRequest"}}}},
        "responses": {"201": {"description": "File uploaded or upload initiated", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/files/uploads": {
      "post": {
        "operationId": "initiateFileUpload", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InitiateFileRequest"}}}},
        "responses": {"201": {"description": "Upload initiated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/files/{fileId}": {
      "get": {
        "operationId": "getFile", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/FileId"}],
        "responses": {"200": {"description": "Private file metadata and short-lived download URL", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileResponse"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/files/{fileId}/content": {
      "put": {
        "operationId": "uploadFileContent", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/FileId"}],
        "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {"200": {"description": "File finalized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      },
      "get": {
        "operationId": "getFileContent", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/FileId"}],
        "responses": {"200": {"description": "Private file content or redirect to a short-lived object URL", "headers": {"Content-Disposition": {"schema": {"type": "string"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "302": {"description": "Redirect to a short-lived private object URL"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/files/{fileId}/complete": {
      "post": {
        "operationId": "completeFileUpload", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/FileId"}],
        "responses": {"200": {"description": "External upload verified", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/webhooks": {
      "get": {
        "operationId": "listWebhooks", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Workspace webhooks without secrets", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      },
      "post": {
        "operationId": "createWebhook", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateWebhookRequest"}}}},
        "responses": {"201": {"description": "Webhook created; secret is returned once", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSecretResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/webhooks/{webhookId}": {
      "delete": {
        "operationId": "deleteWebhook", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/WebhookId"}],
        "responses": {"204": {"description": "Webhook deleted"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/webhooks/{webhookId}/secret": {
      "post": {
        "operationId": "rotateWebhookSecret", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/WebhookId"}],
        "responses": {"200": {"description": "New webhook secret; returned once", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSecretOnly"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/webhooks/{webhookId}/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/WebhookId"}],
        "responses": {"200": {"description": "Bounded webhook delivery history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookDeliveryPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/import": {
      "post": {
        "operationId": "importWorkspace",
        "description": "Atomically imports bounded item records from a workspace export JSON document or title,status CSV. Source IDs, timestamps, memberships, audit events, and credentials are ignored.",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceExport"}}, "text/csv": {"schema": {"type": "string"}}}},
        "responses": {
          "200": {"description": "Imported item count", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceImportResult"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/members": {
      "get": {
        "operationId": "listMembers", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Workspace members", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemberPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/members/{userId}": {
      "patch": {
        "operationId": "changeMemberRole", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/UserId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemberRoleRequest"}}}},
        "responses": {"204": {"description": "Member role changed"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      },
      "delete": {
        "operationId": "removeMember", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/UserId"}],
        "responses": {"204": {"description": "Member removed"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/ownership": {
      "post": {
        "operationId": "transferOwnership", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OwnershipRequest"}}}},
        "responses": {"204": {"description": "Ownership transferred"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/invitations": {
      "get": {
        "operationId": "listInvitations", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Workspace invitations", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvitationPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      },
      "post": {
        "operationId": "createInvitation", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateInvitationRequest"}}}},
        "responses": {"201": {"description": "Invitation created", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvitationLinkResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/invitations/{invitationId}/resend": {
      "post": {
        "operationId": "resendInvitation", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/InvitationId"}],
        "responses": {"200": {"description": "Invitation resent", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvitationLinkResponse"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/invitations/{invitationId}": {
      "delete": {
        "operationId": "revokeInvitation", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/InvitationId"}],
        "responses": {"204": {"description": "Invitation revoked"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/tokens": {
      "get": {
        "operationId": "listTokens", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Current user's workspace tokens", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      },
      "post": {
        "operationId": "createToken", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateTokenRequest"}}}},
        "responses": {"201": {"description": "Token created; secret is returned once", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenSecretResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/tokens/{tokenId}": {
      "patch": {
        "operationId": "updateToken", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/TokenId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenScopesRequest"}}}},
        "responses": {"204": {"description": "Token scopes changed"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      },
      "delete": {
        "operationId": "revokeToken", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/TokenId"}],
        "responses": {"204": {"description": "Token revoked"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessions", "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Current user's sessions without secrets", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/sessions/{sessionId}": {
      "delete": {
        "operationId": "revokeSession", "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/SessionId"}],
        "responses": {"204": {"description": "Session revoked"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/workspaces/{workspaceId}/items/{itemId}": {
      "get": {
        "operationId": "getItem",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ItemId"}, {"name": "If-None-Match", "in": "header", "description": "Strong item ETag previously returned by this resource.", "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Item", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "304": {"description": "The current representation matches If-None-Match"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "patch": {
        "operationId": "updateItem",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceId"},
          {"$ref": "#/components/parameters/ItemId"},
          {"name": "If-Match", "in": "header", "required": true, "description": "Strong item ETag previously returned by this resource.", "schema": {"type": "string"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateItemRequest"}}}},
        "responses": {
          "200": {"description": "Updated item", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "412": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "428": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "delete": {
        "operationId": "deleteItem",
        "description": "Permanently deletes the item from live storage. Existing backups retain it until their documented expiry.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceId"},
          {"$ref": "#/components/parameters/ItemId"},
          {"name": "If-Match", "in": "header", "required": true, "description": "Strong item ETag previously returned by this resource.", "schema": {"type": "string"}}
        ],
        "responses": {
