DATABASE_DRIVER=sqlite
SQLITE_PATH=data/app.db
DATABASE_MAX_OPEN_CONNS=4
DATABASE_MAX_IDLE_CONNS=2

OIDC_ENABLED=false

# Optional invitation email delivery. APP_PUBLIC_URL is required when SMTP is enabled.
APP_PUBLIC_URL=
SMTP_HOST=
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

HTTP_ADDRESS=127.0.0.1:8080
HTTP_SECURE=false
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READINESS_TIMEOUT=2s
HTTP_MAX_HEADER_BYTES=32768
HTTP_MAX_BODY_BYTES=1048576
HTTP_DEFAULT_PAGE_SIZE=50
HTTP_MAX_PAGE_SIZE=100
HTTP_REQUESTS_PER_MINUTE=120
HTTP_AUTH_REQUESTS_PER_MINUTE=10
HTTP_SSE_POLL_INTERVAL=1s
HTTP_SSE_HEARTBEAT_INTERVAL=15s
HTTP_SSE_MAX_LIFETIME=5m
HTTP_SSE_MAX_CONNECTIONS=100
HTTP_SSE_MAX_CONNECTIONS_PER_USER=5
HTTP_MAX_CONCURRENT_REQUESTS=100

# Exact browser origins allowed to POST to /mcp. Non-browser clients omit Origin.
MCP_ALLOWED_ORIGINS=

ITEMS_MAX_PER_WORKSPACE=10000
EXPORT_MAX_RECORDS=1000
EXPORT_MAX_BYTES=4194304
AUDIT_RETENTION=8760h

OTEL_SERVICE_NAME=dynamis-code-apps-template
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=30s
OTEL_EXPORTER_OTLP_TIMEOUT=10s
# OTEL_EXPORTER_OTLP_HEADERS is a deployment secret when an exporter requires it.

# Optional OIDC provider (all required when enabled):
# OIDC_PROVIDER_ID=company
# OIDC_PROVIDER_NAME=Company login
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=apps-template
# OIDC_CLIENT_SECRET=inject-through-deployment-secrets
# OIDC_REDIRECT_URL=https://app.example.com/auth/oidc/company/callback

# PostgreSQL alternative:
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/app?sslmode=disable
