#!/bin/sh
set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$staged_files" ]; then
	unformatted=$(gofmt -l $staged_files)
	if [ -n "$unformatted" ]; then
		echo "Formatting error: The following Go file(s) are not formatted according to gofmt:" >&2
		echo "$unformatted" >&2
		echo "Run: gofmt -w <file>" >&2
		exit 1
	fi
fi

conflict_markers=$(git diff --cached -U0 | grep -E '^\+(<<<<<<< |>>>>>>> )' || true)
if [ -n "$conflict_markers" ]; then
	echo "Conflict markers are staged. Resolve them before committing:" >&2
	echo "$conflict_markers" >&2
	exit 1
fi

make vet generate-check js-check
