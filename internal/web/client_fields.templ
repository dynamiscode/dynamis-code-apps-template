package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "example.com/dynamis-code/apps-template/internal/clients"
templ clientFieldsPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.T("clients.fields_title"), data.T("clients.title")) {
			<a class="btn btn-ghost" href={ clientFieldsBackPath(data.FieldsPath) }>{ data.T("clients.back") }</a>
		}
		@clientFieldList(data)
	}
}

func clientFieldsBackPath(fieldsPath string) string {
	return fieldsPath[:len(fieldsPath)-len("/client-fields")] + "/clients"
}

templ clientFieldList(data viewmodel.PageData) {
	<section id="client-field-list" class="client-panel" aria-labelledby="client-fields-heading">
		<h2 id="client-fields-heading" class="visually-hidden">{ data.T("clients.fields_title") }</h2>
		<p class="client-intro">{ data.T("clients.fields_intro") }</p>
		if data.ErrorKey != "" {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		if data.CanManageFields {
			@atoms.CollapseDetails(atoms.CollapseDetailsProps{
				Class: "client-controls client-create",
				Open:  data.ErrorKey != "",
				Title: data.T("clients.new_field"),
			}) {
				<form action={ data.FieldsPath } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.TextField("client-field-label", data.T("clients.field_label"), templ.Attributes{"name": "label", "required": true, "maxlength": "100", "value": data.FieldDraft.Label, "data-trim": ""})
					@atoms.Select(atoms.SelectProps{
									ID: "client-field-type", Name: "type", Label: data.T("clients.field_type"),
																		Options: []atoms.SelectOption{
										{Label: data.T("clients.field_type_text"), Value: "text", Selected: data.FieldDraft.Type == "" || data.FieldDraft.Type == "text"},
										{Label: data.T("clients.field_type_number"), Value: "number", Selected: data.FieldDraft.Type == "number"},
										{Label: data.T("clients.field_type_date"), Value: "date", Selected: data.FieldDraft.Type == "date"},
										{Label: data.T("clients.field_type_yes_no"), Value: "yes_no", Selected: data.FieldDraft.Type == "yes_no"},
										{Label: data.T("clients.field_type_single_choice"), Value: "single_choice", Selected: data.FieldDraft.Type == "single_choice"},
									},
					})
					<div class="actions">@molecules.SubmitButton(data.T("clients.add_field"), nil)</div>
				</form>
			}
		} else {
			<p class="status">{ data.T("clients.fields_read_only") }</p>
		}
		if len(data.ClientFields) > 0 {
			<ul class="client-fields">
				for _, field := range data.ClientFields {
					<li class="client-field-card">
						<div class="client-field-heading">
							<strong>{ field.Label }</strong>
							<span>{ data.T("clients.field_type_" + field.Type) }</span>
							<span class="status">{ data.T(clientFieldStatusKey(field.ArchivedAt != nil)) }</span>
						</div>
						if data.CanManageFields {
							<div class="client-field-actions">
								if field.ArchivedAt != nil {
									<form method="post" action={ data.FieldsPath + "/" + field.ID.String() + "/restore" }><input type="hidden" name="csrf" value={ data.CSRF }/>@atoms.Button(atoms.ButtonProps{Class: "btn-secondary", Label: data.T("clients.restore_field"), Attrs: templ.Attributes{"type": "submit"}})</form>
									<div class="client-delete"><p class="warning">{ data.T("clients.delete_field_confirm") }</p><form method="post" action={ data.FieldsPath + "/" + field.ID.String() + "/delete" }><input type="hidden" name="csrf" value={ data.CSRF }/>@molecules.ConfirmButton(data.T("clients.delete_field"), data.T("clients.delete_field_confirm"), nil)</form></div>
								} else {
									<form method="post" action={ data.FieldsPath + "/" + field.ID.String() + "/archive" }><input type="hidden" name="csrf" value={ data.CSRF }/>@atoms.Button(atoms.ButtonProps{Class: "btn-secondary", Label: data.T("clients.archive_field"), Attrs: templ.Attributes{"type": "submit"}})</form>
								}
							</div>
						}
						if field.Type == clients.FieldTypeSingleChoice {
							<div class="client-field-options">
								<h3>{ data.T("clients.options_heading") }</h3>
								if len(field.Options) > 0 {
									<ul class="client-field-option-list">
						for _, option := range field.Options {
							<li>
								<span>{ option.Label }</span>
								if data.CanManageFields {
									<form method="post" action={ data.FieldsPath + "/" + field.ID.String() + "/options/" + option.ID.String() + "/delete" }>
										<input type="hidden" name="csrf" value={ data.CSRF }/>
										<p class="warning">{ data.T("clients.option_delete_confirm") }</p>
										@molecules.ConfirmButton(data.T("clients.option_delete"), data.T("clients.option_delete_confirm"), nil)
									</form>
								}
							</li>
										}
									</ul>
								} else {
									<p>{ data.T("clients.option_none") }</p>
								}
								if data.CanManageFields && field.ArchivedAt == nil {
									<form class="option-create" action={ data.FieldsPath + "/" + field.ID.String() + "/options" } method="post"><input type="hidden" name="csrf" value={ data.CSRF }/>@molecules.TextField("option-label-"+field.ID.String(), data.T("clients.option_label"), templ.Attributes{"name": "label", "required": true, "maxlength": "100", "data-trim": ""})@molecules.SubmitButton(data.T("clients.option_add"), nil)</form>
								}
							</div>
						}
					</li>
				}
			</ul>
		} else {
			<p class="status">{ data.T("clients.fields_none") }</p>
		}
	</section>
}

func clientFieldStatusKey(archived bool) string {
	if archived {
		return "clients.field_archived"
	}
	return "clients.field_active"
}
