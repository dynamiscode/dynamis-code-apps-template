package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/components"
import "example.com/dynamis-code/apps-template/internal/web/layouts"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

templ authLayout(data viewmodel.PageData, heading string) {
	<!doctype html>
	<html lang={ data.Locale } data-theme={ data.Theme }>
		<head>
			@layouts.PageHead(data, heading)
		</head>
		<body x-data="pageBehaviors">
			@layouts.SkipLink(data)
			<main class="narrow auth-card" id="main">
				<div class="brand auth-brand"><span class="brand-mark" aria-hidden="true"></span>{ data.T("common.product_name") }</div>
				{ children... }
			</main>
		<script defer src="/assets/alpine-components.js"></script>
		<script defer src="/assets/js/alpine.min.js"></script>
		</body>
	</html>
}

templ authLogin(data viewmodel.PageData) {
	@authLayout(data, data.T("account.sign_in")) {
		<h1>{ data.T("account.sign_in") }</h1>
		<p class="auth-intro">{ data.T("account.sign_in_description") }</p>
		if data.Error != "" {
			@components.ErrorAlert(data.Error)
		}
		<form action="/login" method="post">
			<input type="hidden" name="csrf" value={ data.CSRF }/>
			<input type="hidden" name="return_to" value={ data.ReturnTo }/>
			@atoms.Input(atoms.InputProps{
				ID:        "email",
				Name:      "email",
				Label:     data.T("common.email"),
				Type:      "email",
				Value:     data.Email,
				Required:  true,
				MaxLength: "320",
				Attrs:     templ.Attributes{"autocomplete": "username", "data-trim": true},
			})
			@atoms.Input(atoms.InputProps{
				ID:        "password",
				Name:      "password",
				Label:     data.T("common.password"),
				Type:      "password",
				Required:  true,
				MaxLength: "1024",
				Attrs:     templ.Attributes{"autocomplete": "current-password"},
			})
			@components.SubmitButton(data.T("account.sign_in"), nil)
		</form>
		<p><a class="auth-recovery-link" href="/password-reset">{ data.T("account.forgot_password") }</a></p>
		if len(data.OIDCProviders) > 0 {
			<section class="auth-method" aria-labelledby="auth-provider-heading">
				<h2 id="auth-provider-heading">{ data.T("account.other_sign_in_methods") }</h2>
				<div class="auth-provider-list">
					for _, provider := range data.OIDCProviders {
						<a class="btn" href={ "/auth/oidc/" + provider.ID }>{ data.T("account.sign_in_with", map[string]any{"provider": provider.Name}) }</a>
					}
				</div>
			</section>
		}
	}
}

templ authSetup(data viewmodel.PageData) {
	@authLayout(data, data.T("setup.title")) {
		<h1>{ data.T("setup.title") }</h1>
		<p class="auth-intro">{ data.T("setup.description") }</p>
		<p class="auth-note" data-setup-optional>{ data.T("setup.optional_later") }</p>
		if data.Error != "" {
			@components.ErrorAlert(data.Error)
		}
		<form action="/setup" method="post" data-wizard>
			<input type="hidden" name="csrf" value={ data.CSRF }/>
			<fieldset data-step>
				<legend>{ data.T("setup.step_account") }</legend>
				if data.SetupTokenRequired {
					@atoms.Select(atoms.SelectProps{
						ID:      "setup-token-format",
						Name:    "setup_token_format",
						Label:   data.T("setup.token_format"),
						Options: setupTokenFormatOptions(data),
					})
					@atoms.Input(atoms.InputProps{
						ID:        "setup-token",
						Name:      "setup_token",
						Label:     data.T("setup.setup_token"),
						Type:      "password",
						Required:  true,
						MaxLength: "4096",
						Attrs:     templ.Attributes{"autocomplete": "off"},
					})
				}
				@atoms.Input(atoms.InputProps{
					ID:        "email",
					Name:      "email",
					Label:     data.T("common.email"),
					Type:      "email",
					Value:     data.Email,
					Required:  true,
					MaxLength: "320",
					Attrs:     templ.Attributes{"autocomplete": "username", "data-trim": true},
				})
				@atoms.Input(atoms.InputProps{
					ID:        "password",
					Name:      "password",
					Label:     data.T("common.password"),
					Type:      "password",
					Required:  true,
					MinLength: "12",
					MaxLength: "1024",
					Attrs:     templ.Attributes{"autocomplete": "new-password", "data-strength": true},
				})
				@atoms.Input(atoms.InputProps{
					ID:        "password-confirmation",
					Name:      "password_confirmation",
					Label:     data.T("setup.confirm_password"),
					Type:      "password",
					Required:  true,
					MinLength: "12",
					MaxLength: "1024",
					Attrs:     templ.Attributes{"autocomplete": "new-password", "data-match": "password"},
				})
			</fieldset>
			<fieldset data-step>
				<legend>{ data.T("setup.step_workspace") }</legend>
				@atoms.Input(atoms.InputProps{
					ID:        "workspace",
					Name:      "workspace",
					Label:     data.T("workspace.name"),
					Type:      "text",
					Value:     data.WorkspaceName,
					Required:  true,
					MaxLength: "120",
					Attrs:     templ.Attributes{"autocomplete": "organization", "data-trim": true},
				})
				@atoms.Select(atoms.SelectProps{
					ID:      "workspace-locale",
					Name:    "workspace_locale",
					Label:   data.T("workspace.language_fallback"),
					Options: workspaceLocaleOptions(data),
				})
			</fieldset>
			@components.SubmitButton(data.T("setup.create_owner"), nil)
		</form>
	}
}

templ authPasswordReset(data viewmodel.PageData) {
	@authLayout(data, data.T(authPasswordResetTitle(data))) {
		<h1>{ data.T(authPasswordResetTitle(data)) }</h1>
		if data.Saved {
			@components.SuccessAlert(data.T(authPasswordResetSuccess(data)))
			<p>@components.LinkButton("/login", data.T("account.sign_in"))</p>
		} else {
			if data.ErrorKey != "" {
				@components.ErrorAlert(data.T(data.ErrorKey))
			}
			if data.PasswordResetSecret != "" {
				<p class="auth-intro">{ data.T("account.choose_password_description") }</p>
				<form action={ "/password-reset/" + data.PasswordResetSecret } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Input(atoms.InputProps{
						ID:        "reset-password",
						Name:      "password",
						Label:     data.T("account.new_password"),
						Type:      "password",
						Required:  true,
						MinLength: "12",
						MaxLength: "1024",
						Attrs:     templ.Attributes{"autocomplete": "new-password", "data-strength": true},
					})
					@atoms.Input(atoms.InputProps{
						ID:        "reset-password-confirmation",
						Name:      "password_confirmation",
						Label:     data.T("account.confirm_password"),
						Type:      "password",
						Required:  true,
						MinLength: "12",
						MaxLength: "1024",
						Attrs:     templ.Attributes{"autocomplete": "new-password", "data-match": "reset-password"},
					})
					@components.SubmitButton(data.T("account.reset_password"), nil)
				</form>
			} else {
				<p class="auth-intro">{ data.T("account.password_reset_description") }</p>
				<form action="/password-reset" method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Input(atoms.InputProps{
						ID:        "reset-email",
						Name:      "email",
						Label:     data.T("common.email"),
						Type:      "email",
						Required:  true,
						MaxLength: "320",
						Attrs:     templ.Attributes{"autocomplete": "username"},
					})
					@components.SubmitButton(data.T("account.send_reset"), nil)
				</form>
			}
		}
	}
}

templ authMFA(data viewmodel.PageData) {
	@authLayout(data, data.T("security.mfa_title")) {
		<h1>{ data.T("security.mfa_title") }</h1>
		<p class="auth-intro">{ data.T("security.mfa_verify_prompt") }</p>
		if data.MFAError != "" {
			@components.ErrorAlert(data.MFAError)
		}
		if len(data.MFAOptions) > 0 {
			<section class="auth-method" x-data="passkeyLogin" aria-labelledby="passkey-heading">
				<h2 id="passkey-heading">{ data.T("security.mfa_use_passkey") }</h2>
				@atoms.Button(atoms.ButtonProps{
					Class: "btn-primary",
					Label: data.T("security.mfa_use_passkey"),
					Attrs: templ.Attributes{"id": "passkey-login", "type": "button", "data-challenge": data.MFAChallenge, "data-csrf": data.CSRF},
				})
				@templ.JSONScript("mfa-options", data.MFAOptions)
			</section>
		}
		<section class="auth-method" aria-labelledby="totp-heading">
			<h2 id="totp-heading">{ data.T("security.mfa_authenticator") }</h2>
			<p>{ data.T("security.mfa_authenticator_description") }</p>
			<form action="/mfa/totp" method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				@atoms.Input(atoms.InputProps{
					ID:        "totp-code",
					Name:      "code",
					Label:     data.T("security.mfa_authenticator_code"),
					Required:  true,
					MinLength: "6",
					MaxLength: "9",
					Attrs:     templ.Attributes{"inputmode": "numeric", "autocomplete": "one-time-code", "data-mask": "digits", "data-mask-length": "6"},
				})
				@components.SubmitButton(data.T("security.mfa_verify_code"), nil)
			</form>
		</section>
		<section class="auth-method" aria-labelledby="recovery-heading">
			<h2 id="recovery-heading">{ data.T("security.mfa_recovery_title") }</h2>
			<p>{ data.T("security.mfa_recovery_description") }</p>
			<form action="/mfa/recovery" method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				@atoms.Input(atoms.InputProps{
					ID:        "recovery-code",
					Name:      "code",
					Label:     data.T("security.mfa_recovery_code"),
					Required:  true,
					Attrs:     templ.Attributes{"autocomplete": "one-time-code", "autocapitalize": "characters", "spellcheck": "false", "data-mask": "upper"},
				})
				@components.SubmitButton(data.T("security.mfa_use_recovery"), nil)
			</form>
		</section>
	}
}

templ authEmailVerification(data viewmodel.PageData) {
	@authLayout(data, data.T("account.email_verification")) {
		<h1>{ data.T("account.email_verification") }</h1>
		if data.Saved {
			@components.SuccessAlert(data.T("account.email_verified"))
			<p>@components.LinkButton("/account", data.T("account.return_account"))</p>
		} else {
			@components.ErrorAlert(data.Error)
			<p>@components.LinkButton("/login", data.T("account.sign_in"))</p>
		}
	}
}

func authPasswordResetTitle(data viewmodel.PageData) string {
	if data.PasswordResetCompleted {
		return "account.password_reset_completed_title"
	}
	if data.PasswordResetSecret != "" {
		return "account.choose_password_title"
	}
	return "account.reset_password"
}

func authPasswordResetSuccess(data viewmodel.PageData) string {
	if data.PasswordResetCompleted {
		return "account.password_reset_done"
	}
	return "account.password_reset_requested"
}

func setupTokenFormatOptions(data viewmodel.PageData) []atoms.SelectOption {
	return []atoms.SelectOption{
		{Label: data.T("setup.token_plain"), Value: "plain"},
		{Label: data.T("setup.token_base64"), Value: "base64"},
	}
}

func workspaceLocaleOptions(data viewmodel.PageData) []atoms.SelectOption {
	return []atoms.SelectOption{
		{Label: data.T("common.english"), Value: "en", Selected: data.WorkspaceLocale == "en" || (data.WorkspaceLocale == "" && data.Locale == "en")},
		{Label: data.T("common.spanish"), Value: "es", Selected: data.WorkspaceLocale == "es" || (data.WorkspaceLocale == "" && data.Locale == "es")},
	}
}
