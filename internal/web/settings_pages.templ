package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"


templ generalSettingsView(data viewmodel.PageData) {
	@templates.DashboardShell(data, templates.DashboardSettings) {
		<div class="settings-page">
			@molecules.PageHeading(data.T("workspace.general_settings"), data.T("navigation.settings_setup"))
			if data.Saved {
				@molecules.SuccessAlert(data.T("workspace.settings_saved"))
			}
			if data.Error != "" {
				@molecules.ErrorAlert(data.Error)
			}
			if data.CatalogEnabled {
				<section class="settings-panel card min-w-0 p-5" aria-labelledby="currency-settings-title">
					<h2 id="currency-settings-title">{ data.T("currency.title") }</h2>
					<p>{ data.T("currency.intro") }</p>
					<a class="btn btn-outline" href={ "/workspaces/" + data.Workspace.ID.String() + "/settings/currencies" }>{ data.T("currency.manage") }</a>
				</section>
			}
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="workspace-locale-title">
				<h2 id="workspace-locale-title">{ data.T("workspace.language_fallback") }</h2>
				<p class="settings-intro" id="workspace-locale-help">{ data.T("workspace.language_fallback_description") }</p>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/general" } method="post" data-dirty-track data-unsaved-warning>
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Select(atoms.SelectProps{
						ID: "workspace-locale", Name: "locale", Label: data.T("common.language"),
						Attrs: templ.Attributes{"aria-describedby": "workspace-locale-help", "disabled": !data.CanManage},
						Options: []atoms.SelectOption{
							{Label: data.T("common.english"), Value: "en", Selected: data.Workspace.Locale == "en"},
							{Label: data.T("common.spanish"), Value: "es", Selected: data.Workspace.Locale == "es"},
						},
					})
					if data.CanManage {
						@molecules.SubmitButton(data.T("common.save"), templ.Attributes{"data-requires-change": true})
					}
				</form>
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="workspace-notifications-title">
				<h2 id="workspace-notifications-title">{ data.T("account.notifications") }</h2>
				if len(data.WorkspaceNotificationPreferences) > 0 {
					<ul class="settings-records grid list-none gap-4 p-0">
						for _, preference := range data.WorkspaceNotificationPreferences {
							<li class="settings-record card card-compact flex flex-wrap items-center justify-between gap-4 bg-base-200 px-4 py-3"><span>{ workspaceNotificationLabel(data, preference.NotificationType) }</span><span>
								if preference.Enabled {
									{ data.T("account.enabled") }
								} else {
									{ data.T("account.disabled") }
								}
							</span></li>
						}
					</ul>
				} else {
					@molecules.EmptyState(data.T("workspace.notifications_empty"))
				}
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/notifications" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Select(atoms.SelectProps{
						ID: "workspace-notification-type", Name: "notification_type", Label: data.T("account.notification_type"),
						Options: []atoms.SelectOption{
							{Label: data.T("workspace.notification_security"), Value: "security"},
							{Label: data.T("workspace.notification_workspace"), Value: "workspace"},
							{Label: data.T("workspace.notification_system"), Value: "system"},
						},
					})
					@atoms.Select(atoms.SelectProps{
						ID: "workspace-notification-enabled", Name: "enabled", Label: data.T("account.notification_delivery"),
						Options: []atoms.SelectOption{
							{Label: data.T("account.enabled"), Value: "true"},
							{Label: data.T("account.disabled"), Value: "false"},
						},
					})
					@molecules.SubmitButton(data.T("common.save"), nil)
				</form>
			</section>
		</div>
	}
}

templ emailSettingsView(data viewmodel.PageData) {
	@templates.DashboardShell(data, templates.DashboardSettings) {
		<div class="settings-page">
			@molecules.PageHeading(data.T("email.title"), data.T("navigation.settings_setup"))
			<p class="settings-intro">{ data.T("email.intro") }</p>
			if data.Error != "" {
				@molecules.ErrorAlert(data.Error)
			}
			if data.EmailLoginReason != "" {
				<p><code>{ data.EmailLoginReason }</code></p>
			}
			if data.EmailSaved {
				@molecules.SuccessAlert(data.T("email.saved"))
			}
			if data.EmailSettings.Configured {
				<p>{ data.T("email.configured") }</p>
			} else {
				<p>{ data.T("email.not_configured") }</p>
			}
			if data.EmailSettings.Provider == "resend" || data.EmailSettings.Provider == "postmark" {
				<p>{ data.T("email.domain_status") }: <code>
					if data.EmailSettings.DomainStatus != "" {
						{ data.EmailSettings.DomainStatus }
					} else {
						{ data.T("email.domain_status_none") }
					}
				</code></p>
			}
			<section class="settings-panel card min-w-0 p-5" aria-label={ data.T("email.title") }>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/email" } method="post" data-dirty-track data-unsaved-warning>
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Select(atoms.SelectProps{
						ID: "email-provider", Name: "provider", Label: data.T("email.provider"),
						Options: []atoms.SelectOption{
							{Label: data.T("email.provider_smtp"), Value: "smtp", Selected: data.EmailSettings.UsesSMTP()},
							{Label: data.T("email.provider_resend"), Value: "resend", Selected: data.EmailSettings.Provider == "resend"},
							{Label: data.T("email.provider_postmark"), Value: "postmark", Selected: data.EmailSettings.Provider == "postmark"},
						},
					})
					@molecules.TextField("email-sender-name", data.T("email.sender_name")+" "+data.T("ui.optional"), templ.Attributes{"name": "sender_name", "maxlength": "100", "value": data.EmailSettings.SenderName})
					@molecules.TextField("email-sender-address", data.T("email.sender_address"), templ.Attributes{"name": "sender_address", "type": "email", "required": true, "maxlength": "254", "value": data.EmailSettings.SenderAddress})
					<fieldset data-show-when="email-provider=smtp">
						<legend>{ data.T("email.smtp_section") }</legend>
						<p id="email-smtp-required">{ data.T("email.required_for_smtp") }</p>
						@molecules.TextField("email-host", data.T("email.host"), templ.Attributes{"name": "host", "maxlength": "253", "aria-describedby": "email-smtp-required", "data-trim": true, "value": emailSMTPValue(data.EmailSettings, data.EmailSettings.Host)})
						@molecules.TextField("email-port", data.T("email.port"), templ.Attributes{"name": "port", "type": "number", "min": "1", "max": "65535", "value": emailPortValue(data.EmailSettings)})
						@molecules.TextField("email-username", data.T("email.username")+" "+data.T("ui.optional"), templ.Attributes{"name": "username", "maxlength": "254", "autocomplete": "off", "value": emailSMTPValue(data.EmailSettings, data.EmailSettings.Username)})
						<p id="email-password-help">{ data.T("email.password_help") }</p>
						@atoms.PlainInput(atoms.InputProps{ID: "email-password", Name: "password", Type: "password", Label: data.T("email.password"), MaxLength: "1024", Attrs: templ.Attributes{"autocomplete": "new-password", "aria-describedby": "email-password-help"}})
					</fieldset>
					<fieldset data-show-when="email-provider=resend">
						<legend>{ data.T("email.resend_section") }</legend>
						<ol>
							<li>{ data.T("email.resend_step_1") }</li><li>{ data.T("email.resend_step_2") }</li><li>{ data.T("email.resend_step_3") }</li><li>{ data.T("email.resend_step_4") }</li>
						</ol>
						<p id="email-api-key-help">{ data.T("email.api_key_help") }</p>
						@atoms.PlainInput(atoms.InputProps{ID: "email-api-key", Name: "api_key", Type: "password", Label: data.T("email.api_key"), MaxLength: "1024", Attrs: templ.Attributes{"autocomplete": "new-password", "aria-describedby": "email-api-key-help"}})
					</fieldset>
					<fieldset data-show-when="email-provider=postmark">
						<legend>{ data.T("email.postmark_section") }</legend>
						<ol>
							<li>{ data.T("email.postmark_step_1") }</li><li>{ data.T("email.postmark_step_2") }</li><li>{ data.T("email.postmark_step_3") }</li><li>{ data.T("email.postmark_step_4") }</li>
						</ol>
						<p id="email-server-token-help">{ data.T("email.server_token_help") }</p>
						@atoms.PlainInput(atoms.InputProps{ID: "email-server-token", Name: "server_token", Type: "password", Label: data.T("email.server_token"), MaxLength: "1024", Attrs: templ.Attributes{"autocomplete": "new-password", "aria-describedby": "email-server-token-help"}})
						<p id="email-account-token-help">{ data.T("email.account_token_help") }</p>
						if data.EmailSettings.AccountTokenSet {
							<p>{ data.T("email.account_token_set") }</p>
						}
						@atoms.PlainInput(atoms.InputProps{ID: "email-account-token", Name: "account_token", Type: "password", Label: data.T("email.account_token"), MaxLength: "1024", Attrs: templ.Attributes{"autocomplete": "new-password", "aria-describedby": "email-account-token-help"}})
					</fieldset>
					@molecules.SubmitButton(data.T("email.save"), nil)
				</form>
			</section>
		</div>
	}
}

templ exportSettingsView(data viewmodel.PageData) {
	@templates.DashboardShell(data, templates.DashboardSettings) {
		<div class="settings-page">
			@molecules.PageHeading(data.Workspace.Name+" "+data.T("navigation.export"), data.T("navigation.settings_activity"))
			<p class="settings-intro">{ data.T("export.description") }</p>
			<section class="settings-panel card min-w-0 p-5" aria-label={ data.T("navigation.export") }>
				<a href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/settings/export/download") } class="btn btn-primary" data-webmcp-export>{ data.T("export.download") + " " }</a>
			</section>
		</div>
	}
}
