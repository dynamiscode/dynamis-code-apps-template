package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/components"
import "example.com/dynamis-code/apps-template/internal/web/layouts"

import "strconv"

templ generalSettingsView(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), layouts.SettingsSidebar(data)) {
		<div class="settings-page">
			@components.PageHeading(data.T("workspace.general_settings"), data.T("navigation.settings_setup"))
			if data.Saved {
				@components.SuccessAlert(data.T("workspace.settings_saved"))
			}
			if data.Error != "" {
				@components.ErrorAlert(data.Error)
			}
			<section class="settings-panel" aria-labelledby="workspace-locale-title">
				<h2 id="workspace-locale-title">{ data.T("workspace.language_fallback") }</h2>
				<p class="settings-intro" id="workspace-locale-help">{ data.T("workspace.language_fallback_description") }</p>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/general" } method="post" data-dirty-track data-unsaved-warning>
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@components.SelectField("workspace-locale", data.T("common.language"), templ.Attributes{"name": "locale", "aria-describedby": "workspace-locale-help", "disabled": !data.CanManage}) {
						<option value="en" selected?={ data.Workspace.Locale == "en" }>{ data.T("common.english") }</option>
						<option value="es" selected?={ data.Workspace.Locale == "es" }>{ data.T("common.spanish") }</option>
					}
					if data.CanManage {
						@components.SubmitButton(data.T("common.save"), templ.Attributes{"data-requires-change": true})
					}
				</form>
			</section>
			<section class="settings-panel" aria-labelledby="workspace-notifications-title">
				<h2 id="workspace-notifications-title">{ data.T("account.notifications") }</h2>
				if len(data.WorkspaceNotificationPreferences) > 0 {
					<ul class="settings-records">
						for _, preference := range data.WorkspaceNotificationPreferences {
							<li class="settings-record"><span>{ workspaceNotificationLabel(data, preference.NotificationType) }</span><span>
								if preference.Enabled {
									{ data.T("account.enabled") }
								} else {
									{ data.T("account.disabled") }
								}
							</span></li>
						}
					</ul>
				} else {
					@components.EmptyState(data.T("workspace.notifications_empty"))
				}
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/notifications" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@components.SelectField("workspace-notification-type", data.T("account.notification_type"), templ.Attributes{"name": "notification_type"}) {
						<option value="security">{ data.T("workspace.notification_security") }</option>
						<option value="workspace">{ data.T("workspace.notification_workspace") }</option>
						<option value="system">{ data.T("workspace.notification_system") }</option>
					}
					@components.SelectField("workspace-notification-enabled", data.T("account.notification_delivery"), templ.Attributes{"name": "enabled"}) {
						<option value="true">{ data.T("account.enabled") }</option>
						<option value="false">{ data.T("account.disabled") }</option>
					}
					@components.SubmitButton(data.T("common.save"), nil)
				</form>
			</section>
		</div>
	}
}

templ emailSettingsView(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), layouts.SettingsSidebar(data)) {
		<div class="settings-page">
			@components.PageHeading(data.T("email.title"), data.T("navigation.settings_setup"))
			<p class="settings-intro">{ data.T("email.intro") }</p>
			if data.Error != "" {
				@components.ErrorAlert(data.Error)
			}
			if data.EmailLoginReason != "" {
				<p><code>{ data.EmailLoginReason }</code></p>
			}
			if data.EmailSaved {
				@components.SuccessAlert(data.T("email.saved"))
			}
			if data.EmailSettings.Configured {
				<p>{ data.T("email.configured") }</p>
			} else {
				<p>{ data.T("email.not_configured") }</p>
			}
			if data.EmailSettings.Provider == "resend" || data.EmailSettings.Provider == "postmark" {
				<p>{ data.T("email.domain_status") }: <code>
					if data.EmailSettings.DomainStatus != "" {
						{ data.EmailSettings.DomainStatus }
					} else {
						{ data.T("email.domain_status_none") }
					}
				</code></p>
			}
			<section class="settings-panel" aria-label={ data.T("email.title") }>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/email" } method="post" data-dirty-track data-unsaved-warning>
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@components.SelectField("email-provider", data.T("email.provider"), templ.Attributes{"name": "provider"}) {
						<option value="smtp" selected?={ data.EmailSettings.UsesSMTP() }>{ data.T("email.provider_smtp") }</option>
						<option value="resend" selected?={ data.EmailSettings.Provider == "resend" }>{ data.T("email.provider_resend") }</option>
						<option value="postmark" selected?={ data.EmailSettings.Provider == "postmark" }>{ data.T("email.provider_postmark") }</option>
					}
					@components.TextField("email-sender-name", data.T("email.sender_name")+" "+data.T("ui.optional"), templ.Attributes{"name": "sender_name", "maxlength": "100", "value": data.EmailSettings.SenderName})
					@components.TextField("email-sender-address", data.T("email.sender_address"), templ.Attributes{"name": "sender_address", "type": "email", "required": true, "maxlength": "254", "value": data.EmailSettings.SenderAddress})
					<fieldset data-show-when="email-provider=smtp">
						<legend>{ data.T("email.smtp_section") }</legend>
						<p id="email-smtp-required">{ data.T("email.required_for_smtp") }</p>
						@components.TextField("email-host", data.T("email.host"), templ.Attributes{"name": "host", "maxlength": "253", "aria-describedby": "email-smtp-required", "data-trim": true, "value": emailSMTPValue(data.EmailSettings, data.EmailSettings.Host)})
						@components.TextField("email-port", data.T("email.port"), templ.Attributes{"name": "port", "type": "number", "min": "1", "max": "65535", "value": emailPortValue(data.EmailSettings)})
						@components.TextField("email-username", data.T("email.username")+" "+data.T("ui.optional"), templ.Attributes{"name": "username", "maxlength": "254", "autocomplete": "off", "value": emailSMTPValue(data.EmailSettings, data.EmailSettings.Username)})
						<label for="email-password">{ data.T("email.password") }</label>
						<p id="email-password-help">{ data.T("email.password_help") }</p>
						<input class="input" id="email-password" name="password" type="password" autocomplete="new-password" maxlength="1024" aria-describedby="email-password-help"/>
					</fieldset>
					<fieldset data-show-when="email-provider=resend">
						<legend>{ data.T("email.resend_section") }</legend>
						<ol>
							<li>{ data.T("email.resend_step_1") }</li><li>{ data.T("email.resend_step_2") }</li><li>{ data.T("email.resend_step_3") }</li><li>{ data.T("email.resend_step_4") }</li>
						</ol>
						<label for="email-api-key">{ data.T("email.api_key") }</label>
						<p id="email-api-key-help">{ data.T("email.api_key_help") }</p>
						<input class="input" id="email-api-key" name="api_key" type="password" autocomplete="new-password" maxlength="1024" aria-describedby="email-api-key-help"/>
					</fieldset>
					<fieldset data-show-when="email-provider=postmark">
						<legend>{ data.T("email.postmark_section") }</legend>
						<ol>
							<li>{ data.T("email.postmark_step_1") }</li><li>{ data.T("email.postmark_step_2") }</li><li>{ data.T("email.postmark_step_3") }</li><li>{ data.T("email.postmark_step_4") }</li>
						</ol>
						<label for="email-server-token">{ data.T("email.server_token") }</label>
						<p id="email-server-token-help">{ data.T("email.server_token_help") }</p>
						<input class="input" id="email-server-token" name="server_token" type="password" autocomplete="new-password" maxlength="1024" aria-describedby="email-server-token-help"/>
						<label for="email-account-token">{ data.T("email.account_token") }</label>
						<p id="email-account-token-help">{ data.T("email.account_token_help") }</p>
						if data.EmailSettings.AccountTokenSet {
							<p>{ data.T("email.account_token_set") }</p>
						}
						<input class="input" id="email-account-token" name="account_token" type="password" autocomplete="new-password" maxlength="1024" aria-describedby="email-account-token-help"/>
					</fieldset>
					@components.SubmitButton(data.T("email.save"), nil)
				</form>
			</section>
		</div>
	}
}

templ exportSettingsHeader(data viewmodel.PageData) {
	<header class="topbar">
		<a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{ data.T("common.product_name") }</a>
		<div class="topbar-context">
			@layouts.DefaultHomeCrumb(data)
			@layouts.WorkspaceContext(data)
		</div>
		@layouts.AccountMenu(data)
	</header>
}

templ exportSettingsView(data viewmodel.PageData) {
	@layouts.DashboardShell(data, exportSettingsHeader(data), layouts.SettingsSidebar(data)) {
		<div class="settings-page">
			@components.PageHeading(data.Workspace.Name+" "+data.T("navigation.export"), data.T("navigation.settings_activity"))
			<p class="settings-intro">{ data.T("export.description") }</p>
			<section class="settings-panel" aria-label={ data.T("navigation.export") }>
				<a class="btn btn-primary" data-webmcp-export href={ "/workspaces/" + data.Workspace.ID.String() + "/settings/export/download" }>{ data.T("export.download") }</a>
			</section>
		</div>
	}
}

templ importSettingsView(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), layouts.SettingsSidebar(data)) {
		<div class="settings-page">
			@components.PageHeading(data.Workspace.Name+" "+data.T("navigation.import"), data.T("navigation.settings_activity"))
			<p class="settings-intro">{ data.T("import.description") }</p>
			if data.ImportCompleted {
				@components.SuccessAlert(data.T("import.success")) {
					{ data.T("import.items_imported") }{ " " }<strong>{ data.Imported }</strong>
				}
			}
			if data.Error != "" {
				@components.ErrorAlert(data.Error)
			}
			<form class="settings-panel import-preview-form" action={ data.CurrentPath } method="post" enctype="multipart/form-data">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				<input type="hidden" name="action" value="preview"/>
				<label for="import-file">{ data.T("import.file") }</label>
				<input class="file-input" id="import-file" name="file" type="file" accept=".json,.csv,application/json,text/csv" required aria-describedby="import-file-help"/>
				<p id="import-file-help">{ data.T("import.file_help") }</p>
				@components.SubmitButton(data.T("import.preview_button"), nil)
			</form>
			if data.ImportPreview != nil {
				<section class="settings-panel import-preview" aria-labelledby="import-preview-heading">
					<h2 id="import-preview-heading">{ data.T("import.preview_heading") }</h2>
					<p>{ data.T("import.preview_records") }: <strong>{ data.ImportPreview.RecordCount }</strong></p>
					<p>{ data.T("import.no_writes_yet") }</p>
					if len(data.ImportPreview.Sample) > 0 {
						<h3>{ data.T("import.preview_sample") }</h3>
						@components.DataTable(data.T("import.preview_sample"), true) {
							<thead><tr><th scope="col">{ data.T("items.title") }</th><th scope="col">{ data.T("items.status") }</th></tr></thead>
							<tbody>
								for _, sample := range data.ImportPreview.Sample {
									<tr><td>{ sample.Title }</td><td>
										if sample.StatusKey != "" {
											{ data.T(sample.StatusKey) }
										} else {
											{ sample.Status }
										}
									</td></tr>
								}
							</tbody>
						}
					}
					if data.ImportPreview.IssueCount > 0 {
						@components.ErrorAlert(data.T("import.invalid_rows") + " " + strconv.Itoa(data.ImportPreview.IssueCount))
						<ul class="import-preview-errors">
							for _, issue := range data.ImportPreview.Issues {
								<li>{ data.T("import.record") }{ " " }{ issue.Record }: { data.T(issue.MessageKey) }</li>
							}
							if data.ImportPreview.MoreIssues > 0 {
								<li>{ data.T("import.more_invalid_rows") }{ " " }{ data.ImportPreview.MoreIssues }</li>
							}
						</ul>
					} else {
						<h3>{ data.T("import.confirm_heading") }</h3>
						<p>{ data.T("import.confirm_reselect") }</p>
						<form class="import-confirm-form" action={ data.CurrentPath } method="post" enctype="multipart/form-data">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							<input type="hidden" name="action" value="confirm"/>
							<input type="hidden" name="preview_digest" value={ data.ImportPreview.Digest }/>
							<input type="hidden" name="preview_format" value={ data.ImportPreview.Format }/>
							<label for="import-confirm-file">{ data.T("import.file") }</label>
							<input class="file-input" id="import-confirm-file" name="file" type="file" accept=".json,.csv,application/json,text/csv" required aria-describedby="import-confirm-file-help"/>
							<p id="import-confirm-file-help">{ data.T("import.confirm_file_help") }</p>
							@components.ConfirmationField("import-confirm", "confirm", data.T("import.confirm"))
							@components.SubmitButton(data.T("import.confirm_button"), nil)
						</form>
					}
				</section>
			}
		</div>
	}
}
