package organisms

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

templ DashboardHeader(data viewmodel.PageData) {
	<header class="navbar sticky top-0 z-30 flex-wrap gap-4 border-b border-base-200 bg-base-100 px-4">
		<div class="navbar-start min-w-0 gap-3">
			<a class="brand inline-flex items-center gap-2 text-lg font-extrabold no-underline" href="/"><span class="brand-mark" aria-hidden="true"></span>{ data.T("common.product_name") }</a>
			if data.TopbarTitleKey != "" {
				<h1 class="m-0 ml-2 text-lg font-bold">{ data.T(data.TopbarTitleKey) }</h1>
			}
			<div class="hidden min-w-0 items-center gap-2 text-base-content/60 sm:flex">
				if data.NavPage == "home" {
					@atoms.Breadcrumbs(atoms.BreadcrumbsProps{
						Items: []atoms.BreadcrumbsProp{{Label: data.T("workspace.workspaces")}},
					})
				} else {
					if data.NavPage == "audit" {
						@molecules.DefaultHomeCrumb(data)
					} else {
						@molecules.WorkspaceListCrumb(data)
					}
					@WorkspaceContext(data)
				}
			</div>
		</div>
		<div class="navbar-end">
			@AccountMenu(data)
		</div>
	</header>
}
