package organisms

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

// ListActionsCell is a row's last cell: a sticky "⋯" menu of the row's actions. It stays on the right while the
// table scrolls sideways. A row with no actions still gets the cell, so the columns line up. The menu's open panel
// is raised above the other rows' cells, so a row's menu is never covered by the row below it.
templ ListActionsCell(data viewmodel.PageData, actions []ListAction) {
	<td class="list-actions-cell">
		@ListActionsMenu(data, actions, false)
	</td>
}

// ListActionsMenu is a row's actions behind a three-dot button. A card uses the vertical dots, a table row the
// horizontal ones. A row with no actions shows nothing.
templ ListActionsMenu(data viewmodel.PageData, actions []ListAction, vertical bool) {
	if len(actions) > 0 {
		@listActionsDropdown(data, vertical) {
			for _, action := range actions {
				@listActionItem(data, action)
			}
		}
	}
}

templ listActionsDropdown(data viewmodel.PageData, vertical bool) {
	<details class="dropdown list-menu">
		@listActionsSummary(data, vertical)
		<ul class="menu dropdown-content list-action-items bg-base-100 rounded-box shadow-lg">
			{ children... }
		</ul>
	</details>
}

// ListActionsContentCell holds custom controls in the same table menu as standard actions.
templ ListActionsContentCell(data viewmodel.PageData) {
	<td class="list-actions-cell">
		@listActionsDropdown(data, false) { <li>{ children... }</li> }
	</td>
}

templ listActionItem(data viewmodel.PageData, action ListAction) {
	if action.Danger {
		<li class="my-1 border-t border-base-content/10"></li>
	}
	<li class="">
		if action.PostPath != "" {
			@listActionForm(data, action)
		} else {
			@listActionLink(action)
		}
	</li>
}

templ listActionsSummary(data viewmodel.PageData, vertical bool) {
	<summary class="btn m-1 btn btn-sm list-row-menu-button" aria-label={ data.T("ui.row_actions") } title={ data.T("ui.row_actions") }>{ " " }@molecules.RowMenuGlyph(vertical)</summary>{ " " }
}

// listActionItemClass is the one class every menu entry wears, whichever element carries the action. A link and a
// POST button then share the same box, padding, glyph gap, and alignment instead of each drifting.
func listActionItemClass(action ListAction) string {
	if action.Danger {
		return "list-action-item is-danger border border-error rounded-field"
	}
	return "list-action-item border border-base-300 rounded-field"
}

// listActionForm is a POST action with its CSRF token. The form is a layout pass-through, so the button sits
// exactly where a link would.
templ listActionForm(data viewmodel.PageData, action ListAction) {
	<form class="list-action-form" method="post" action={ action.PostPath }>
		<input type="hidden" name="csrf" value={ data.CSRF }/>
		if action.ClientDeleteName != "" {
			<button class="list-action-item is-danger" type="submit" data-client-delete data-client-name={ action.ClientDeleteName } data-confirm={ action.Confirm }>
				@ListActionIcon(action.Icon)
				<span>{ action.Label }</span>
			</button>
		} else if action.Danger {
			@molecules.ConfirmButton("", action.Confirm, actionattrs.ButtonClass(listActionItemClass(action)), nil) {
				@ListActionIcon(action.Icon)
				<span>{ action.Label }</span>
			}
		} else {
			<button class={ actionattrs.LinkClass(listActionItemClass(action)) } type="submit" { actionattrs.From(ListActionConfirm(action))... }>
				@ListActionIcon(action.Icon)
				<span>{ action.Label }</span>
			</button>
		}
	</form>
}

// listActionLink is a GET action.
templ listActionLink(action ListAction) {
	<a class={ actionattrs.LinkClass(listActionItemClass(action)) } href={ templ.SafeURL(action.Href) }>
		@ListActionIcon(action.Icon)
		<span>{ action.Label }</span>
	</a>
}

// ListRowMenuCard is a card's menu for the Members rows, whose actions are written in the page. It uses the vertical
// dots.
templ ListRowMenuCard(data viewmodel.PageData) {
	@listActionsDropdown(data, true) { <li>{ children... }</li> }
}

// ListActionIcon is the glyph of a row action. It is decorative: the label names the action.
templ ListActionIcon(name string) {
	<svg class="list-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		if name == "open" {
			<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
		} else if name == "edit" {
			<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
		} else if name == "archive" {
			<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M10 13h4"/>
		} else if name == "unarchive" {
			<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M12 17v-5"/><path d="M9.5 14.5 12 12l2.5 2.5"/>
		} else if name == "delete" {
			<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/>
		} else if name == "download" {
			<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
		}
	</svg>
}
