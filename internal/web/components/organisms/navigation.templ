package organisms

import "strings"

import "example.com/dynamis-code/apps-template/internal/identity"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"


// workspaceSwitcherItem is a daisyUI menu entry with the workspace name and role.
templ workspaceSwitcherItem(href, name, role string, current bool) {
	<a class="border border-base-300" href={ href } aria-current={ currentPage(current) }><strong>{ name }</strong><span class="text-sm">{ role }</span></a>
}


// logoutItem is the POST logout form as a daisyUI menu entry.
templ logoutItem(data viewmodel.PageData) {
	<form action="/logout" method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><button type="submit" class="btn btn-outline btn-sm w-full justify-start font-normal">{ data.T("navigation.sign_out") }</button></form>
}


templ WorkspaceContext(data viewmodel.PageData) {
	if data.SingleWorkspace {
		<span class="truncate font-bold">{ data.Workspace.Name }</span>
	} else {
		<details class="dropdown">
			<summary class="btn m-1 btn-sm h-auto min-h-0 px-2 text-lg font-bold normal-case">{ data.Workspace.Name + " " }@workspaceChevron()</summary>{ " " }
			<ul class="menu dropdown-content w-56 max-w-[90vw] bg-base-100 rounded-box shadow-lg">
				<li class="menu-title">{ data.T("navigation.home") }</li>
				for _, workspace := range data.Workspaces {
					<li class="">@workspaceSwitcherItem("/workspaces/"+workspace.ID.String(), workspace.Name, data.Role(workspace.Role), workspace.ID == data.Workspace.ID)</li>
				}
				<li><a href="/" class="border border-base-300">{ data.T("workspace.workspaces") }</a></li>
			</ul>
		</details>
	}
}

// workspaceChevron marks the workspace title as a switcher; the summary text
// names it, so the glyph is decorative.
templ workspaceChevron() {
	<span class="text-base-content/50" aria-hidden="true">▾</span>
}
// NavLink is a plain anchor carrying aria-current; menu-active styling lives
// on the wrapping li (navLi, or a DropdownItem Class).
templ NavLink(data viewmodel.PageData, href, key string, active bool) {
	<a class="border border-base-300" aria-current={ currentPage(active) } href={ href }>{ data.T(key) }</a>
}


templ navLi(data viewmodel.PageData, href, key string, active bool) {
	<li class={ templ.KV("menu-active", active) }>@NavLink(data, href, key, active)</li>
}


templ navTitle(text string) {
	<li class="menu-title text-base-content/80">{ text }</li>
}


templ WorkspaceNav(data viewmodel.PageData) {
	if data.NavSection == "settings" {
		<nav class="sidebar-navigation" aria-label={ data.T("navigation.workspace_settings") }>
			<ul class="menu w-full">
				@navTitle(data.T("navigation.settings_setup"))
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/general", "navigation.general", data.NavPage == "general")
				if data.Workspace.Role == "owner" || data.Workspace.Role == "admin" {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/email", "navigation.email", data.NavPage == "email")
					if data.ClientsEnabled {
						@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/intake", "intake.title", data.NavPage == "intake")
					}
				}
				@navTitle(data.T("navigation.settings_access"))
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/members", "navigation.members", data.NavPage == "members" || data.NavPage == "invitations")
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/tokens", "navigation.tokens", data.NavPage == "tokens")
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/webhooks", "navigation.webhooks", data.NavPage == "webhooks")
				if data.Workspace.Role == "owner" || data.Workspace.Role == "admin" {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/provisioning", "navigation.provisioning", data.NavPage == "provisioning")
				}
				@navTitle(data.T("navigation.settings_activity"))
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/export", "navigation.export", data.NavPage == "export")
				if data.Workspace.Role == "owner" || data.Workspace.Role == "admin" {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/audit", "navigation.audit_history", data.NavPage == "audit")
				}
			</ul>
		</nav>
	} else {
		<nav class="sidebar-navigation" aria-label={ data.T("navigation.workspace_navigation") }>
			<ul class="menu w-full">
				@navTitle(data.T("common.workspace"))
				@navLi(data, "/workspaces/"+data.Workspace.ID.String(), "navigation.home", data.NavPage == "workspace")
				if data.ClientsEnabled {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/clients", "clients.title", data.NavPage == "clients" || data.NavPage == "client-detail" || data.NavPage == "client-fields")
				}
				if data.CatalogEnabled {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/catalog", "catalog.title", data.NavPage == "catalog")
				}
				if data.FilesEnabled {
					@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/files", "files.files", data.NavPage == "files")
				}
				@navTitle(data.T("navigation.settings"))
				@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings", "navigation.settings", data.NavPage == "settings")
			</ul>
		</nav>
	}
}


templ PeopleTabs(data viewmodel.PageData) {
	<nav aria-label={ data.T("accessibility.members_invitations") }>
		<ul class="menu menu-horizontal w-full">
			@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/members", "members.members", data.NavPage == "members")
			@navLi(data, "/workspaces/"+data.Workspace.ID.String()+"/settings/invitations", "invitations.invitations", data.NavPage == "invitations")
		</ul>
	</nav>
}


templ AccountNavigation(data viewmodel.PageData) {
	if data.SingleWorkspace && data.DefaultWorkspaceHref != "" {
		<a class="btn btn-sm w-full justify-start font-normal" href={ data.DefaultWorkspaceHref }>← { data.T("workspace.back_to_home") }</a>
	} else if !data.SingleWorkspace {
		<a class="btn btn-sm w-full justify-start font-normal" href="/">← { data.T("workspace.workspaces") }</a>
	}
	<nav class="sidebar-navigation" aria-label={ data.T("common.account") }>
		<ul class="menu w-full">
			@navTitle(data.T("common.account"))
			@navLi(data, "/account", "account.account", data.NavPage == "account")
			@navLi(data, "/notifications", "notifications.notifications", data.NavPage == "notifications")
			@navLi(data, "/settings/language", "account.language_settings", data.NavPage == "language")
			@navLi(data, "/security", "navigation.security", data.NavPage == "security")
			@navLi(data, "/sessions", "navigation.sessions", data.NavPage == "sessions")
		</ul>
	</nav>
}

// avatarInitials derives up to two uppercase initials from the display name,
// falling back to the email, then a question mark for anonymous pages.
func avatarInitials(profile identity.UserProfile) string {
	source := strings.TrimSpace(profile.DisplayName)
	if source == "" {
		source = strings.TrimSpace(profile.Email)
	}
	parts := strings.Fields(source)
	initials := ""
	for _, part := range parts {
		if len(initials) >= 2 {
			break
		}
		initials += strings.ToUpper(part[:1])
	}
	if initials == "" {
		return "?"
	}
	return initials
}


templ AccountMenu(data viewmodel.PageData) {
	<details class="dropdown dropdown-end">
		<summary class="btn m-1 btn btn-circle p-0" aria-label={ data.T("common.account") }>{ " " }@AccountAvatar(data)</summary>{ " " }
		<ul class="menu dropdown-content w-52 max-w-[90vw] bg-base-100 rounded-box shadow-lg">
			if data.Profile.Email != "" {
				<li class="menu-title">
					if data.Profile.DisplayName == "" {
						{ data.Profile.Email }
					} else {
						{ data.Profile.DisplayName }
					}
				</li>
			}
			@navLi(data, "/account", "account.account", data.NavPage == "account")
			@navLi(data, "/notifications", "notifications.notifications", data.NavPage == "notifications")
			@navLi(data, "/settings/language", "account.language_settings", data.NavPage == "language")
			@navLi(data, "/security", "navigation.security", data.NavPage == "security")
			@navLi(data, "/sessions", "navigation.sessions", data.NavPage == "sessions")
			<li class="">@logoutItem(data)</li>
		</ul>
	</details>
}

// AccountAvatar is the decorative initials circle; the dropdown summary's
// aria-label carries the accessible name for the whole control.
templ AccountAvatar(data viewmodel.PageData) {
	<span class="avatar placeholder" aria-hidden="true">
		<div class="grid w-8 place-items-center rounded-full bg-neutral text-neutral-content">
			<span class="text-sm font-semibold">{ avatarInitials(data.Profile) }</span>
		</div>
	</span>
}
