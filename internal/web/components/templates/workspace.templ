package templates

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

type DashboardNavigation string

const (
	DashboardStandalone DashboardNavigation = ""
	DashboardHome       DashboardNavigation = "home"
	DashboardSettings   DashboardNavigation = "settings"
	DashboardAccount    DashboardNavigation = "account"
)

templ DashboardShell(data viewmodel.PageData, navigation DashboardNavigation) {
	<!doctype html>
	<html lang={ data.Locale } if data.Theme != "system" { data-theme={ data.Theme } }>
		<head>
			@PageHead(data, data.Title)
				<script defer src="/assets/alpine-components.js"></script>
			<script defer src="/assets/js/alpine.min.js"></script>
			<link rel="stylesheet" href="/assets/clients.css"/>
			if data.NavPage == "clients" || data.ListLive {
				<script defer src="/assets/htmx.min.js"></script>
			}
		</head>
		<body x-data="pageBehaviors" class={ templ.KV("dashboard-workspace", navigation != DashboardStandalone) } data-workspace-home?={ data.NavPage == "workspace" } if data.NavPage != "import" && data.NavPage != "client-detail" && data.NavPage != "client-fields" && data.NavPage != "webhooks" && data.NavPage != "provisioning" { data-webmcp-page={ data.NavPage } }>
			@molecules.SkipLink(data)
			if navigation != DashboardStandalone {
				<div class="drawer lg:drawer-open">
					<input id="app-drawer" type="checkbox" class="drawer-toggle" aria-hidden="true" tabindex="-1"/>
					<div class="drawer-content flex min-h-screen flex-col">
						if navigation == DashboardAccount {
							@organisms.AccountHeader(data)
						} else {
							@organisms.DashboardHeader(data)
						}
						<main id="main" class="workspace-main flex-1">
							{ children... }
						</main>
					</div>
					<div class="drawer-side z-40">
						<button type="button" class="drawer-overlay block" tabindex="-1" aria-hidden="true" @click="toggleDrawer"></button>
						<div class="min-h-full w-64 border-r border-base-200 bg-base-100 p-4">
							if data.Workspace.ID != 0 {
								<div class="mb-3 border-b border-base-200 pb-3">
									@organisms.WorkspaceContext(data)
								</div>
							}
							switch navigation {
								case DashboardAccount:
									@organisms.AccountNavigation(data)
								case DashboardSettings:
									@organisms.SettingsSidebar(data)
								case DashboardHome:
									@organisms.DashboardHomeNavigation(data)
							}
						</div>
					</div>
				</div>
			} else {
				@organisms.DashboardHeader(data)
				<main id="main" class="workspace-main">
					{ children... }
				</main>
			}
		</body>
	</html>
}
