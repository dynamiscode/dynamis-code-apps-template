package components

import (
	"strconv"

	"example.com/dynamis-code/apps-template/internal/web/viewmodel"

	atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
)

// ListPager is a list's page navigation under its table: previous, numbered pages with gaps, and next.
// Page links swap the results region in place when the list is live. A list with one page shows no pager.
templ ListPager(data viewmodel.PageData) {
	if data.ListPager.PageCount > 1 {
		{{
			pages := make([]atoms.LinkPage, 0, len(data.ListPager.Links)+2)
			if data.ListPager.Prev != "" {
				pages = append(pages, atoms.LinkPage{
					Label: data.T("ui.previous_page"),
					URL:   data.ListPager.Prev,
					Rel:   "prev",
					Attrs: ListLiveLinkAttributes(data, data.ListPager.Prev),
				})
			}
			for _, link := range data.ListPager.Links {
				if link.Number == 0 {
					pages = append(pages, atoms.LinkPage{Gap: true})
				} else {
					pages = append(pages, atoms.LinkPage{
						Label:   strconv.Itoa(link.Number),
						URL:     link.Href,
						Current: link.Current,
						Attrs:   ListLiveLinkAttributes(data, link.Href),
					})
				}
			}
			if data.ListPager.Next != "" {
				pages = append(pages, atoms.LinkPage{
					Label: data.T("items.next_page"),
					URL:   data.ListPager.Next,
					Rel:   "next",
					Attrs: ListLiveLinkAttributes(data, data.ListPager.Next),
				})
			}
		}}
		@atoms.LinkPagination(atoms.LinkPaginationProps{Label: data.T("ui.pages"), Pages: pages})
	}
}
