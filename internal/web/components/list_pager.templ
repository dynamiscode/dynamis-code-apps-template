package components

import (
	"strconv"

	"example.com/dynamis-code/apps-template/internal/web/viewmodel"
)

// ListPager is a list's page navigation under its table: previous, numbered pages with gaps, and next. Page links
// swap the results region in place when the list is live. A list with one page shows no pager.
templ ListPager(data viewmodel.PageData) {
	if data.ListPager.PageCount > 1 {
		<nav class="list-pager" aria-label={ data.T("ui.pages") }>
			if data.ListPager.Prev != "" {
				<a class="btn btn-ghost btn-xs" href={ data.ListPager.Prev } rel="prev" { ListLiveLinkAttributes(data, data.ListPager.Prev)... }>{ data.T("ui.previous_page") }</a>
			}
			for _, link := range data.ListPager.Links {
				if link.Number == 0 {
					<span class="list-pager-gap" aria-hidden="true">…</span>
				} else if link.Current {
					<a class="btn btn-primary btn-xs" href={ link.Href } aria-current="page" { ListLiveLinkAttributes(data, link.Href)... }>{ strconv.Itoa(link.Number) }</a>
				} else {
					<a class="btn btn-ghost btn-xs" href={ link.Href } { ListLiveLinkAttributes(data, link.Href)... }>{ strconv.Itoa(link.Number) }</a>
				}
			}
			if data.ListPager.Next != "" {
				<a class="btn btn-ghost btn-xs" href={ data.ListPager.Next } rel="next" { ListLiveLinkAttributes(data, data.ListPager.Next)... }>{ data.T("items.next_page") }</a>
			}
		</nav>
	}
}
