package components

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

// ListScreen is the shared page of a list: the toolbar with search, views, the add-filter control and the list's own
// tools, the filter strip under it, and the results region. Every list assembles its page this way.
templ ListScreen(data viewmodel.PageData, searchKey string, tools templ.Component, results templ.Component) {
	@ListToolbar() {
		@ListSearch(data, searchKey, data.ListSearch)
		@ListViewSwitcher(data)
		@ListAddFilter(data)
		@tools
	}
	@ListFilterBar(data)
	@results
}

// ListResults is the shared results region of a list: the lazy placeholder, or the list body with its footer. The
// footer carries the page numbers and the list's extras. A lazy load or a live search asks for this region alone,
// so it also refreshes the filter strip and the column menu out of band.
templ ListResults(data viewmodel.PageData, limit int, sizes []int, columnsSuffix string, body templ.Component, extras templ.Component) {
	if data.ListLazy {
		@ListResultsPlaceholder(data, len(data.ListColumns))
	} else {
		<div id="list-results">
			@body
			@ListFooter(data, limit, sizes) {
				@ListPager(data)
				@extras
			}
		</div>
	}
	if data.ListFragment {
		@ListFilterBarOOB(data)
		@ListColumnsBody(data, columnsSuffix, true)
	}
}
