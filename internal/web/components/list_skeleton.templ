package components

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

// ListResultsPlaceholder stands in for a list's results while the results fragment loads: a loading status and
// skeleton rows in the table's column shape. Without JavaScript, the full-list link shows the results.
templ ListResultsPlaceholder(data viewmodel.PageData, columns int) {
	<div id="list-results" class="list-results-loading" data-lazy-src={ data.ListResultsSrc } aria-busy="true">
		<p class="status" role="status">{ data.T("ui.loading") }</p>
		<div class="list-skeleton" aria-hidden="true">
			for row := 0; row < 6; row++ {
				<div class="list-skeleton-row">
					for col := 0; col < columns; col++ {
						<span class="list-skeleton-cell"></span>
					}
				</div>
			}
		</div>
		<p class="list-results-fallback"><a href={ templ.SafeURL(data.ListFullHref) }>{ data.T("ui.list_full") }</a></p>
	</div>
}
