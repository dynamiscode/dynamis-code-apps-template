package components

import (
	atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
	"example.com/dynamis-code/apps-template/internal/web/viewmodel"
	"strconv"
)

// ListViewSwitcher is the view menu of a list. It has three jobs, kept apart: apply a view, manage a view (default,
// rename, delete), and save the current filters, sort and columns as a new view. Every action posts to the list's
// view routes, which redirect back to the list.
templ ListViewSwitcher(data viewmodel.PageData) {
	@atoms.Dropdown(atoms.DropdownProps{
		Class:        "list-menu",
		SummaryClass: "btn btn-ghost btn-xs",
		SummaryAttrs: templ.Attributes{"aria-label": data.T("views.title"), "title": data.T("views.title")},
		Summary:      listViewSummary(data),
		Panel:        listViewPanel(data),
		PanelClass:   "list-views-panel bg-base-100 rounded-box shadow-lg border border-base-200 p-3 w-96 max-w-[90vw]",
	})
}

// listViewSummary is the view menu's button face: the title and the applied view's name.
templ listViewSummary(data viewmodel.PageData) {
	<span>{ data.T("views.title") }</span>
	if applied := listViewAppliedName(data); applied != "" {
		<span class="list-view-summary-current">{ applied }</span>
	}
}

// listViewPanel is the view menu's content: the saved views, their manage forms, and the save form.
templ listViewPanel(data viewmodel.PageData) {
	<div>
			<p class="list-views-intro">{ data.T("views.intro") }</p>
			<ul class="list-views-list">
				<li class="list-view-row">
					<a class={ listViewOptionClass(listViewNoneApplied(data)) } href={ templ.SafeURL(data.ListViewBase + "?all=1") }>
						<span class="list-view-name">{ data.T("views.all") }</span>
						if listViewNoneApplied(data) {
							@atoms.Badge(atoms.BadgeProps{Class: "list-view-badge", Label: data.T("views.applied")})
						}
					</a>
				</li>
				for _, view := range data.ListViews {
					<li class="list-view-row">
						<form method="post" action={ data.ListViewRoute + "/" + strconv.FormatInt(view.ID, 10) + "/apply" } class="list-view-apply">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							<input type="hidden" name="q" value={ data.ListSearch }/>
							<button class={ listViewOptionClass(view.Current) } type="submit">
								<span class="list-view-name">{ view.Name }</span>
								if view.Current {
									@atoms.Badge(atoms.BadgeProps{Class: "list-view-badge", Label: data.T("views.applied")})
								}
								if view.Default {
									@atoms.Badge(atoms.BadgeProps{Class: "list-view-badge", Label: data.T("views.default")})
								}
								if view.Shared {
									@atoms.Badge(atoms.BadgeProps{Class: "list-view-badge", Label: data.T("views.shared_badge")})
								}
							</button>
						</form>
						<details class="list-view-manage">
							<summary>{ data.T("views.manage") }</summary>
							<div class="list-view-manage-body">
								<form method="post" action={ data.ListViewRoute + "/" + defaultViewTarget(view) + "/default" } class="list-view-action">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<p class="list-view-hint">{ data.T("views.default_hint") }</p>
									<button class="btn btn-ghost btn-xs" type="submit">
										if view.Default {
											{ data.T("views.clear_default") }
										} else {
											{ data.T("views.make_default") }
										}
									</button>
								</form>
								if view.Editable {
									<form method="post" action={ data.ListViewRoute + "/" + strconv.FormatInt(view.ID, 10) + "/rename" } class="list-view-action">
										<input type="hidden" name="csrf" value={ data.CSRF }/>
										@atoms.Input(atoms.InputProps{Label: data.T("views.name"), Name: "name", Value: view.Name, Required: true, MaxLength: "60"})
										<button class="btn btn-ghost btn-xs" type="submit">{ data.T("views.rename") }</button>
									</form>
									<form method="post" action={ data.ListViewRoute + "/" + strconv.FormatInt(view.ID, 10) + "/delete" } class="list-view-action">
										<input type="hidden" name="csrf" value={ data.CSRF }/>
										<button class="btn btn-ghost btn-xs list-danger" type="submit" data-confirm={ data.T("views.delete_confirm") }>{ data.T("common.delete") }</button>
									</form>
								}
							</div>
						</details>
					</li>
				}
			</ul>
			<details class="list-views-save" open?={ len(data.ListViews) == 0 }>
				<summary>{ data.T("views.save_heading") }</summary>
				if data.ListViewSaveReason != "" {
					<p class="list-view-note">{ data.T(data.ListViewSaveReason) }</p>
				} else {
					<form method="post" action={ data.ListViewRoute } class="list-view-action">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<input type="hidden" name="query" value={ data.ListViewQuery }/>
						<p class="list-view-hint">{ data.T("views.save_hint") }</p>
						@atoms.Input(atoms.InputProps{Label: data.T("views.name"), Name: "name", Required: true, MaxLength: "60"})
						if data.ListViewCanShare {
							@atoms.Checkbox(atoms.CheckboxProps{LabelClass: "list-view-check", After: data.T("views.shared"), Name: "shared", Attrs: templ.Attributes{"value": "1"}})
							<p class="list-view-hint">{ data.T("views.share_hint") }</p>
						}
						<button class="btn btn-xs" type="submit">{ data.T("views.save") }</button>
					</form>
				}
			</details>
	</div>
}

// listViewAppliedName is the name of the view on screen, or empty when no saved view is applied.
func listViewAppliedName(data viewmodel.PageData) string {
	for _, view := range data.ListViews {
		if view.Current {
			return view.Name
		}
	}
	return ""
}

// listViewNoneApplied reports whether the list is unfiltered: no saved view matches and no query is set.
func listViewNoneApplied(data viewmodel.PageData) bool {
	return listViewAppliedName(data) == "" && data.ListViewQuery == ""
}

// listViewOptionClass styles a view option, marking the one that is applied.
func listViewOptionClass(applied bool) string {
	if applied {
		return "list-view-option is-applied"
	}
	return "list-view-option"
}

// defaultViewTarget is the view a default toggle names: the view itself, or the clear sentinel when it is the
// default already.
func defaultViewTarget(view viewmodel.ListViewOption) string {
	if view.Default {
		return "clear"
	}
	return strconv.FormatInt(view.ID, 10)
}
