// navigation
// https://daisyui.com/components/breadcrumbs
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type BreadcrumbsProps struct {
	// Separator renders between items; "" omits a visible separator
	Separator string
	Items     []BreadcrumbsProp
}

type BreadcrumbsProp struct {
	Label string
	// Href renders the crumb as a link; the current (last) crumb
	// should leave it empty so it renders as plain text
	Href  string
	Attrs templ.Attributes
}

templ Breadcrumbs(props BreadcrumbsProps) {
	<div class="breadcrumbs text-sm">
		<ul>
			for i, prop := range props.Items {
				<li class="select-none">
					if prop.Href != "" {
						<a class="btn btn-xs h-auto whitespace-normal" href={ templ.SafeURL(prop.Href) } { actionattrs.From(prop.Attrs)... }>{ prop.Label }</a>
					} else {
						{ prop.Label }
					}
					if i < len(props.Items) - 1 && props.Separator != "" {
						<span aria-hidden="true">{ props.Separator }</span>
					}
				</li>
			}
		</ul>
	</div>
}
