// navigation
// https://daisyui.com/components/breadcrumbs
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type BreadcrumbsProps struct {
	// Separator renders between items; "" omits a visible separator
	Separator string
	Items     []BreadcrumbsProp
}

type BreadcrumbsProp struct {
	Label string
	// Href renders the crumb as a link; the current (last) crumb
	// should leave it empty so it renders as plain text
	Href  string
	Attrs templ.Attributes
}

templ Breadcrumbs(props BreadcrumbsProps) {
	<div class="breadcrumbs text-sm">
		<ol class="flex-wrap whitespace-normal!">
			for i, prop := range props.Items {
				<li class="select-none max-w-full">
					if prop.Href != "" {
						<a class="link inline-flex min-h-11 max-w-full items-center whitespace-normal break-words focus-visible:outline-2 focus-visible:outline-offset-2" href={ templ.SafeURL(prop.Href) } { actionattrs.From(prop.Attrs)... }>{ prop.Label }</a>
					} else {
						if i == len(props.Items) - 1 {
							<span aria-current="page" class="break-words font-semibold">{ prop.Label }</span>
						} else {
							<span class="break-words">{ prop.Label }</span>
						}
					}
					if i < len(props.Items) - 1 && props.Separator != "" {
						<span aria-hidden="true" class="text-base-content/60">{ props.Separator }</span>
					}
				</li>
			}
		</ol>
	</div>
}
