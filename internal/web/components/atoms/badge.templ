// data_display
// https://daisyui.com/components/badge
// rendered as a span so it nests validly inside paragraphs and headings
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type BadgeProps struct {
	Class string
	Label string
	Attrs templ.Attributes
}

templ Badge(props BadgeProps) {
	<span class={ "badge", props.Class } { actionattrs.ScalarAttributes(props.Attrs)... }>{ props.Label }{ children... }</span>
}
