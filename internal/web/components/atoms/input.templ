// data_input
// https://daisyui.com/components/input
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type InputProps struct {
	// common
	Name            string
	ID              string // when set, the label binds with for=id
	Label           string
	Type            string // defaults to "text"
	Value           string
	Placeholder     string
	Description     string
	Error           string
	DisabledMessage string
	Size            string // xs sm lg xl, default: md
	Required        bool
	Icon            templ.Component
	Attrs           templ.Attributes

	// text input
	MinLength     string
	MaxLength     string
	Pattern       string
	ValidatorHint string

	// integer/decimal input
	Min string
	Max string

	// decimal input
	Step string
}

templ Input(props InputProps) {
	<fieldset class="fieldset">
		if props.Label != "" {
			if props.ID != "" {
				<label class="fieldset-legend" for={ props.ID }>{ props.Label }</label>
			} else {
				<legend class="fieldset-legend">{ props.Label }</legend>
			}
		}
		if props.Icon != nil {
			<label
				for={ props.ID }
				class={
					"input w-full",
					templ.KV("input-xs", props.Size == "xs"),
					templ.KV("input-sm", props.Size == "sm"),
					templ.KV("input-lg", props.Size == "lg"),
					templ.KV("input-xl", props.Size == "xl"),
				}
			>
				@actionattrs.Scanned(props.Icon)
				@InputControl(props)
			</label>
		} else {
			@InputControl(props)
		}
		if props.Description != "" {
			<div class="label">{ props.Description }</div>
		}
		if props.Error != "" {
			<p class="text-xs text-error max-w-xs" role="alert" tabindex="-1">{ props.Error }</p>
		}
		if props.ValidatorHint != "" {
			<p class="validator-hint hidden text-xs max-w-xs mt-0!">{ props.ValidatorHint }</p>
		}
	</fieldset>
}

templ InputControl(props InputProps) {
	<input
		if props.ID != "" {
			id={ props.ID }
		}
		name={ props.Name }
		if props.Type == "" {
			type="text"
		} else {
			type={ props.Type }
		}
		value={ props.Value }
		placeholder={ props.Placeholder }
		if props.Required {
			required
		}
		if props.MinLength != "" {
			minlength={ props.MinLength }
		}
		if props.MaxLength != "" {
			maxlength={ props.MaxLength }
		}
		if props.Min != "" {
			min={ props.Min }
		}
		if props.Max != "" {
			max={ props.Max }
		}
		if props.Step != "" {
			step={ props.Step }
		}
		if props.Pattern != "" {
			pattern={ props.Pattern }
		}
		if props.DisabledMessage != "" {
			disabled
			data-tip={ props.DisabledMessage }
		}
		class={
			"input w-full",
			templ.KV("validator", props.ValidatorHint != ""),
			templ.KV("input-xs", props.Size == "xs"),
			templ.KV("input-sm", props.Size == "sm"),
			templ.KV("input-lg", props.Size == "lg"),
			templ.KV("input-xl", props.Size == "xl"),
			templ.KV("tooltip tooltip-top", props.DisabledMessage != ""),
		}
		{ props.Attrs... }
	/>
}
