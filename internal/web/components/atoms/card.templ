// data_display
// https://daisyui.com/components/card
package atoms

type CardProps struct {
	Title   string
	Content string
	Source  string
	Alt     string
	Class   string
}

templ Card(props CardProps) {
	<div class={ "card", props.Class }>
		if props.Source != "" {
			<figure>
				<img src={ props.Source } alt={ props.Alt }/>
			</figure>
		}
		<div class="card-body">
			<h2 class="card-title">{ props.Title }</h2>
			<p>{ props.Content }</p>
			<div class="card-actions justify-end">
				{ children... }
			</div>
		</div>
	</div>
}

// ListCard is a whole-card link in a cards grid (li.card inside a ul).
type ListCardProps struct {
	Class       string
	Href        string
	Title       string
	Description string
}

templ ListCard(props ListCardProps) {
	<li class={ "card", props.Class }>
		<a href={ templ.SafeURL(props.Href) } class="flex items-start justify-between gap-3">
			<span class="grid content-start gap-2"><strong>{ props.Title }</strong><span>{ props.Description }</span></span>
			<span class="text-2xl leading-none text-base-content/40 select-none" aria-hidden="true">›</span>
		</a>
	</li>
}
