// actions
// https://daisyui.com/components/swap
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type SwapProps struct {
	On    templ.Component
	Off   templ.Component
	Class string
}

templ Swap(props SwapProps) {
	<label class={ "swap", props.Class }>
		<input type="checkbox"/>
		<div class="swap-on">
			@actionattrs.Scanned(props.On)
		</div>
		<div class="swap-off">
			@actionattrs.Scanned(props.Off)
		</div>
	</label>
}
