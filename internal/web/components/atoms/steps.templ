// navigation
// https://daisyui.com/components/steps
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type StepProps struct {
	Label string
	Done  bool
	Attrs templ.Attributes
}

templ Steps() {
	<ul class="steps">
		{ children... }
	</ul>
}

templ Step(props StepProps) {
	<li
		class={ "step", templ.KV("step-primary", props.Done) }
	>
		<a class="rounded-field border border-base-300 px-1" { actionattrs.From(props.Attrs)... }>{ props.Label }</a>
	</li>
}
