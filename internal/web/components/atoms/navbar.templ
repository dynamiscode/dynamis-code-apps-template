// navigation
// https://daisyui.com/components/navbar
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type NavbarProps struct {
	Class  string
	Start  templ.Component
	Center templ.Component
	End    templ.Component
}

templ Navbar(props NavbarProps) {
	<div class={ "navbar", props.Class }>
		if props.Start != nil {
			<div class="navbar-start">@actionattrs.Scanned(props.Start)</div>
		}
		if props.Center != nil {
			<div class="navbar-center">@actionattrs.Scanned(props.Center)</div>
		}
		if props.End != nil {
			<div class="navbar-end">@actionattrs.Scanned(props.End)</div>
		}
		{ children... }
	</div>
}
