// data_input
// https://daisyui.com/components/field
package atoms

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"

type FieldProps struct {
	Class   string
	Label   string
	Help    string
	Error   string
	Attrs   templ.Attributes
}

templ Field(props FieldProps) {
	<fieldset class={ "fieldset", props.Class } { actionattrs.ScalarAttributes(props.Attrs)... }>
		if props.Label != "" {
			<legend class="fieldset-legend">{ props.Label }</legend>
		}
		{ children... }
		if props.Help != "" {
			<p class="fieldset-label">{ props.Help }</p>
		}
		if props.Error != "" {
			<p class="text-xs text-error max-w-xs" role="alert" tabindex="-1">{ props.Error }</p>
		}
	</fieldset>
}
