package components

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

// ListFilterBar is the shared filter strip of a list: the applied conditions as chips, and the match switch once
// there are two or more. It sits under the toolbar and takes no height when no condition is applied.
templ ListFilterBar(data viewmodel.PageData) {
	<div id="list-filter-bar">
		@ListFilterStrip(data)
	</div>
}

// ListFilterIcon is the funnel that marks the filter controls. It is decorative: the control's label names it.
templ ListFilterIcon() {
	<svg class="list-filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		<path d="M3 5h18l-7 8v6l-4 2v-8z"/>
	</svg>
}

// ListAddFilter is the add-filter control on a list's toolbar row.
templ ListAddFilter(data viewmodel.PageData) {
	<div id="list-filter-add">
		@ListAddMenu(data.T("clients.add_filter"), data.Filter.AddOpen, true) {
			@ListFilterAddPanel(data)
		}
	</div>
}

// ListFilterBarOOB refreshes the strip and the add-filter control out of band. A live search sends both with its
// results, so their field links and the match switch carry the current search.
templ ListFilterBarOOB(data viewmodel.PageData) {
	<div id="list-filter-bar" hx-swap-oob="true">
		@ListFilterStrip(data)
	</div>
	<div id="list-filter-add" hx-swap-oob="true">
		@ListAddMenu(data.T("clients.add_filter"), data.Filter.AddOpen, true) {
			@ListFilterAddPanel(data)
		}
	</div>
}

templ ListFilterStrip(data viewmodel.PageData) {
	if len(data.Filter.Chips) > 0 {
		<div class="list-filter-strip">
			<ul class="list-filter-chips" aria-label={ data.T("clients.active_filters") }>
				for i, chip := range data.Filter.Chips {
					if i > 0 {
						<li class="list-filter-connector">
							if data.Filter.Match == viewmodel.ListMatchAny {
								{ data.T("clients.connector_or") }
							} else {
								{ data.T("clients.connector_and") }
							}
						</li>
					}
					<li class="list-filter-chip">
						<a class="list-filter-chip-edit" href={ templ.SafeURL(chip.EditHref) } aria-label={ data.T("clients.filter_edit") + ": " + ListLabel(data, chip.FieldLabelKey, chip.FieldLabel) }>
							<span>
								{ ListLabel(data, chip.FieldLabelKey, chip.FieldLabel) }&#32;{ data.T(chip.OpLabelKey) }&#32;
								if chip.ValueKey != "" {
									{ ListChipValue(data, chip) }
								} else {
									{ ListChipValue(data, chip) }
								}
							</span>
						</a>
						<a class="list-filter-chip-remove" href={ templ.SafeURL(chip.RemoveHref) } aria-label={ data.T("clients.filter_remove") + ": " + ListLabel(data, chip.FieldLabelKey, chip.FieldLabel) }>&times;</a>
					</li>
				}
			</ul>
			if data.Filter.ShowMatch {
				<form class="client-match" method="get" action={ data.Filter.Path }>
					for _, field := range data.Filter.Preserved {
						if field.Name != "match" {
							<input type="hidden" name={ field.Name } value={ field.Value }/>
						}
					}
					<label for="list-match">{ data.T("clients.match_label") }</label>
					<select class="select" id="list-match" name="match" data-autosubmit="true">
						<option value={ viewmodel.ListMatchAll } selected?={ data.Filter.Match == viewmodel.ListMatchAll }>{ data.T("clients.match_all") }</option>
						<option value={ viewmodel.ListMatchAny } selected?={ data.Filter.Match == viewmodel.ListMatchAny }>{ data.T("clients.match_any") }</option>
					</select>
					<button class="btn btn-ghost btn-xs" type="submit" data-submit-button="true">{ data.T("clients.apply") }</button>
				</form>
			}
		</div>
	}
}

// ListFilterAddPanel is the add menu's two steps. The first picks a field; the second picks its
// condition and value.
templ ListFilterAddPanel(data viewmodel.PageData) {
	if data.Filter.Step == nil {
		if !data.Filter.CanAdd {
			<p class="status">{ data.T("clients.filter_limit") }</p>
		} else {
			<p id="list-field-heading" class="client-field-prompt">{ data.T("clients.choose_field") }</p>
			<ul class="client-field-choices" aria-labelledby="list-field-heading">
				for _, field := range data.Filter.Fields {
					<li><a href={ templ.SafeURL(field.Href) }>{ ListLabel(data, field.LabelKey, field.Label) }</a></li>
				}
			</ul>
		}
		<div class="actions">
			<a class="btn btn-ghost btn-xs" href={ templ.SafeURL(data.Filter.ClearHref) }>{ data.T("clients.clear_filters") }</a>
		</div>
	} else {
		<form class="client-query client-add-step" method="get" action={ data.Filter.Path } data-dirty-track>
			for _, field := range data.Filter.Preserved {
				<input type="hidden" name={ field.Name } value={ field.Value }/>
			}
			<input type="hidden" name="filter_field" value={ data.Filter.Step.FieldKey }/>
			<p class="client-step-field">{ ListLabel(data, data.Filter.Step.FieldLabelKey, data.Filter.Step.FieldLabel) }</p>
			<div class="client-step-section" role="radiogroup" aria-labelledby="list-condition-heading">
				<p id="list-condition-heading" class="client-field-prompt">{ data.T("clients.filter_op") }</p>
				for _, op := range data.Filter.Step.Ops {
					<label class="client-operator">
						<input type="radio" name="filter_op" value={ op.Key } checked?={ op.Checked }/>
						<span>{ data.T(op.LabelKey) }</span>
					</label>
				}
			</div>
			<div class="client-step-section" data-hide-for-operator="is_empty">
				if data.Filter.Step.IsChoice {
					<label class="client-field-prompt" for="list-filter-value">{ data.T("clients.filter_value") }</label>
					<select class="select" id="list-filter-value" name="filter_value">
						for _, choice := range data.Filter.Step.Choices {
							<option value={ choice.Value } selected?={ choice.Selected }>{ ListLabel(data, choice.LabelKey, choice.Label) }</option>
						}
					</select>
				} else {
					<label class="client-field-prompt" for="list-filter-value">{ data.T("clients.filter_value") }</label>
					<input class="input" id="list-filter-value" type={ ListInputType(data.Filter.Step.InputType) } name="filter_value" maxlength="1024" value={ data.Filter.Step.Value }/>
				}
			</div>
			if data.Filter.Step.Range {
				<div class="client-step-section" data-show-for-operator="between">
					<label class="client-field-prompt" for="list-filter-value-to">{ data.T("clients.filter_value_to") }</label>
					<input class="input" id="list-filter-value-to" type={ ListInputType(data.Filter.Step.InputType) } name="filter_value_to" maxlength="1024" value={ data.Filter.Step.ValueTo }/>
				</div>
			}
			<div class="client-step-actions">
				<a class="btn btn-ghost" href={ templ.SafeURL(data.Filter.BackHref) }>&lsaquo; { data.T("clients.back_to_fields") }</a>
				<button class="btn btn-primary" type="submit">{ data.T("clients.filter_add") }</button>
			</div>
		</form>
	}
}
