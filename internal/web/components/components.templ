package components

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"


// PageHeading matches the workspace and resource page heading pattern.
templ PageHeading(title, eyebrow string) {
	<div class="workspace-heading"><div>
		if eyebrow != "" {
			<p class="eyebrow">{ eyebrow }</p>
		}
		<h1>{ title }</h1>
	</div>{ children... }</div>
}

// StatusLine is a polite or plain status message; attrs adds live-region ids.
templ StatusLine(text string, attrs templ.Attributes) {
	<p class="status" role="status" { attrs... }>{ text }</p>
}

// TextField renders a labeled text control. name/type/value/placeholder move to the atom's
// own attributes: leaving them in Attrs would duplicate them and the atom's empty value would win.
templ TextField(id, label string, attrs templ.Attributes) {
	{{
		name, _ := attrs["name"].(string)
		inputType, _ := attrs["type"].(string)
		value, _ := attrs["value"].(string)
		placeholder, _ := attrs["placeholder"].(string)
		delete(attrs, "name")
		delete(attrs, "type")
		delete(attrs, "value")
		delete(attrs, "placeholder")
	}}
	@atoms.Input(atoms.InputProps{ID: id, Label: label, Name: name, Type: inputType, Value: value, Placeholder: placeholder, Attrs: attrs})
}

templ TextareaField(id, label, value string, attrs templ.Attributes) {
	{{ name, _ := attrs["name"].(string); delete(attrs, "name") }}
	@atoms.Textarea(atoms.TextareaProps{ID: id, Label: label, Name: name, Value: value, Attrs: attrs})
}

templ FieldError(id, message string) {
	<p id={ id } class="error">{ message }</p>
}

templ SubmitButton(label string, attrs templ.Attributes) {
	{{
		if attrs == nil {
			attrs = templ.Attributes{}
		}
		attrs["type"] = "submit"
	}}
	@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: label, Attrs: attrs})
}

templ LinkButton(href, label string) {
	@atoms.Anchor(atoms.AnchorProps{Href: href, Label: label, Class: "btn btn-primary"})
}

// ConfirmButton preserves the existing progressive enhancement for destructive actions.
templ ConfirmButton(label, prompt string, attrs templ.Attributes) {
	{{
		if attrs == nil {
			attrs = templ.Attributes{}
		}
		attrs["type"] = "submit"
		attrs["data-confirm"] = prompt
		class := "btn-error danger"
		if extra, ok := attrs["class"].(string); ok {
			delete(attrs, "class")
			class += " " + extra
		}
	}}
	@atoms.Button(atoms.ButtonProps{Class: class, Label: label, Attrs: attrs})
}

templ ConfirmationField(id, name, label string) {
	<label class="confirmation" for={ id }><input id={ id } name={ name } type="checkbox" value="yes" required/> <span>{ label }</span></label>
}

templ ErrorAlert(message string) {
	@atoms.Alert(atoms.AlertProps{Class: "alert-error error", Attrs: templ.Attributes{"tabindex": "-1"}}) {
		{ message }
	}
}

templ SuccessAlert(message string) {
	@atoms.Alert(atoms.AlertProps{Class: "alert-success success", Attrs: templ.Attributes{"role": "status"}}) {
		{ message }{ " " }
		{ children... }
	}
}

templ DataTable(caption string, hiddenCaption bool) {
	@atoms.TableWrap(atoms.TableWrapProps{WrapClass: "table-scroll", Caption: caption, CaptionHidden: hiddenCaption}) {
		{ children... }
	}
}

templ AuditDataTable(caption, label string) {
	@atoms.TableWrap(atoms.TableWrapProps{
		WrapClass:     "table-wrap",
		Caption:        caption,
		CaptionHidden:  true,
		Attrs:          templ.Attributes{"tabindex": "0", "role": "region", "aria-label": label},
	}) {
		{ children... }
	}
}

templ ListTable(caption string, hiddenCaption bool) {
	@atoms.TableWrap(atoms.TableWrapProps{
		WrapClass:  "list-view-table",
		TableClass: "table-md table-pin-rows",
		Caption:     caption,
		CaptionHidden: hiddenCaption,
	}) {
		{ children... }
	}
}

templ LinkedCard(href, title, description string) {
	@atoms.ListCard(atoms.ListCardProps{Href: href, Title: title, Description: description})
}

templ ListCards() {
	<ul class="list-view-cards">{ children... }</ul>
}

templ EmptyState(message string) {
	<p>{ message }{ " " }{ children... }</p>
}

