package molecules



templ EmptyState(message string) {
	<p>{ message }{ " " }{ children... }</p>
}

// EmptyStateCard teaches a list's first action: title, what the feature is
// for, and an optional call to action. The pristine-empty companion to
// NoMatchesAlert, which is the filtered-empty state.
templ EmptyStateCard(id, title, description string, cta templ.Component) {
	<div class="card border-l-4 border-primary p-5 mt-4" id={ id }>
		<h3 class="m-0">{ title }</h3>
		<p class="mb-4">{ description }</p>
		if cta != nil {
			@cta
		}
	</div>
}

// NoMatchesAlert is the filtered-empty state: a compact alert naming the
// miss and offering to clear the filters that caused it.
templ NoMatchesAlert(id, message, href, label string) {
	<div id={ id } role="status" class="alert mt-4 flex-wrap">
		<span>{ message }</span>
		<a class="btn btn-ghost btn-sm" href={ templ.SafeURL(href) }>{ label }</a>
	</div>
}
