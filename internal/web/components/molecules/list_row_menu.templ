package molecules

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"


// ListRowMenu holds a row's actions behind a "⋯" button. Only rows with actions use it.
templ ListRowMenu(data viewmodel.PageData) {
	<details class="dropdown list-menu">
		<summary class="btn m-1 btn btn-xs" aria-label={ data.T("ui.row_actions") } title={ data.T("ui.row_actions") }>{ " " }@RowMenuGlyph(false)</summary>{ " " }
		<div class="dropdown-content bg-base-100 rounded-box shadow-lg border border-base-200 p-3 w-72 max-w-[90vw]">{ children... }</div>
	</details>
}


// rowMenuGlyph is the three-dot button face; vertical dots for card rows.
templ RowMenuGlyph(vertical bool) {
	if vertical {
		&#8942;
	} else {
		&#8943;
	}
}
