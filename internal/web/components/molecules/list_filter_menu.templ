package molecules

// ListFilterMenu wraps one page's sort and filter form in the shared menu.
templ ListFilterMenu(label string, open bool) {
	<details class="dropdown list-menu" open?={ open }>
		<summary class="btn m-1 btn btn-sm">{ label + " " }</summary>{ " " }
		<div class="dropdown-content bg-base-100 rounded-box shadow-lg border border-base-200 p-3 w-96 max-w-[90vw]">{ children... }</div>
	</details>
}
