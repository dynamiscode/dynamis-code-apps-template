package molecules

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "maps"
import "strings"


templ SubmitButton(label string, attrs templ.Attributes) {
	@SubmitButtonStyled(label, "", attrs)
}

templ SubmitButtonStyled(label, class string, attrs templ.Attributes) {
	{{
		attrs = maps.Clone(attrs)
		if attrs == nil {
			attrs = templ.Attributes{}
		}
		attrs["type"] = "submit"
	}}
	@atoms.Button(atoms.ButtonProps{Class: strings.TrimSpace("btn-primary " + class), Label: label, Attrs: attrs})
}


templ LinkButton(href, label string) {
	@atoms.Anchor(atoms.AnchorProps{Href: href, Label: label, Class: "btn btn-primary"})
}


// ConfirmButton preserves the existing progressive enhancement for destructive actions.
templ ConfirmButton(label, prompt, class string, attrs templ.Attributes) {
	{{
		attrs = maps.Clone(attrs)
		if attrs == nil {
			attrs = templ.Attributes{}
		}
		attrs["type"] = "submit"
		attrs["data-confirm"] = prompt
	}}
	@atoms.Button(atoms.ButtonProps{Class: strings.TrimSpace("btn-error danger " + class), Label: label, Attrs: attrs}) {
		{ children... }
	}
}
