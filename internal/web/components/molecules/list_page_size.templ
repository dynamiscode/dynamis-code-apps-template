package molecules

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

// ListPageSize sets how many rows a page shows. It is a menu of links, like the columns and filter menus: each link
// is the list's address with that limit, so it works without JavaScript, keeps the search, filters, sort, and
// scope, and never opens the native picker. The trigger names the current size.
templ ListPageSize(data viewmodel.PageData, limit int, sizes []int) {
	<details class="dropdown list-menu list-page-size">
		<summary class="btn m-1 btn btn-sm list-page-size-trigger" aria-label={ data.T("clients.page_size") + ": " + ListPageSizeLabel(data, limit) }>
			{ ListPageSizeLabel(data, limit) + " " }
			@pageSizeChevron()
		</summary>{ " " }
		<ul class="menu dropdown-content list-page-size-options bg-base-100 rounded-box shadow-lg">
			for _, size := range sizes {
				<li><a { actionattrs.From(listPageSizeAttrs(data, limit, size))... } class="border border-base-300">{ ListPageSizeLabel(data, size) }</a></li>
			}
		</ul>
	</details>
}

// pageSizeChevron marks the trigger as a menu.
templ pageSizeChevron() {
	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
}
