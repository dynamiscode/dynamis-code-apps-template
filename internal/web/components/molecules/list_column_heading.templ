package molecules

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"


templ ClientColumnLabel(data viewmodel.PageData, column viewmodel.ListColumn) {
	if column.LabelKey != "" {
		{ data.T(column.LabelKey) }
	} else {
		{ column.Label }
	}
}


templ clientSortLink(data viewmodel.PageData, column viewmodel.ListColumn) {
	<a href={ column.SortHref } if data.ListLive {
		hx-get={ listResultsHref(column.SortHref) }
		hx-target="#list-results"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
	}>@atoms.HeaderText(ClientColumnLabelText(data, column), nil)</a>
}

templ ClientColumnHeading(data viewmodel.PageData, column viewmodel.ListColumn) {
	if column.SortDirection != "" {
		<th scope="col" data-column={ column.Key } aria-sort={ column.SortDirection }>
			if column.SortHref != "" {
				@clientSortLink(data, column)
			} else {
				@atoms.HeaderText(ClientColumnLabelText(data, column), nil)
			}
		</th>
	} else {
		<th scope="col" data-column={ column.Key }>
			if column.SortHref != "" {
				@clientSortLink(data, column)
			} else {
				@atoms.HeaderText(ClientColumnLabelText(data, column), nil)
			}
		</th>
	}
}
