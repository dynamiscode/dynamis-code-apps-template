package molecules



// PageHeading matches the workspace and resource page heading pattern.
templ PageHeading(title, eyebrow string) {
	<div class="workspace-heading"><div>
		if eyebrow != "" {
			<p class="eyebrow">{ eyebrow }</p>
		}
		// The top bar already carries the page title, so a page in the shell starts its heading outline at
		// level two and keeps exactly one h1 per document.
		<h2>{ title }</h2>
	</div>{ children... }</div>
}
