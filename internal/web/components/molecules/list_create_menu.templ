package molecules

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"


// ListCreateMenu is the list's primary action. Its form opens in a popover from the toolbar.
templ ListCreateMenu(label string, open bool) {
	@atoms.Dropdown(atoms.DropdownProps{
		Class:          "list-menu client-create",
		Label:          label,
		SummaryClass:   "btn btn-primary",
		Open:           open,
		PanelClass:     "bg-base-100 rounded-box shadow-lg border border-base-200 p-3 w-80 max-w-[90vw]",
		PanelChildren:  true,
	}) {
		{ children... }
	}
}
