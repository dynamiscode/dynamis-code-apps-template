package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "strings"

templ clientList(data viewmodel.PageData) {
	// The list behaviors (menu placement, exclusive open, tap-outside close,
	// tap-to-open rows, bulk selection) mount here, as the items list does.
	<section id="client-list" x-data="listScreen" data-events={ data.CurrentPath + "/events" }
		data-live-connecting={ data.T("clients.live_connecting") }
		data-live-connected={ data.T("clients.live_connected") }
		data-live-unavailable={ data.T("clients.live_unavailable") }
		data-live-reconnecting={ data.T("clients.live_reconnecting") }
		data-live-waiting={ data.T("ui.updates_waiting") }
		aria-labelledby="clients-heading">
		<h2 id="clients-heading" class="sr-only">{ data.T("clients.title") }</h2>
		<div class="feature-list-heading">
			@molecules.PageHeading(data.T("clients.title"), "")
			<div class="feature-list-heading-actions">
				@clientCreateMenu(data)
			</div>
		</div>
		if !data.ClientListEmpty && !data.CanEditClients {
			<p class="status-line">{ data.T("clients.read_only") }</p>
		}
		if data.ErrorKey != "" {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		<div class="client-results" id="client-results">
			@clientListView(data)
		</div>
		if data.CanEditClients {
			<dialog class="modal" aria-labelledby="client-create-title" data-client-dialog data-client-discard-message={ data.T("ui.unsaved") }>
				<div class="modal-box w-full max-w-lg">
					<div class="flex items-center justify-between gap-4">
						<h2 id="client-create-title" class="text-xl font-bold">{ data.T("clients.new_client") }</h2>
						<button class="btn btn-ghost btn-sm btn-circle shrink-0" type="button" data-client-close aria-label={ data.T("ui.close") }>×</button>
					</div>
					<div id="client-create-content">@clientCreateContent(data, true)</div>
				</div>
			</dialog>
		}
	</section>
}

templ clientListView(data viewmodel.PageData) {
	if !data.ClientListEmpty {
		<div class="list-toolbar">
			@molecules.ListSearch(data, "clients.search", data.ListSearch)
			@organisms.ListViewSwitcher(data)
			@organisms.ListAddFilter(data)
			@clientListTools(data)
		</div>
		@organisms.ListFilterBar(data)
	} else {
		@molecules.StatusLine(data.T("clients.live_fallback"), templ.Attributes{"aria-live": "polite", "id": "realtime-status"})
	}
	@clientResults(data)
}

// clientListTools are the client list's toolbar controls: columns, bulk actions, and live status.
templ clientListTools(data viewmodel.PageData) {
	@molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
	if data.ListSelectable {
		@clientBulkBar(data)
	}
	@molecules.StatusLine(data.T("clients.live_fallback"), templ.Attributes{"aria-live": "polite", "id": "realtime-status"})
}

// clientNotice tells the user when the sort is hidden by the columns.
templ clientNotice(data viewmodel.PageData) {
	if data.HiddenClientSort != "" {
		<p class="status-line">{ data.T("clients.hidden_sort") }{ " " }
			if data.HiddenClientSortLabelKey != "" {
				{ data.T(data.HiddenClientSortLabelKey) }
			} else {
				{ data.HiddenClientSort }
			}
		</p>
	}
}

// clientResults is the results region: the table or cards, the empty state, and the footer. A sort, filter, or
// search swaps this region alone.
templ clientResults(data viewmodel.PageData) {
	<div id="list-results">
		@clientBody(data)
		if !data.ClientListEmpty {
			@organisms.ListFooter(data, clientPageLimit(data.ClientQuery.Limit), listPageSizeOptions(clientPageLimit(data.ClientQuery.Limit), listPageSizes)) {
				@molecules.ListPager(data)
			}
		}
	</div>
	if data.ListFragment && !data.ClientListEmpty {
		@organisms.ListFilterBarOOB(data)
		@molecules.ListColumnsBody(data, data.ClientQuerySuffix, true)
	}
}

// clientBody is the client list's rows: the table or cards, and the empty state.
templ clientBody(data viewmodel.PageData) {
	if data.ClientListEmpty {
		@clientEmptyState(data)
	} else {
		@clientNotice(data)
	if data.ClientQuery.Archived == "archived" {
		@molecules.StatusLine(data.T("clients.viewing_archived"), nil)
	}
	// An empty list renders no table at all: the header row alone reads as a
	// stray bar where the table "would be".
	if len(data.ListRows) > 0 && data.HasVisibleClientColumns {
		@organisms.ListTable(data.T("clients.title"), true) {
			@organisms.ListHeader(data, data.T("clients.actions"))
			<tbody>
				for _, row := range data.ListRows {
					@organisms.ListRow(clientDetailHref(data, row.ID)) {
						if data.ListSelectable {
							@clientRowSelect(data, row)
						}
						@organisms.ListCells(data, row, clientDetailHref(data, row.ID))
						@organisms.ListActionsCell(data, clientRowActions(data, row))
					}
				}
			</tbody>
		}
		@molecules.ListCards() {
			for _, row := range data.ListRows {
				@organisms.ListCardItem(data, row, clientDetailHref(data, row.ID)) {
					if data.ListSelectable {
						@clientCardSelect(data, row)
					}
					@organisms.ListActionsMenu(data, clientRowActions(data, row), true)
				}
			}
		}
	} else if len(data.ListRows) > 0 {
	@molecules.StatusLine(data.T("clients.columns_choose"), nil)
	}
	if len(data.ListRows) == 0 {
		if data.HasClientFilters || data.ListSearch != "" {
			@molecules.NoMatchesAlert(molecules.NoMatchesAlertProps{ID: "client-empty-state", Message: data.T("clients.no_matches"), Href: data.ClearClientFiltersPath, Label: data.T("clients.clear_filters")})
		} else if data.ClientQuery.Archived == "archived" {
			@molecules.EmptyState(data.T("clients.no_archived"))
		} else {
			@clientEmptyState(data)
		}
	}
	}
}

templ clientEmptyState(data viewmodel.PageData) {
	<section id="client-empty-state" class="flex min-h-64 flex-col items-center justify-center gap-4 px-4 text-center">
		<h2 class="text-xl font-semibold">{ data.T("clients.empty_title") }</h2>
		<p>{ data.T("clients.empty_description") }</p>
		@clientEmptyCTA(data)
	</section>
}

// clientEmptyCTA provides a create link that also works without JavaScript.
templ clientEmptyCTA(data viewmodel.PageData) {
	if data.CanEditClients {
		<a class="btn btn-primary" href={ templ.SafeURL(data.CurrentPath + "/new") } data-client-create>{ data.T("clients.new_client") }</a>
	}
}

templ clientCreateContent(data viewmodel.PageData, modal bool) {
	if data.ErrorKey != "" {
		@molecules.ErrorAlert(data.T(data.ErrorKey))
	}
	@clientCreateForm(data, data.CurrentPath+"/new", modal)
}

templ clientCreateForm(data viewmodel.PageData, action string, modal bool) {
	<form class="create space-y-3" action={ templ.SafeURL(action) } method="post" data-dirty-track data-unsaved-warning data-dirty-on-load?={ clientDraftHasInput(data.ClientDraft) } { templ.Attributes{"hx-post": templ.KV(action, modal), "hx-target": templ.KV("#client-create-content", modal), "hx-swap": templ.KV("innerHTML", modal)}... }>
		<input type="hidden" name="csrf" value={ data.CSRF }/>
		if modal {
			<input type="hidden" name="client_modal" value="1"/>
		}
		@molecules.EntryField(molecules.EntryFieldProps{ID: "client-display-name", Label: data.T("clients.display_name"), Value: data.ClientDraft.DisplayName}) {
			<input id="client-display-name" name="display_name" required maxlength="200" value={ data.ClientDraft.DisplayName } data-trim=""/>
		}
		<details data-client-advanced open?={ data.ErrorKey != "" || data.ClientDraft.Email != "" || data.ClientDraft.Phone != "" || data.ClientDraft.Notes != "" }>
			<summary>{ data.T("ui.advanced") }</summary>
			@molecules.EntryField(molecules.EntryFieldProps{ID: "client-email", Label: data.T("common.email")+" "+data.T("ui.optional"), Value: data.ClientDraft.Email}) {
				<input id="client-email" name="email" type="email" maxlength="254" value={ data.ClientDraft.Email }/>
			}
			@molecules.EntryField(molecules.EntryFieldProps{ID: "client-phone", Label: data.T("clients.phone")+" "+data.T("ui.optional"), Value: data.ClientDraft.Phone}) {
				<input id="client-phone" name="phone" type="tel" maxlength="50" value={ data.ClientDraft.Phone }/>
			}
			@molecules.EntryField(molecules.EntryFieldProps{ID: "client-notes", Label: data.T("clients.notes")+" "+data.T("ui.optional"), Value: data.ClientDraft.Notes}) {
				<textarea id="client-notes" name="notes" maxlength="5000">{ data.ClientDraft.Notes }</textarea>
			}
		</details>
		<div class="modal-action flex-wrap">
			@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.create"), Attrs: templ.Attributes{"type": "submit"}})
		</div>
	</form>
}

templ clientIntakeMenu(data viewmodel.PageData) {
	<details>
		<summary>{ data.T("intake.share") }</summary>
		<div class="flex w-full flex-col items-start gap-2 p-4">
			if !data.IntakeActive {
				<p>{ data.T("intake.disabled") }</p>
			} else if !data.IntakeReady {
				<p>{ data.T("intake.no_open_stage") }</p>
				<a class="btn btn-outline btn-sm" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/clients") + "/engagement-stages") }>{ data.T("engagement.stages") }</a>
			} else if data.IntakeUnavailable {
				<p>{ data.T("intake.share_unavailable") }</p>
			} else if data.IntakeLink != "" {
				<p>{ data.T("intake.active") }</p>
				<input id="client-intake-link" class="input input-bordered w-full" aria-label={ data.T("intake.link") } readonly value={ data.IntakeLink }/>
				<div>
					<button type="button" class="btn btn-primary btn-sm" data-copy-target="client-intake-link" data-copy-success={ data.T("intake.copied") }>{ data.T("intake.copy_button") }</button>
					<span role="status" aria-live="polite" data-copy-status></span>
				</div>
				<a class="btn btn-outline btn-sm" href={ templ.SafeURL(data.IntakeLink) } target="_blank" rel="noopener noreferrer">{ data.T("intake.test_link") }</a>
			} else {
				<p>{ data.T("intake.share_unavailable") }</p>
			}
			<a class="btn btn-outline btn-sm" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/clients") + "/intake") }>{ data.T("intake.configure") }</a>
		</div>
	</details>
}

// The empty state supplies the only create action on a pristine list.
templ clientCreateMenu(data viewmodel.PageData) {
	if !data.ClientListEmpty && data.CanEditClients {
		<div class="list-create">
			<a class="btn btn-primary" href={ templ.SafeURL(data.CurrentPath + "/new") } data-client-create>{ data.T("clients.new_client") }</a>
		</div>
	}
	@clientManageMenu(data)
}

templ clientManageMenu(data viewmodel.PageData) {
	{{
		items := []atoms.DropdownItem{
			{Label: data.T("engagement.due_list"), Attrs: templ.Attributes{"href": strings.TrimSuffix(data.CurrentPath, "/clients") + "/engagements/due"}},
		}
		if data.CanManageFields {
			if data.IntakeEnabled {
				items = append(items, atoms.DropdownItem{Item: clientIntakeMenu(data)})
				items = append(items, atoms.DropdownItem{Label: data.T("clients.manage_form"), Attrs: templ.Attributes{"href": strings.TrimSuffix(data.CurrentPath, "/clients") + "/intake"}})
			}
			items = append(items, atoms.DropdownItem{Label: data.T("clients.fields_link"), Attrs: templ.Attributes{"href": data.FieldsPath}})
		}
	}}
	@atoms.Dropdown(atoms.DropdownProps{
		Class: "dropdown-end",
		SummaryClass: "btn-outline btn-square",
		SummaryAttrs: templ.Attributes{"aria-label": data.T("clients.manage_menu")},
		Summary: molecules.RowMenuGlyph(true),
		ListClass: "z-50 w-80 max-w-[90vw] rounded-box bg-base-100 p-2 shadow-lg",
		Items: items,
	})
}
