package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "strconv"
import "strings"

templ clientList(data viewmodel.PageData) {
	// The list behaviors (menu placement, exclusive open, tap-outside close,
	// tap-to-open rows, bulk selection) mount here, as the items list does.
	<section id="client-list" x-data="listScreen" data-events={ data.CurrentPath + "/events" }
		data-live-connecting={ data.T("clients.live_connecting") }
		data-live-connected={ data.T("clients.live_connected") }
		data-live-unavailable={ data.T("clients.live_unavailable") }
		data-live-reconnecting={ data.T("clients.live_reconnecting") }
		data-live-waiting={ data.T("ui.updates_waiting") }
		aria-labelledby="clients-heading">
		<h2 id="clients-heading" class="sr-only">{ data.T("clients.title") }</h2>
		if data.CanEditClients {
			<p class="status-line">{ data.T("clients.create_engagement_instruction") }</p>
		}
		if data.ErrorKey != "" {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		<div class="client-results" id="client-results">
			@clientListView(data)
		</div>
	</section>
}

templ clientListView(data viewmodel.PageData) {
	@organisms.ListScreen(data, "clients.search", clientListTools(data), clientResults(data))
}

// clientListTools are the client list's own controls on the toolbar: the columns, the bulk actions, the create
// menu, and the live status.
templ clientListTools(data viewmodel.PageData) {
	if data.ListHasContent() {
		@molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
		if data.ListSelectable {
			@clientBulkBar(data)
		}
	}
	@clientCreateMenu(data)
	@molecules.StatusLine(data.T("clients.live_fallback"), templ.Attributes{"aria-live": "polite", "id": "realtime-status"})
}

// clientNotice tells the user when the sort is hidden by the columns.
templ clientNotice(data viewmodel.PageData) {
	if data.HiddenClientSort != "" {
		<p class="status-line">{ data.T("clients.hidden_sort") }{ " " }
			if data.HiddenClientSortLabelKey != "" {
				{ data.T(data.HiddenClientSortLabelKey) }
			} else {
				{ data.HiddenClientSort }
			}
		</p>
	}
}

// clientResults is the results region: the table or cards, the empty state, and the footer. A sort, filter, or
// search swaps this region alone.
templ clientResults(data viewmodel.PageData) {
	@organisms.ListResults(data, clientPageLimit(data.ClientQuery.Limit), listPageSizeOptions(clientPageLimit(data.ClientQuery.Limit), listPageSizes), data.ClientQuerySuffix, clientBody(data), clientScopeLink(data))
}

// clientBody is the client list's rows: the table or cards, and the empty state.
templ clientBody(data viewmodel.PageData) {
	@clientNotice(data)
	if data.ClientQuery.Archived == "archived" {
		@molecules.StatusLine(data.T("clients.viewing_archived"), nil)
	}
	// An empty list renders no table at all: the header row alone reads as a
	// stray bar where the table "would be".
	if len(data.ListRows) > 0 && data.HasVisibleClientColumns {
		@organisms.ListTable(data.T("clients.title"), true) {
			@organisms.ListHeader(data, data.T("clients.actions"))
			<tbody>
				for _, row := range data.ListRows {
					@organisms.ListRow(data.CurrentPath + "/" + row.ID) {
						if data.ListSelectable {
							@clientRowSelect(data, row)
						}
						@organisms.ListCells(data, row, data.CurrentPath + "/" + row.ID)
						@organisms.ListActionsCell(data, clientRowActions(data, row))
					}
				}
			</tbody>
		}
		@molecules.ListCards() {
			for _, row := range data.ListRows {
				@organisms.ListCardItem(data, row, data.CurrentPath + "/" + row.ID) {
					if data.ListSelectable {
						@clientCardSelect(data, row)
					}
					@organisms.ListActionsMenu(data, clientRowActions(data, row), true)
				}
			}
		}
	} else if len(data.ListRows) > 0 {
	@molecules.StatusLine(data.T("clients.columns_choose"), nil)
	}
	if len(data.ListRows) == 0 {
		if data.HasClientFilters || data.ListSearch != "" {
			@molecules.NoMatchesAlert(molecules.NoMatchesAlertProps{ID: "client-empty-state", Message: data.T("clients.no_matches"), Href: data.ClearClientFiltersPath, Label: data.T("clients.clear_filters")})
		} else {
			@molecules.EmptyStateCard(molecules.EmptyStateCardProps{ID: "client-empty-state", Title: data.T("clients.empty_title"), Description: data.T("clients.empty_description"), CTA: clientEmptyCTA(data)})
		}
	}
}

// clientEmptyCTA gives a pristine list one way to create: it opens the create
// page, so no form is loaded on a list that has nothing to show yet.
templ clientEmptyCTA(data viewmodel.PageData) {
	if data.CanEditClients {
		<a class="btn btn-primary btn-sm" href={ templ.SafeURL(data.CurrentPath + "/new") }>{ data.T("clients.new_client") }</a>
	}
}

// clientCreateForm is the client create form, rendered only by the create page.
templ clientCreateForm(data viewmodel.PageData, action string) {
	<form class="create" action={ templ.SafeURL(action) } method="post" data-dirty-track data-dirty-on-load?={ clientDraftHasInput(data.ClientDraft) }>
		<input type="hidden" name="csrf" value={ data.CSRF }/>
		@molecules.TextField("client-display-name", data.T("clients.display_name"), templ.Attributes{"name": "display_name", "required": true, "maxlength": "200", "value": data.ClientDraft.DisplayName, "data-trim": ""})
		@molecules.TextField("client-email", data.T("common.email")+" "+data.T("ui.optional"), templ.Attributes{"name": "email", "type": "email", "maxlength": "254", "value": data.ClientDraft.Email})
		@molecules.TextField("client-phone", data.T("clients.phone")+" "+data.T("ui.optional"), templ.Attributes{"name": "phone", "maxlength": "50", "value": data.ClientDraft.Phone})
		@molecules.TextareaField("client-notes", data.T("clients.notes")+" "+data.T("ui.optional"), data.ClientDraft.Notes, templ.Attributes{"name": "notes", "maxlength": "5000"})
		<div class="actions">@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.add"), Attrs: templ.Attributes{"type": "submit"}})</div>
	</form>
}

// clientCreateMenu is the toolbar's "New client" action: a link to the create page.
// Users who cannot write see a read-only note, and a pristine list renders no
// second primary action because its empty-state card already offers this one.
templ clientCreateMenu(data viewmodel.PageData) {
	<div class="list-create">
		<a class="btn btn-ghost btn-xs" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/clients") + "/engagements") }>{ data.T("engagement.list") }</a>
		<a class="btn btn-ghost btn-xs" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/clients") + "/engagement-stages") }>{ data.T("engagement.stages") }</a>
		<a class="btn btn-ghost btn-xs" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/clients") + "/engagements/due") }>{ data.T("engagement.due_list") }</a>
			if data.CanManageFields {
				<a class="btn btn-ghost btn-xs" href={ data.FieldsPath }>{ data.T("clients.fields_link") }</a>
			}
		if !data.CanEditClients {
			<p class="status-line">{ data.T("clients.read_only") }</p>
		} else if data.ListHasContent() {
			<a class="btn btn-primary" href={ templ.SafeURL(data.CurrentPath + "/new") }>{ data.T("clients.new_client") }</a>
		}
	</div>
}







// clientScopeLink is the footer's way to the archived clients, and back. It is kept out of the toolbar so the
// archived view stays easy to find without competing with search and the primary actions.
templ clientScopeLink(data viewmodel.PageData) {
	if data.ClientQuery.Archived == "archived" {
		<a class="client-scope-link" href={ templ.SafeURL(clientScopeHref(data, "active")) }>{ data.T("clients.back_to_active") }</a>
	} else {
		<a class="client-scope-link" href={ templ.SafeURL(clientScopeHref(data, "archived")) }>
			{ data.T("clients.show_archived") }
			if data.ArchivedClientCount > 0 {
				<span class="client-scope-count">({ strconv.Itoa(data.ArchivedClientCount) })</span>
			}
		</a>
	}
}
