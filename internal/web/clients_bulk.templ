package web

import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
// clientBulkBar is the bulk form for the rows on this page. Its checkboxes and buttons name the form by id, so the
// table needs no form of its own. Archive and delete read the selected client IDs and return to this list.
templ clientBulkBar(data viewmodel.PageData) {
	<form id="client-bulk" class="client-bulk" method="post" action={ data.CurrentPath + "/bulk" }>
		<input type="hidden" name="csrf" value={ data.CSRF }/>
		<input type="hidden" name="return" value={ data.CurrentPath + data.ClientQuerySuffix }/>
				<span class="client-bulk-count" aria-live="polite" data-count-template={ data.T("clients.bulk_selected", map[string]any{"count": "COUNT"}) }>{ data.T("clients.bulk_selected", map[string]any{"count": 0}) }</span>
		@atoms.Button(atoms.ButtonProps{Class: "btn-ghost btn-xs", Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "archive", "data-bulk-action": true}}) {
			@organisms.ListActionIcon("archive")
			{ data.T("clients.bulk_archive") }
		}
		if data.CanDeleteClients {
			<p class="warning alert alert-warning py-2">{ data.T("clients.bulk_delete_confirm") }</p>
			@atoms.Button(atoms.ButtonProps{Class: "btn-xs client-bulk-danger", Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "delete", "data-bulk-action": true, "data-confirm": data.T("clients.bulk_delete_confirm")}}) {
				@organisms.ListActionIcon("delete")
				{ data.T("clients.bulk_delete") }
			}
		}
	</form>
}

// clientRowSelect is a row's selection checkbox in the table.
templ clientRowSelect(data viewmodel.PageData, row viewmodel.ListRow) {
	<td class="list-select-cell">@atoms.Checkbox(atoms.CheckboxProps{
		Name: "client_id",
		Attrs: templ.Attributes{"form": "client-bulk", "value": row.ID, "data-bulk-row": true, "aria-label": data.T("clients.bulk_select_row", map[string]any{"name": row.CellText(data.ClientListLinkKey())})},
	})</td>
}

// clientCardSelect is a card's selection checkbox on small screens.
templ clientCardSelect(data viewmodel.PageData, row viewmodel.ListRow) {
	@atoms.Checkbox(atoms.CheckboxProps{
		Name:       "client_id",
		LabelClass: "list-select",
		After:      data.T("clients.bulk_select"),
		Attrs:      templ.Attributes{"form": "client-bulk", "value": row.ID, "data-bulk-row": true, "aria-label": data.T("clients.bulk_select_row", map[string]any{"name": row.CellText(data.ClientListLinkKey())})},
	})
}

