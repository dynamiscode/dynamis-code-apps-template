package web

import "strconv"
import "net/url"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"
import "example.com/dynamis-code/apps-template/internal/clients"
import "example.com/dynamis-code/apps-template/internal/transactions"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

templ transactionsPage(data viewmodel.PageData, rows []transactionsRow, sources map[transactions.EntryID]transactions.Entry, clientNames map[clients.ClientID]string, methods, filterMethods []transactions.Method, categories []transactions.Category, canManage, canManageCategories bool, picker transactionsPicker, draft transactionsDraft, errorKey, errorMessage, methodError, methodID, methodName string, saved, methodSaved, categorySaved, voided bool, page int, canWrite, canVoid, canConfigure bool, query url.Values, filterPicker transactionsPicker, empty bool) {
 @templates.DashboardShell(data, templates.DashboardHome) {
  {{ recordView := query.Get("view") == "record" || picker.focus && draft.editID == "" || draft.correctionFocus || draft.recordView || (errorKey != "" && draft.voidError == "" && draft.editID == ""); base := "/workspaces/"+data.Workspace.ID.String()+"/transactions"; settings := "/workspaces/"+data.Workspace.ID.String()+"/settings/transactions" }}
  if recordView {
   @molecules.BackLink(base+transactionsPageURL(query, page)+"#transactions-entries-heading", data.T("transactions.totals_back"))
  }
  <div class="feature-list-heading">
   @molecules.PageHeading(data.T("transactions.title"), "")
   if !recordView && (canWrite && !empty || canManage || canManageCategories) {
    <div class="feature-list-heading-actions" data-transactions-actions>
     if canWrite && !empty {
      <div class="list-create"><a class="btn btn-primary" href={ templ.SafeURL(base+transactionsPageURL(query, page)+"&view=record") } data-transactions-create>{ data.T("transactions.create") }</a></div>
     }
     if canManage || canManageCategories {
      <details class="dropdown dropdown-end">
       <summary class="btn btn-outline btn-square" aria-label={ data.T("navigation.settings") }><span aria-hidden="true">⋮</span></summary>
       <div class="dropdown-content z-50 w-64 max-w-[90vw] rounded-box bg-base-100 p-2 shadow-lg">
        <ul class="menu">
         <li><a href={ templ.SafeURL(settings) }>{ data.T("transactions.manage") }</a></li>
         if canManage {
          <li><a href={ templ.SafeURL(settings+"/methods") }>{ data.T("transactions.methods") }</a></li>
          <li><a href={ templ.SafeURL(base+"/totals?period=this_month") }>{ data.T("transactions.totals") }</a></li>
         }
         if canManageCategories {
          <li><a href={ templ.SafeURL(settings+"/categories") }>{ data.T("transactions.manage_categories") }</a></li>
         }
        </ul>
       </div>
      </details>
     }
    </div>
   }
  </div>
  <dialog class="modal" aria-labelledby="transactions-create-heading" data-transactions-dialog open?={ recordView }>
  <div class="modal-box detail-main w-11/12 max-w-3xl">
  <section aria-labelledby="transactions-create-heading">
   <h2 id="transactions-create-heading" class="text-xl font-bold">{ data.T("transactions.create") }</h2>
   if errorKey != "" && draft.voidError == "" {
    @molecules.ErrorAlert(errorMessage)
   }
   <form id="transactions-create-form" method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/transactions"+transactionsPageURL(query, page)) } class="transaction-entry-form space-y-3" novalidate>
    <input type="hidden" name="csrf" value={ data.CSRF }/>
    <input type="hidden" name="entry_page" value={ strconv.Itoa(page) }/>
    {{ amountLocale := draft.amountLocale; if amountLocale == "" { amountLocale = data.Locale } }}
    <input type="hidden" name="amount_locale" value={ amountLocale }/>
    @transactionsCreateFields(data, methods, categories, picker, draft, errorKey, errorMessage)
    if canVoid {
     <input type="hidden" name="replaces_entry_id" value={ draft.replacesID }/>
    }
    <input type="hidden" name="refund_of_entry_id" value={ draft.refundOfID }/>
    for _, source := range sources {
     if (draft.replacesID != "" && source.ID.String() == draft.replacesID) || (draft.replacesID == "" && draft.refundOfID != "" && source.ID.String() == draft.refundOfID) {
      <p class="md:col-span-2">{ data.T("transactions.source_entry") }: @transactionsSourceLink(data, source, clientNames)</p>
     }
    }
    <div class="flex flex-wrap gap-2 md:col-span-2">
     <button class="btn btn-primary" type="submit" data-transactions-submit>{ data.T("transactions.create") }</button>
     <a class="btn btn-outline" href={ templ.SafeURL(base+transactionsPageURL(query, page)+"#transactions-entries-heading") } data-transactions-cancel>{ data.T("common.cancel") }</a>
    </div>
   </form>
  </section>
  </div>
  </dialog>
  if !recordView {
  <section aria-labelledby="transactions-entries-heading" x-data="listScreen">
   <h2 id="transactions-entries-heading" class="text-xl font-bold scroll-mt-24">{ data.T("transactions.entries") }</h2>
   if !empty {
   <div class="list-toolbar">
    @molecules.ListSearch(data, "transactions.search_entries", data.ListSearch)
    if data.ListViewRoute != "" {
     @organisms.ListViewSwitcher(data)
    }
    if data.Filter.Step != nil && data.Filter.Step.FieldKey == "client_id" {
     @molecules.ListAddMenu(data.T("clients.add_filter"), true, true) {
      @transactionsClientFilterPanel(data, filterPicker)
     }
    } else {
     @organisms.ListAddFilter(data)
     <template data-filter-override="client_id">@transactionsClientFilterPanel(data, filterPicker)</template>
    }
    if canConfigure {
     @molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
    }
   </div>
   @organisms.ListFilterBar(data)
   }
   @transactionsResults(data, rows, sources, clientNames, draft, errorMessage, saved, voided, page, canWrite, canVoid, query, filterPicker, empty)
  </section>
  }
 }
}

templ transactionsClientFilterPanel(data viewmodel.PageData, filterPicker transactionsPicker) {
 <form method="get" action={ templ.SafeURL(data.CurrentPath) } class="space-y-3">
  for _, field := range data.Filter.Preserved {
   if field.Name != "filter_search" && field.Name != "filter_client_page" {
    <input type="hidden" name={ field.Name } value={ field.Value }/>
   }
  }
  <input type="hidden" name="filter_field" value="client_id"/>
  @molecules.TextField("transactions-filter-search", data.T("transactions.search_clients"), templ.Attributes{"name":"filter_search", "type":"search", "maxlength":"200", "value":filterPicker.search})
  <button class="btn btn-outline btn-sm" type="submit" name="filter_picker_action" value="search">{ data.T("ui.search") }</button>
  <nav class="flex flex-wrap gap-2" aria-label={ data.T("transactions.client_pages") }>
   if filterPicker.page > 1 {
    <button class="btn btn-outline btn-sm" type="submit" name="filter_client_page" value={ strconv.Itoa(filterPicker.page-1) }>{ data.T("ui.previous_page") }</button>
   }
   if filterPicker.page < clients.MaxListPage && filterPicker.page*25 < filterPicker.total {
    <button class="btn btn-outline btn-sm" type="submit" name="filter_client_page" value={ strconv.Itoa(filterPicker.page+1) }>{ data.T("items.next_page") }</button>
   }
  </nav>
 </form>
 <form method="get" action={ templ.SafeURL(data.CurrentPath) } class="space-y-3">
  for _, field := range data.Filter.Preserved {
   if field.Name != "filter_search" && field.Name != "filter_client_page" {
    <input type="hidden" name={ field.Name } value={ field.Value }/>
   }
  }
  <input type="hidden" name="filter_field" value="client_id"/>
  <input type="hidden" name="filter_op" value="equals"/>
  <label class="form-control flex flex-col gap-1" for="transactions-filter-client"><span>{ data.T("transactions.client") }</span>
   <select id="transactions-filter-client" name="filter_value" class="select select-bordered" required autofocus?={ filterPicker.focus }>
    <option value="">{ data.T("transactions.no_client") }</option>
    if filterPicker.selected.ID != 0 {
     <option value={ filterPicker.selected.ID.String() } selected>{ filterPicker.selected.DisplayName }</option>
    }
    for _, client := range filterPicker.choices {
     if client.ID != filterPicker.selected.ID {
      <option value={ client.ID.String() }>{ client.DisplayName }</option>
     }
    }
   </select>
  </label>
  <div class="flex flex-wrap gap-2">
   <a class="btn btn-sm" href={ templ.SafeURL(data.Filter.BackHref) } data-filter-back>{ data.T("clients.back_to_fields") }</a>
   <button class="btn btn-primary btn-sm" type="submit">{ data.T("clients.filter_add") }</button>
  </div>
 </form>
}

templ transactionsResults(data viewmodel.PageData, rows []transactionsRow, sources map[transactions.EntryID]transactions.Entry, clientNames map[clients.ClientID]string, draft transactionsDraft, errorMessage string, saved, voided bool, page int, canWrite, canVoid bool, query url.Values, filterPicker transactionsPicker, empty bool) {
 <div id="list-results">
   if filterPicker.dateError {
    <p id="transactions-filter-date-error" role="alert" tabindex="-1" class="text-error">{ data.T("transactions.filter_date_order") }</p>
   }
   if draft.voidError != "" {
    <div tabindex="-1" autofocus>@molecules.ErrorAlert(errorMessage)</div>
   }
   if !empty {
   <nav class="flex flex-wrap gap-2 sm:hidden" aria-label={ data.T("clients.sort_label") }>
    for _, column := range data.ListColumns {
     if column.Visible && column.SortHref != "" {
      <a class="btn btn-sm btn-outline" href={ templ.SafeURL(column.SortHref) }>{ data.T(column.LabelKey) }</a>
     }
    }
   </nav>
   }
   if saved {
    @molecules.SuccessAlert(data.T("transactions.saved"))
   }
   if voided {
    @molecules.SuccessAlert(data.T("transactions.voided_success"))
   }
   if empty {
    <div class="flex min-h-64 flex-col items-center justify-center gap-4 px-4 text-center">
     <h3 class="text-xl font-bold">{ data.T("transactions.entries") }</h3>
     <p>{ data.T("transactions.empty") }</p>
     if canWrite {
      <a class="btn btn-primary" href={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/transactions?view=record") } data-transactions-create>{ data.T("transactions.create") }</a>
     }
    </div>
   } else if !filterPicker.dateError && len(rows) == 0 {
    if data.HasClientFilters || data.ListSearch != "" {
     @molecules.NoMatchesAlert(molecules.NoMatchesAlertProps{ID: "transactions-filter-empty-state", Message: data.T("transactions.filter_empty"), Href: data.ClearClientFiltersPath, Label: data.T("clients.clear_filters")})
    } else if page == 1 {
     <p>{ data.T("transactions.empty") }</p>
    } else {
     <p>{ data.T("transactions.empty_page") }</p>
    }
   } else if !filterPicker.dateError {
    @organisms.ListTable(data.T("transactions.entries"), true) {
     @organisms.ListHeader(data, data.T("clients.actions"))
     <tbody>
      for _, row := range rows {
       @organisms.ListRow("") {
        for _, column := range data.ListColumns {
         if column.Visible && column.Key == "description" {
          @organisms.ListLinkedCell(transactionsDetailsURL(query, page, row.entry.ID), templ.Attributes{"data-column": column.Key}) {
           @transactionsCell(data, row, column.Key)
          }
         } else if column.Visible {
          <td data-column={ column.Key }>@transactionsCell(data, row, column.Key)</td>
         }
        }
        @organisms.ListActionsContentCell(data) {
         @transactionsRowActions(data, row, canWrite, canVoid, query, page)
        }
       }
      }
     </tbody>
    }
    @molecules.ListCards() {
     for _, row := range rows {
      <li class="list-row card relative p-4">
       <dl>
        for _, column := range data.ListColumns {
         if column.Visible {
          <dt>{ data.T(column.LabelKey) }</dt>
          <dd data-column={ column.Key }>
           if column.Key == "description" {
            <a class="link" href={ templ.SafeURL(transactionsDetailsURL(query, page, row.entry.ID)) }>@transactionsCell(data, row, column.Key)</a>
           } else {
            @transactionsCell(data, row, column.Key)
           }
          </dd>
         }
        }
       </dl>
       @organisms.ListRowMenuCard(data) {
        @transactionsRowActions(data, row, canWrite, canVoid, query, page)
       }
      </li>
     }
    }
    for _, row := range rows {
     if (draft.voidID == row.entry.ID.String() && draft.voidError != "") || draft.editID == row.entry.ID.String() || query.Get("details") == row.entry.ID.String() {
      <dialog id="transactions-entry-details" class="modal" open data-transactions-details-dialog aria-labelledby="transactions-details-heading">
       <div class="modal-box detail-main w-11/12 max-w-3xl">
        <div class="flex items-start justify-between gap-3">
         <h3 id="transactions-details-heading" class="text-xl font-bold">{ data.T("transactions.details_actions") }</h3>
         <a class="btn btn-ghost btn-square shrink-0" href={ templ.SafeURL(transactionsPageURL(query, page)+"#transactions-entries-heading") } data-transactions-details-close aria-label={ data.T("ui.close") }><span aria-hidden="true">×</span></a>
        </div>
        @transactionsEntryDetails(data, row, sources, clientNames, draft, errorMessage, canWrite, canVoid, query, page, "dialog")
       </div>
      </dialog>
     }
    }
   }
   if !empty && !filterPicker.dateError && (data.ListTotal > 0 || data.HasClientFilters || data.ListSearch != "") {
    <div class="list-footer">
     if len(rows) > 0 {
      <p class="list-footer-count">{ data.T("ui.rows_range", map[string]any{"start": data.ListStart, "end": data.ListStart+len(rows)-1, "total": data.ListTotal}) }</p>
     } else if data.ListTotal > 0 {
      <p class="list-footer-count">{ data.T("ui.rows_past_end", map[string]any{"total": data.ListTotal}) }</p>
     }
     @molecules.ListPager(data)
     if page > 1 && data.ListPager.PageCount == 1 {
      <a class="btn btn-sm" href={ templ.SafeURL(transactionsPageURL(query, page-1)+"#transactions-entries-heading") }>{ data.T("ui.previous_page") }</a>
     }
     @molecules.ListPageSize(data, data.ClientQuery.Limit, listPageSizeOptions(data.ClientQuery.Limit, listPageSizes))
    </div>
   }
 </div>
 if data.ListFragment {
  @molecules.ListColumnsBody(data, data.ClientQuerySuffix, true)
 }
}

templ transactionsRowActions(data viewmodel.PageData, row transactionsRow, canWrite, canVoid bool, query url.Values, page int) {
 {{ entry := row.entry; base := "/workspaces/"+data.Workspace.ID.String()+"/transactions" }}
 <a class="list-action-item border border-base-300 rounded-field" href={ templ.SafeURL(transactionsDetailsURL(query, page, entry.ID)) }>
  @organisms.ListActionIcon("open") <span>{ data.T("transactions.details_actions") }</span>
 </a>
 if canWrite && entry.Direction == "in" && entry.VoidedAt == "" {
  <form class="list-action-form" method="post" action={ templ.SafeURL(base+transactionsPageURL(query, page)) }>
   <input type="hidden" name="csrf" value={ data.CSRF }/>
   <input type="hidden" name="entry_page" value={ strconv.Itoa(page) }/>
   <button class="list-action-item border border-base-300 rounded-field" type="submit" name="correction_action" value={ "refund:"+entry.ID.String() }>
    @organisms.ListActionIcon("open") <span>{ data.T("transactions.refund_action") }</span>
   </button>
  </form>
 }
 if canVoid && entry.VoidedAt != "" {
  <form class="list-action-form" method="post" action={ templ.SafeURL(base+transactionsPageURL(query, page)) }>
   <input type="hidden" name="csrf" value={ data.CSRF }/>
   <input type="hidden" name="entry_page" value={ strconv.Itoa(page) }/>
   <button class="list-action-item border border-base-300 rounded-field" type="submit" name="correction_action" value={ "replace:"+entry.ID.String() }>
    @organisms.ListActionIcon("edit") <span>{ data.T("transactions.replace_action") }</span>
   </button>
  </form>
 }
 if canVoid && entry.VoidedAt == "" {
  <a class="list-action-item is-danger border border-error rounded-field" href={ templ.SafeURL(transactionsPageURL(query, page)+"&details="+url.QueryEscape(entry.ID.String())+"&action=void#transactions-entry-details") }>
   @organisms.ListActionIcon("delete") <span>{ data.T("transactions.void") }</span>
  </a>
 }
}

templ transactionsEntryDetails(data viewmodel.PageData, row transactionsRow, sources map[transactions.EntryID]transactions.Entry, clientNames map[clients.ClientID]string, draft transactionsDraft, errorMessage string, canWrite, canVoid bool, query url.Values, page int, suffix string) {
 {{ entry := row.entry; base := "/workspaces/"+data.Workspace.ID.String()+"/transactions"; editable := canVoid && entry.VoidedAt == ""; clientID := ""; clientName := row.clientName; categoryID := ""; if entry.ClientID != nil { clientID = entry.ClientID.String(); if clientName == "" { clientName = data.T("transactions.client_unavailable") } }; if entry.CategoryID != nil { categoryID = entry.CategoryID.String() } }}
       <div class="space-y-3">
       if draft.editID == entry.ID.String() && draft.editError != "" && !editable {
        @molecules.ErrorAlert(data.T(draft.editError))
        <p>{ data.T("transactions.submitted_value") }: { draft.editValue }</p>
       }
       <dl class="detail-values transaction-detail-values grid grid-cols-1 gap-y-1 break-words">
        <dt>{ data.T("transactions.description") }</dt><dd>@transactionsInlineField(data, row, draft, query, page, "description", data.T("transactions.description"), entry.Description, entry.Description, "text", "200", true, editable)</dd>
        <dt>{ data.T("transactions.direction") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "direction", data.T("transactions.direction"), entry.Direction, data.T("transactions."+entry.Direction), editable)</dd>
        <dt>{ data.T("transactions.amount") }</dt><dd>@transactionsInlineField(data, row, draft, query, page, "amount_minor", data.T("transactions.amount"), transactionsAmountInput(entry, data.Locale), transactions.FormatAmount(entry.AmountMinor, entry.Currency, data.Locale), "text", "", true, editable)</dd>
        <dt>{ data.T("transactions.currency") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "currency", data.T("transactions.currency"), entry.Currency, entry.Currency, editable)</dd>
        <dt>{ data.T("transactions.method") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "payment_method", data.T("transactions.method"), entry.PaymentMethod, transactionsMethodLabel(data, entry.PaymentMethod, row.methodName), editable)</dd>
        if categoryID != "" {
         <dt>{ data.T("transactions.category") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "category_id", data.T("transactions.category"), categoryID, entry.CategoryName, editable)</dd>
        }
        <dt>{ data.T("transactions.date") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "occurred_on", data.T("transactions.date"), entry.OccurredOn, entry.OccurredOn, editable)</dd>
        if clientID != "" {
         <dt>{ data.T("transactions.client") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "client_id", data.T("transactions.client"), clientID, clientName, editable)</dd>
        }
        if entry.Note != "" {
         <dt>{ data.T("transactions.note") }</dt><dd>@transactionsInlineField(data, row, draft, query, page, "note", data.T("transactions.note")+" "+data.T("ui.optional"), entry.Note, entry.Note, "textarea", "1000", false, editable)</dd>
        }
        <dt>{ data.T("transactions.entry_id") }</dt><dd>{ entry.ID.String() }</dd>
        <dt>{ data.T("transactions.author") }</dt><dd>
         if row.authorName == "" {
          { data.T("transactions.former_member") }
         } else {
          { row.authorName }
         }
        </dd>
        <dt>{ data.T("transactions.created") }</dt><dd>{ entry.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }</dd>
        if entry.VoidedAt != "" {
         <dt>{ data.T("transactions.voided_by") }</dt><dd>
          if row.voiderName == "" {
           { data.T("transactions.former_member") }
          } else {
           { row.voiderName }
          }
         </dd>
         <dt>{ data.T("transactions.voided_at") }</dt><dd>{ transactionsVoidTime(entry.VoidedAt) }</dd>
         <dt>{ data.T("transactions.void_reason") }</dt><dd>{ entry.VoidReason }</dd>
        }
        if entry.ReplacesEntryID != 0 {
         <dt>{ data.T("transactions.original_replacement") }</dt><dd>
          {{ source, ok := sources[entry.ReplacesEntryID] }}
          if ok {
           @transactionsSourceLink(data, source, clientNames)
          } else {
           { data.T("transactions.source_unavailable") }
          }
         </dd>
        }
        if entry.RefundOfEntryID != 0 {
         <dt>{ data.T("transactions.original_refund") }</dt><dd>
          {{ source, ok := sources[entry.RefundOfEntryID] }}
          if ok {
           @transactionsSourceLink(data, source, clientNames)
          } else {
           { data.T("transactions.source_unavailable") }
          }
         </dd>
        }
       </dl>
       if categoryID == "" || clientID == "" || entry.Note == "" {
        <details class="transaction-advanced" open?={ draft.editID == entry.ID.String() && (draft.editField == "category_id" || draft.editField == "client_id" || draft.editField == "note") }>
         <summary class="cursor-pointer">{ data.T("ui.advanced") }</summary>
         <dl class="detail-values transaction-detail-values grid grid-cols-1 gap-y-1 break-words">
          if categoryID == "" {
           <dt>{ data.T("transactions.category") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "category_id", data.T("transactions.category"), categoryID, entry.CategoryName, editable)</dd>
          }
          if clientID == "" {
           <dt>{ data.T("transactions.client") }</dt><dd>@transactionsInlineChoice(data, row, draft, query, page, "client_id", data.T("transactions.client"), clientID, row.clientName, editable)</dd>
          }
          if entry.Note == "" {
           <dt>{ data.T("transactions.note") }</dt><dd>@transactionsInlineField(data, row, draft, query, page, "note", data.T("transactions.note")+" "+data.T("ui.optional"), entry.Note, entry.Note, "textarea", "1000", false, editable)</dd>
          }
         </dl>
        </details>
       }
       if row.refundCount > 0 {
        <a href={ templ.SafeURL("?refund_of_entry_id="+entry.ID.String()+"#transactions-entries-heading") } aria-label={ data.T("transactions.linked_refunds")+" "+entry.ID.String() }>{ data.T("transactions.linked_refunds") } ({ strconv.Itoa(row.refundCount) })</a>
       }
       if canWrite && entry.Direction == "in" && entry.VoidedAt == "" {
        <form method="post" action={ templ.SafeURL(base+transactionsPageURL(query, page)) }>
         <input type="hidden" name="csrf" value={ data.CSRF }/>
         <input type="hidden" name="entry_page" value={ strconv.Itoa(page) }/>
         <button class="btn btn-outline btn-sm" type="submit" name="correction_action" value={ "refund:"+entry.ID.String() }>{ data.T("transactions.refund_action") }</button>
        </form>
       }
       if canVoid && entry.VoidedAt != "" {
        <form method="post" action={ templ.SafeURL(base+transactionsPageURL(query, page)) }>
         <input type="hidden" name="csrf" value={ data.CSRF }/>
         <input type="hidden" name="entry_page" value={ strconv.Itoa(page) }/>
         <button class="btn btn-outline btn-sm" type="submit" name="correction_action" value={ "replace:"+entry.ID.String() }>{ data.T("transactions.replace_action") }</button>
        </form>
       }
       if canVoid && entry.VoidedAt == "" {
        <details open?={ (draft.voidID == entry.ID.String() && draft.voidError != "") || query.Get("action") == "void" }>
         <summary class="cursor-pointer">{ data.T("transactions.void") }</summary>
        if draft.voidID == entry.ID.String() && draft.voidError != "" {
         <div id={ "transactions-void-error-"+entry.ID.String()+"-"+suffix }>@molecules.ErrorAlert(errorMessage)</div>
        }
        <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/transactions/entries/"+entry.ID.String()+"/void"+transactionsPageURL(query, page)) } class="space-y-3">
         <input type="hidden" name="csrf" value={ data.CSRF }/>
         @molecules.TextField("transactions-void-reason-"+entry.ID.String()+"-"+suffix, data.T("transactions.void_reason")+" "+data.T("ui.optional")+" "+entry.ID.String(), templ.Attributes{"name":"reason", "maxlength":"1000", "value":transactionsVoidReason(draft, entry.ID.String()), "aria-describedby":templ.KV("transactions-void-error-"+entry.ID.String()+"-"+suffix, draft.voidID == entry.ID.String() && draft.voidError != "")})
         <label class="flex items-start gap-2"><input type="checkbox" class="checkbox" name="confirm_void" value="yes" required/> <span>{ data.T("transactions.void_confirm") } { entry.ID.String() }</span></label>
         <button class="btn btn-outline" type="submit" aria-label={ data.T("transactions.void")+" "+entry.ID.String() }>{ data.T("transactions.void") }</button>
        </form>
        </details>
       }
       </div>
}

templ transactionsCell(data viewmodel.PageData, row transactionsRow, key string) {
 if key == "description" {
  if row.entry.Description == "" {
   { data.T("transactions.no_description") }
  } else {
   { row.entry.Description }
  }
 } else if key == "date" {
  { row.entry.OccurredOn }
 } else if key == "direction" {
  { data.T("transactions."+row.entry.Direction) }
 } else if key == "amount" {
  { transactions.FormatAmount(row.entry.AmountMinor, row.entry.Currency, data.Locale) }
 } else if key == "method" {
  { transactionsMethodLabel(data, row.entry.PaymentMethod, row.methodName) }
 } else if key == "category" {
  { row.entry.CategoryName }
 } else if key == "client" {
  if row.clientName != "" {
   { row.clientName }
  } else if row.entry.ClientID != nil {
   { data.T("transactions.client_unavailable") }
  }
 } else if key == "note" {
  if row.entry.Note != "" {
   { row.entry.Note }
  }
 } else if key == "status" && row.entry.VoidedAt != "" {
  { data.T("transactions.status_voided") }
 }
}

templ transactionsSourceLink(data viewmodel.PageData, source transactions.Entry, clientNames map[clients.ClientID]string) {
 <a class="link" href={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/transactions?entry_id="+url.QueryEscape(source.ID.String())+"#transactions-entries-heading") }>{ data.T("transactions."+source.Direction) } · { transactions.FormatAmount(source.AmountMinor, source.Currency, data.Locale) } · { source.OccurredOn } · { transactionsMethodLabel(data, source.PaymentMethod, source.PaymentMethodName) }
  if source.ClientID != nil {
   if clientNames[*source.ClientID] != "" {
    · { clientNames[*source.ClientID] }
   } else {
    · { data.T("transactions.client_unavailable") }
   }
  }
  if source.Note != "" {
   · { source.Note }
  }
 </a>
}
