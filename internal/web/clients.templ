package web

import "example.com/dynamis-code/apps-template/internal/web/components/actionattrs"
import "example.com/dynamis-code/apps-template/internal/transactions"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "strconv"
import "strings"

templ clientsPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, templates.DashboardHome) {
		@molecules.PageHeading(data.T("clients.title"), "")
		@clientList(data)
		if data.CanDeleteClients {
			@clientDeleteDialog(data)
		}
	}
}

// clientNewPage preserves the full-page create flow without JavaScript.
templ clientNewPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, templates.DashboardHome) {
		@molecules.BackLink(data.CurrentPath, data.T("clients.back"))
		@molecules.PageHeading(data.T("clients.new_client"), data.T("clients.title")) {
		}
		<div class="card p-5 mt-4" id="client-new-page">
			if data.ErrorKey != "" {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
			@clientCreateForm(data, data.CurrentPath+"/new", false)
		</div>
	}
}

templ clientDetailPage(data viewmodel.PageData) {	@templates.DashboardShell(data, templates.DashboardHome) {
		<div class="detail-split" data-detail-split>
		<div class="detail-main min-w-0" id="detail-main" data-detail-main>
		@molecules.BackLink(clientReturnHref(data.CurrentPath, data.ClientReturnQuery), data.T("clients.back"))
		<nav aria-label={ data.T("clients.title") }>
			@atoms.Breadcrumbs(atoms.BreadcrumbsProps{Items: []atoms.BreadcrumbsProp{
				{Label: data.T("clients.title"), Href: clientReturnHref(data.CurrentPath, data.ClientReturnQuery)},
				{Label: data.Client.DisplayName},
			}})
		</nav>
		<div class="relative">
			<div class="pr-12">
				@molecules.PageHeading(data.Client.DisplayName, "")
			</div>
			if data.CanEditClients || data.CanManageFields {
				{{ actionPath := data.CurrentPath + "/" + data.Client.ID.String(); actions := []organisms.ListAction{}; if data.CanManageFields { actions = append(actions, organisms.ListAction{Label: data.T("clients.fields_link"), Icon: "edit", Href: data.FieldsPath}) }; if data.CanEditClients { if data.Client.ArchivedAt == nil { actions = append(actions, organisms.ListAction{Label: data.T("clients.archive"), Icon: "archive", PostPath: actionPath + "/archive"}) } else { actions = append(actions, organisms.ListAction{Label: data.T("common.restore"), Icon: "unarchive", PostPath: actionPath + "/unarchive"}) }; if data.CanDeleteClients { actions = append(actions, organisms.ListAction{Label: data.T("clients.delete_client"), Icon: "delete", PostPath: actionPath + "/delete", Confirm: data.T("clients.delete_client_confirm"), Danger: true, ClientDeleteName: data.Client.DisplayName}) } } }}
				<div class="absolute right-0 top-0 z-20 [&_.list-action-items]:right-0">@organisms.ListActionsMenu(data, actions, true)</div>
			}
		</div>
		if data.Client.PossibleDuplicate {
			<div class="alert alert-warning my-4" role="status">{ data.T("clients.possible_duplicate") }</div>
		}
		<a class="link lg:hidden" href="#client-timeline-heading">{ data.T("clients.timeline_heading") }</a>
		@clientDetail(data)
		if data.CanReadClientTransactions {
			<section class="card my-4 p-6" aria-labelledby="client-transactions-heading">
				<h2 id="client-transactions-heading" class="text-xl font-bold">{ data.T("transactions.client_history") }</h2>
				<a class="link" href={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/transactions?client_id="+data.Client.ID.String()+"#transactions-entries-heading") }>{ data.T("transactions.view_client_entries") }</a>
				if len(data.ClientTransactions) == 0 {
					<p>{ data.T("transactions.history_empty") }</p>
				} else {
					<ul class="divide-y divide-base-300 my-3">
						for _, entry := range data.ClientTransactions {
							<li class="py-3">
								<div class="flex flex-wrap items-baseline justify-between gap-2">
									<div><time datetime={ entry.OccurredOn }>{ entry.OccurredOn }</time> · { data.T("transactions."+entry.Direction) }</div>
									<strong>{ transactions.FormatAmount(entry.AmountMinor, entry.Currency, data.Locale) }</strong>
								</div>
								<p>{ transactionsMethodLabel(data, entry.PaymentMethod, entry.PaymentMethodName) }
									if entry.CategoryID != nil {
										· { entry.CategoryName }
									}
								</p>
								if entry.Note != "" {
									<p class="break-words whitespace-pre-wrap">{ entry.Note }</p>
								}
								if entry.VoidedAt != "" {
									<p>{ data.T("transactions.voided_at") }: { transactionsVoidTime(entry.VoidedAt) }</p>
									<p class="break-words">{ data.T("transactions.void_reason") }: { entry.VoidReason }</p>
								}
							</li>
						}
					</ul>
				}
				<nav aria-label={ data.T("transactions.client_history") }>
					if data.ClientTransactionsPage > 1 {
						<a class="btn btn-sm" href={ templ.SafeURL(clientTransactionsPageURL(data, data.ClientTransactionsPage-1)) }>{ data.T("ui.previous_page") }</a>
					}
					if len(data.ClientTransactions) == 100 && data.ClientTransactionsPage < 1000000 {
						<a class="btn btn-sm" href={ templ.SafeURL(clientTransactionsPageURL(data, data.ClientTransactionsPage+1)) }>{ data.T("items.next_page") }</a>
					}
				</nav>
			</section>
		}
		if data.EngagementEnabled {
			<section class="card my-4 p-6" aria-labelledby="engagement-heading">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<h2 id="engagement-heading">{ data.T("engagement.title") }</h2>
					if data.CanEditClients && data.Client.ArchivedAt == nil {
						{{ createPath := "/workspaces/" + data.Workspace.ID.String() + "/engagements/new?client=" + data.Client.ID.String() + "&from_client=" + data.Client.ID.String() }}
						<a class="btn btn-primary" href={ templ.SafeURL(createPath) } hx-get={ createPath } hx-target="#engagement-create-modal" hx-swap="innerHTML" data-engagement-create>{ data.T("engagement.create") }</a>
					}
				</div>
				if data.CanEditClients && len(data.OpenEngagementStages) == 0 {
					<p>{ data.T("engagement.no_open_stage") }</p>
					if data.CanManageFields {
						<a class="btn btn-outline btn-sm" href={ "/workspaces/" + data.Workspace.ID.String() + "/engagement-stages" }>{ data.T("engagement.setup_stages") }</a>
					} else {
						<p>{ data.T("engagement.ask_admin") }</p>
					}
				}
				if strings.HasPrefix(data.ErrorKey, "engagement.invalid_") {
					{{ createData := data; createData.CurrentPath = "/workspaces/" + data.Workspace.ID.String() + "/engagements" }}
					@engagementNewContent(createData, nil, data.Client, data.OpenEngagementStages, "", "", "", false)
				}
				if len(data.Engagements) == 0 {
					<p>{ data.T("engagement.list_empty_unfiltered") }</p>
				} else {
					<ul class="detail-engagements my-4 space-y-2">
						for _, item := range data.Engagements {
							<li>
								<a class="card card-border group block p-4 text-base-content no-underline hover:bg-base-200 focus-visible:bg-base-200" href={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String()) }>
									<span class="block break-words font-semibold group-hover:underline group-focus-visible:underline">{ item.Name }</span>
									for _, stage := range data.EngagementStages {
										if stage.ID == item.StageID {
											<span class="mt-1 block break-words text-sm text-base-content">{ data.T("engagement.stage") }: { stage.Name }</span>
										}
									}
								</a>
							</li>
						}
					</ul>
				}
			</section>
			<div id="engagement-create-modal"></div>
		}
		</div>
		<div data-detail-divider role="separator" aria-orientation="vertical" aria-controls="detail-main" aria-label={ data.T("clients.resize_activity") } tabindex="-1" hidden></div>
		<div class="detail-sidebar min-w-0">
			<input class="range range-primary" data-detail-range type="range" min="320" max="1000" value="320" hidden aria-label={ data.T("clients.resize_main") }/>
		@clientTimeline(data)
		</div>
		</div>
	}
}

templ clientDetail(data viewmodel.PageData) {
	<section id="client-detail" class="client-panel card my-4 p-6" aria-labelledby="client-heading">
		<h2 id="client-heading" class="sr-only">{ data.T("clients.client") }</h2>
		if data.ErrorKey != "" && data.ClientInlineField == "" {
			if strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") {
				<div data-timeline-error-summary>
					@molecules.ErrorAlert(data.T(data.ErrorKey))
					<a class="btn btn-outline btn-sm" href="#timeline-text">{ data.T("clients.timeline_add") }</a>
				</div>
			} else {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
		}
		if !data.CanEditClients {
			<p class="status-line">{ data.T("clients.read_only") }</p>
		}
		<dl class="detail-values grid grid-cols-1 gap-y-1">
			<dt class="text-sm font-semibold">{ data.T("clients.display_name") }</dt><dd class="min-w-0 break-words">@clientInlineField(data, "display_name", data.T("clients.display_name"), data.Client.DisplayName, "text", "200", true)</dd>
			<dt class="mt-3 text-sm font-semibold">{ data.T("common.email") }</dt><dd class="min-w-0 break-words">@clientInlineField(data, "email", data.T("common.email"), data.Client.Email, "email", "254", false)</dd>
			<dt class="mt-3 text-sm font-semibold">{ data.T("clients.phone") }</dt><dd class="min-w-0 break-words">@clientInlineField(data, "phone", data.T("clients.phone"), data.Client.Phone, "tel", "50", false)</dd>
		</dl>
		@clientValues(data)
		<dl class="mt-6">
			<dt class="text-sm font-semibold">{ data.T("clients.notes") }</dt><dd class="break-words">
				if data.CanEditClients {
					{{ hasDraft := data.ClientInlineField == "notes"; conflict := hasDraft && data.ErrorKey == "clients.error_changed"; value := data.Client.Notes; version := strconv.FormatInt(data.Client.Version, 10); if hasDraft { value = data.ClientInlineValue; if !conflict { version = data.ClientInlineVersion } } }}
					@molecules.NotesEditor(molecules.NotesEditorProps{
						ID: "inline-notes", Name: "value", Label: data.T("clients.notes")+" "+data.T("ui.optional"),
						EditLabel: data.T("ui.edit"), SaveLabel: data.T("clients.value_save"), CancelLabel: data.T("common.cancel"), RetryLabel: data.T("ui.retry"),
						EmptyText: data.T("clients.value_none"), Saved: data.Client.Notes, Value: value,
						Action: data.CurrentPath + "/" + data.Client.ID.String() + "/field", CancelURL: data.CurrentPath + "/" + data.Client.ID.String() + "?cancel=1#client-detail",
						CSRF: data.CSRF, Version: version, Field: "notes", Error: data.T(data.ErrorKey), Warning: data.T("notes.source_warning"),
						BoldLabel: data.T("engagement.bold"), ItalicLabel: data.T("engagement.italic"), ListLabel: data.T("engagement.bulleted_list"), SourceLabel: data.T("notes.source"), MaxLength: "5000",
						LinkLabel: data.T("notes.link"), LinkURLLabel: data.T("notes.link_url"), LinkApplyLabel: data.T("notes.link_apply"), LinkCancelLabel: data.T("notes.link_cancel"), LinkInvalidLabel: data.T("notes.link_invalid"),
						Draft: hasDraft, FormDraft: hasDraft, Conflict: conflict, Empty: data.Client.Notes == "",
					})
				} else if data.Client.Notes == "" {
					<span class="status-line">{ data.T("clients.value_none") }</span>
				} else {
					<div class="engagement-markdown">@actionattrs.Markdown(data.Client.Notes)</div>
				}
			</dd>
		</dl>
		if data.CanEditClients && data.ClientEditRejected {
			<details data-detail-editor data-detail-discard-message={ data.T("ui.unsaved") } data-detail-dirty-on-load open>
				<summary class="btn btn-ghost btn-sm">{ data.T("ui.edit") } { data.T("clients.client") }</summary>
				<dialog open data-detail-dialog aria-labelledby="client-edit-dialog-title">
					<div class="modal-box">
						<h2 id="client-edit-dialog-title">{ data.T("ui.edit") } { data.T("clients.client") }</h2>
						@molecules.ErrorAlert(data.T(data.ErrorKey))
						<form action={ data.CurrentPath + "/" + data.Client.ID.String() } method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
							@molecules.TextField("client-display-name", data.T("clients.display_name"), templ.Attributes{
								"name": "display_name", "required": true, "maxlength": "200",
								"value": data.ClientDraft.DisplayName, "data-trim": "",
							})
							@molecules.TextField("client-email", data.T("common.email")+" "+data.T("ui.optional"), templ.Attributes{
								"name": "email", "type": "email", "maxlength": "254", "value": data.ClientDraft.Email,
							})
							@molecules.TextField("client-phone", data.T("clients.phone")+" "+data.T("ui.optional"), templ.Attributes{
								"name": "phone", "maxlength": "50", "value": data.ClientDraft.Phone,
							})
							@molecules.TextareaField("client-notes", data.T("clients.notes")+" "+data.T("ui.optional"), data.ClientDraft.Notes, templ.Attributes{
								"name": "notes", "maxlength": "5000",
							})
							<div class="modal-action">
								<a class="btn" href={ data.CurrentPath + "/" + data.Client.ID.String() } data-detail-fallback-cancel>{ data.T("common.cancel") }</a>
								<button type="button" class="btn" data-detail-cancel hidden>{ data.T("common.cancel") }</button>
								@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.save"), Attrs: templ.Attributes{"type": "submit"}})
							</div>
						</form>
					</div>
				</dialog>
			</details>
		}
		if data.Client.ArchivedAt != nil {
			@molecules.StatusLine(data.T("clients.archived_status"), nil)
		}
	</section>
		if data.CanDeleteClients {
			@clientDeleteDialog(data)
		}
}

templ clientInlineField(data viewmodel.PageData, field, label, saved, inputType, maxLength string, required bool) {
	if data.CanEditClients {
		{{ hasDraft := data.ClientInlineField == field; conflict := hasDraft && data.ErrorKey == "clients.error_changed"; value := saved; version := strconv.FormatInt(data.Client.Version, 10); inputLabel := label; if !required { inputLabel += " " + data.T("ui.optional") }; if hasDraft { value = data.ClientInlineValue; if !conflict { version = data.ClientInlineVersion } } }}
		@molecules.InlineEditor(molecules.InlineEditorProps{
			Saved: saved, Display: saved, Empty: saved == "", EmptyText: data.T("clients.value_none"), Value: value,
			Label: label, InputLabel: inputLabel, EditLabel: data.T("ui.edit"), SaveLabel: data.T("clients.value_save"), CancelLabel: data.T("common.cancel"),
			ID: "inline-" + field, Name: "value", InputType: inputType, MaxLength: maxLength, Required: required,
			Action: data.CurrentPath + "/" + data.Client.ID.String() + "/field", CancelURL: data.CurrentPath + "/" + data.Client.ID.String() + "?cancel=1#client-detail",
			CSRF: data.CSRF, Version: version, Field: field, Draft: hasDraft, FormDraft: hasDraft, Conflict: conflict,
			Error: data.T(data.ErrorKey), RetryLabel: data.T("ui.retry"), Class: "min-w-0",
		})
	} else {
		if saved == "" {
			<span class="status-line">{ data.T("clients.value_none") }</span>
		} else {
			{ saved }
		}
	}
}

templ clientTimeline(data viewmodel.PageData) {
	<section class="client-timeline card my-4 p-6" aria-labelledby="client-timeline-heading">
		<div class="flex flex-wrap justify-between items-center gap-4 mb-6">
			<h2 id="client-timeline-heading" class="text-xl font-bold">{ data.T("clients.timeline_heading") }</h2>
			if data.CanEditClients {
				<button type="button" class="btn btn-primary" data-timeline-open hidden>{ data.T("clients.timeline_add") }</button>
			}
		</div>
		if len(data.ClientTimeline) == 0 {
			<p>{ data.T("clients.timeline_empty") }</p>
		}
		<ol class="timeline timeline-vertical timeline-compact timeline-snap-icon">
			for _, entry := range data.ClientTimeline {
				<li id={ "timeline-" + entry.ID.String() }>
					<div class="timeline-middle"><span class="block w-3 h-3 rounded-full bg-primary" aria-hidden="true"></span></div>
					<div class="timeline-end w-full py-4">
						<div class="flex gap-2 items-center flex-wrap">
							<strong class="badge badge-soft badge-primary">{ data.T("clients.timeline_type_" + entry.Type) }</strong>
							if entry.Channel != "" {
								<span class="text-sm">{ data.T("clients.timeline_channel_" + entry.Channel) }</span>
							}
							<time class="text-sm" datetime={ entry.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ entry.CreatedAt.Format("2006-01-02 15:04:05 UTC") }</time>
						</div>
						<p class="my-2 whitespace-pre-wrap">{ entry.Text }</p>
						if entry.CorrectsID != nil {
							<p class="text-sm">{ data.T("clients.timeline_corrects") }:
								if timelineContains(data.ClientTimeline, *entry.CorrectsID) {
									<a class="rounded-field border border-base-300 px-1" href={ "#timeline-" + entry.CorrectsID.String() }>{ entry.CorrectsID.String() }</a>
								} else {
									{ entry.CorrectsID.String() }
								}
							</p>
						}
						<p class="text-sm">{ data.T("clients.timeline_author") }:
							if entry.AuthorID != nil {
								{ entry.AuthorID.String() }
							} else {
								{ data.T("clients.timeline_deleted_author") }
							}
						</p>
					</div>
					<hr/>
				</li>
			}
		</ol>
		<nav aria-label={ data.T("clients.timeline_heading") }>
			if data.TimelinePage > 1 {
				<a class="btn btn-sm" href={ "?timeline_page=" + strconv.Itoa(data.TimelinePage-1) + "#client-timeline-heading" }>{ data.T("ui.previous_page") }</a>
			}
			if len(data.ClientTimeline) == 50 && data.TimelinePage < 1000000 {
				<a class="btn btn-sm" href={ "?timeline_page=" + strconv.Itoa(data.TimelinePage+1) + "#client-timeline-heading" }>{ data.T("items.next_page") }</a>
			}
		</nav>
		if data.CanEditClients {
			<div data-timeline-composer data-timeline-invalid?={ strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") }>
				<h3 id="timeline-form-heading" class="text-xl font-bold">{ data.T("clients.timeline_add") }</h3>
				<p class="text-sm">{ data.Client.DisplayName }</p>
				if strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") {
					@molecules.ErrorAlert(data.T(data.ErrorKey))
				}
				<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/timeline?timeline_page=" + strconv.Itoa(data.TimelinePage) } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Textarea(atoms.TextareaProps{ID:"timeline-text", Name:"text", Label:data.T("clients.timeline_text"), Value:data.TimelineDraft.Text, Required:true, Class:"w-full min-h-32"})
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						@atoms.Select(atoms.SelectProps{ID:"timeline-type", Name:"type", Label:data.T("clients.timeline_type"), Options:timelineOptions(data, "type", data.TimelineDraft.Type, []string{"note", "call", "visit", "document", "update", "change", "delay"})})
						@atoms.Select(atoms.SelectProps{ID:"timeline-channel", Name:"channel", Label:data.T("clients.timeline_channel") + " " + data.T("ui.optional"), Options:timelineOptions(data, "channel", data.TimelineDraft.Channel, []string{"", "phone", "whatsapp", "email", "in_person", "other"})})
					</div>
					<details class="collapse collapse-arrow bg-base-200 mt-3" open?={ data.TimelineDraft.Corrects != "" }>
						<summary class="collapse-title font-semibold">{ data.T("clients.timeline_corrects") } { data.T("ui.optional") }</summary>
						<div class="collapse-content">
							<label for="timeline-corrects">{ data.T("clients.timeline_corrects") } { data.T("ui.optional") }</label>
							<select id="timeline-corrects" name="corrects" class="select w-full">
								<option value="">{ data.T("clients.timeline_none") }</option>
								if data.TimelineDraft.Corrects != "" && !timelineHasDraftCorrection(data.ClientTimeline, data.TimelineDraft.Corrects) {
									<option value={ data.TimelineDraft.Corrects } selected>{ data.TimelineDraft.Corrects }</option>
								}
								for _, entry := range data.ClientTimeline {
									<option value={ entry.ID.String() } selected?={ data.TimelineDraft.Corrects == entry.ID.String() }>{ entry.ID.String() } — { entry.Text }</option>
								}
							</select>
						</div>
					</details>
					<div class="modal-action">
						<button type="button" class="btn" data-timeline-close hidden>{ data.T("common.cancel") }</button>
						@atoms.Button(atoms.ButtonProps{Class:"btn-primary", Label:data.T("clients.timeline_add"), Attrs:templ.Attributes{"type":"submit"}})
					</div>
				</form>
			</div>
			<dialog class="modal" aria-labelledby="timeline-form-heading" data-timeline-dialog><div class="modal-box max-w-xl" data-timeline-modal-content></div></dialog>
		}
	</section>
}

templ clientValues(data viewmodel.PageData) {
	<div id="client-values">
		if len(data.ClientValues) > 0 {
			<dl class="detail-values mt-6 grid grid-cols-1 gap-y-1">
				for _, value := range data.ClientValues {
					<dt class="mt-3 text-sm font-semibold">{ value.Label }</dt>
					<dd class="min-w-0 break-words">
						if data.CanEditClients {
							if value.Type == "yes_no" || value.Type == "single_choice" {
								@clientValueEditor(data, value)
							} else {
								@clientTextValue(data, value)
							}
						} else if value.Value == nil {
							<span class="status-line">{ data.T("clients.value_none") }</span>
						} else {
							{ clientValueDisplay(data, value) }
						}
					</dd>
				}
			</dl>
		}
		if data.CanManageFields {
			<a class="btn btn-outline btn-sm mt-4" href={ data.FieldsPath }>{ data.T("clients.add_field") }</a>
		}
	</div>
}

templ clientTextValue(data viewmodel.PageData, value viewmodel.ClientValueRow) {
	{{ version := strconv.FormatInt(data.Client.Version, 10); hasDraft := data.ClientValueDraftField == value.FieldID.String(); saved := clientValueDisplayValue(value.Value); inputValue := saved; inputType := value.Type; if inputType != "number" && inputType != "date" { inputType = "text" }; action := data.CurrentPath + "/" + data.Client.ID.String() + "/values/" + value.FieldID.String(); clearURL := ""; if value.Value != nil { clearURL = action + "/clear" }; if hasDraft { inputValue = data.ClientValueDraft; inputType = "text" } }}
	<div class="client-value min-w-0">
		if hasDraft {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		@molecules.InlineEditor(molecules.InlineEditorProps{
			Saved: saved, Display: clientValueDisplay(data, value), Empty: value.Value == nil, EmptyText: data.T("clients.value_none"), Value: inputValue,
			Label: value.Label, InputLabel: value.Label + " " + data.T("ui.optional"), EditLabel: data.T("ui.edit"), SaveLabel: data.T("clients.value_save"), CancelLabel: data.T("common.cancel"),
			ID: "value-" + value.FieldID.String(), Name: "value", InputType: inputType, MaxLength: "500",
			Action: action, CancelURL: data.CurrentPath + "/" + data.Client.ID.String() + "?cancel=1#client-values", ClearURL: clearURL, ClearLabel: data.T("clients.value_clear"),
			CSRF: data.CSRF, Version: version, Draft: hasDraft, FormDraft: hasDraft, Class: "min-w-0",
		})
	</div>
}

templ clientValueEditor(data viewmodel.PageData, value viewmodel.ClientValueRow) {
	{{ hasDraft := data.ClientValueDraftField == value.FieldID.String(); inputValue := clientValueDisplayValue(value.Value); if hasDraft { inputValue = data.ClientValueDraft } }}
	if hasDraft {
		@molecules.ErrorAlert(data.T(data.ErrorKey))
	}
	<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/values/" + value.FieldID.String() } method="post" data-confirm-select?={ value.Type == "yes_no" || value.Type == "single_choice" } data-dirty-track data-unsaved-warning data-dirty-on-load?={ hasDraft }>
		<input type="hidden" name="csrf" value={ data.CSRF }/>
		<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
		@atoms.Label(atoms.LabelProps{Class: "sr-only", For: "value-" + value.FieldID.String(), Text: value.Label + " " + data.T("ui.optional")})
		if value.Type == "yes_no" || value.Type == "single_choice" {
			<select class="select w-full" id={ "value-" + value.FieldID.String() } name="value">
				if hasDraft {
					<option value={ inputValue } selected>{ inputValue }</option>
				}
				if value.Type == "yes_no" {
					for _, option := range clientValueYesNoOptions(data, value) {
						<option value={ option.Value } disabled?={ option.Disabled } selected?={ !hasDraft && option.Selected }>{ option.Label }</option>
					}
				} else {
					for _, option := range clientValueChoiceOptions(data, value) {
						<option value={ option.Value } disabled?={ option.Disabled } selected?={ !hasDraft && option.Selected }>{ option.Label }</option>
					}
				}
			</select>
		} else if value.Type == "number" && !hasDraft {
			@atoms.PlainInput(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", Type: "number", Step: "any", Value: inputValue})
		} else if value.Type == "date" && !hasDraft {
			@atoms.PlainInput(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", Type: "date", Value: inputValue})
		} else {
			@atoms.PlainInput(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", MaxLength: "500", Value: inputValue})
		}
		<div class="actions" data-confirm-select-fallback>
			<a class="btn" href={ data.CurrentPath + "/" + data.Client.ID.String() + "?cancel=1#client-values" }>{ data.T("common.cancel") }</a>
			@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.value_save"), Attrs: templ.Attributes{"type": "submit"}})
		</div>
		if value.Type == "yes_no" || value.Type == "single_choice" {
			@confirmSelectDialog(data, value.Label)
		}
	</form>
	if value.Value != nil {
		<form class="client-value-clear mt-2" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/values/" + value.FieldID.String() + "/clear" } method="post">
			<input type="hidden" name="csrf" value={ data.CSRF }/>
			<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
			@atoms.Button(atoms.ButtonProps{Class: "btn-outline", Label: data.T("clients.value_clear"), Attrs: templ.Attributes{"type": "submit"}})
		</form>
	}
}

templ confirmSelectDialog(data viewmodel.PageData, field string) {
	<dialog class="modal" aria-label={ data.T("ui.confirm_change") } data-confirm-select-dialog>
		<div class="modal-box">
			<h2>{ data.T("ui.confirm_change") }</h2>
			<p>{ field }: <strong data-confirm-select-value></strong></p>
			<div class="modal-action">
				<button type="button" class="btn" data-confirm-select-cancel>{ data.T("common.cancel") }</button>
				<button type="button" class="btn btn-primary" data-confirm-select-accept>{ data.T("ui.confirm") }</button>
			</div>
		</div>
	</dialog>
}

