package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "strconv"
import "strings"

templ clientsPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@clientList(data)
	}
}

// clientNewPage is the create page. The form is the whole page, so the list
// never loads four fields it does not need and a phone gets a full-width form.
templ clientNewPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.T("clients.new_client"), data.T("clients.title")) {
			<div class="actions client-page-actions">
				<a class="btn btn-ghost" href={ data.CurrentPath }>{ data.T("clients.back") }</a>
			</div>
		}
		<div class="card p-5 mt-4" id="client-new-page">
			if data.ErrorKey != "" {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
			@clientCreateForm(data, data.CurrentPath+"/new")
		</div>
	}
}

templ clientDetailPage(data viewmodel.PageData) {	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.Client.DisplayName, data.T("clients.title")) {
			<div class="actions client-page-actions">
				<a class="btn btn-ghost" href={ data.CurrentPath }>{ data.T("clients.back") }</a>
				if data.CanManageFields {
					<a class="btn btn-ghost" href={ data.FieldsPath }>{ data.T("clients.fields_link") }</a>
				}
			</div>
		}
		@clientDetail(data)
		if data.EngagementEnabled {
			<section class="card my-4 p-6" aria-labelledby="engagement-heading">
				<h2 id="engagement-heading">{ data.T("engagement.title") }</h2>
				if data.CanEditClients {
					if len(data.OpenEngagementStages) == 0 {
						<p>{ data.T("engagement.no_open_stage") }</p>
						if data.CanManageFields {
							<a class="link" href={ "/workspaces/" + data.Workspace.ID.String() + "/engagement-stages" }>{ data.T("engagement.setup_stages") }</a>
						} else {
							<p>{ data.T("engagement.ask_admin") }</p>
						}
					} else {
						<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements" } method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							@molecules.TextField("engagement-name", data.T("engagement.name"), templ.Attributes{"name": "name", "value": data.EngagementName, "required": true, "maxlength": "200"})
							<label for="engagement-stage">{ data.T("engagement.stage") }</label>
							<select id="engagement-stage" name="stage" class="select select-bordered" required>
								<option value="">{ data.T("engagement.select_stage") }</option>
								for _, stage := range data.OpenEngagementStages {
									<option value={ stage.ID.String() } selected?={ stage.ID.String() == data.EngagementStage }>{ stage.Name }</option>
								}
							</select>
							<label for="engagement-notes">{ data.T("engagement.notes") }</label>
							<textarea id="engagement-notes" name="notes" maxlength="5000" class="textarea textarea-bordered">{ data.EngagementNotes }</textarea>
							<button class="btn btn-primary" type="submit">{ data.T("engagement.create") }</button>
						</form>
					}
				}
				<ul>
					for _, item := range data.Engagements {
						<li>
							<a class="link" href={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() }>{ item.Name }</a>
							for _, stage := range data.EngagementStages {
								if stage.ID == item.StageID {
									<span>{ stage.Name }</span>
								}
							}
							<p>{ item.Notes }</p>
							if data.CanEditClients {
								<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/stage" } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<label for={ "stage-" + item.ID.String() }>{ data.T("engagement.move") }</label>
									<select id={ "stage-" + item.ID.String() } name="stage" class="select select-bordered">
										for _, stage := range data.EngagementStages {
											if !stage.Archived {
												<option value={ stage.ID.String() } selected?={ stage.ID == item.StageID }>{ stage.Name }</option>
											}
										}
									</select>
									<button class="btn btn-secondary" type="submit">{ data.T("engagement.move") }</button>
								</form>
							}
							<ol data-engagement-history>
								for _, entry := range item.History {
									<li>
										for _, stage := range data.EngagementStages {
											if stage.ID == entry.FromStageID {
											<span>{ stage.Name }</span>
										}
									}
										<span> → </span>
										for _, stage := range data.EngagementStages {
											if stage.ID == entry.ToStageID {
											<span>{ stage.Name }</span>
										}
									}
										<span> — { entry.ActorUserID.String() } — { entry.CreatedAt }</span>
									</li>
								}
							</ol>
							for _, member := range data.EngagementMembers {
								if member.UserID == item.AssigneeID {
									<p>{ data.T("engagement.assignee") }: { member.Email }</p>
								}
							}
							if data.CanEditClients {
								<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/assignee" } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<label for={ "assignee-" + item.ID.String() }>{ data.T("engagement.assignee") }</label>
									<select class="select select-bordered" id={ "assignee-" + item.ID.String() } name="assignee_id"><option value="">—</option>
										for _, member := range data.EngagementMembers {
											<option value={ member.UserID.String() } selected?={ member.UserID == item.AssigneeID }>{ member.Email }</option>
										}
									</select>
									<button class="btn btn-primary" type="submit">{ data.T("engagement.save_assignee") }</button>
								</form>
							}
							<p>{ data.T("engagement.agreement") }:
								if item.Agreement.Recorded {
									<span>{ data.T("engagement.agreement_recorded") }</span>
								} else {
									<span>{ data.T("engagement.agreement_not_recorded") }</span>
								}
								{ item.Agreement.FileID }
							</p>
							if data.CanEditClients {
								<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/agreement" } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<label><input class="checkbox" type="checkbox" name="recorded" value="1" checked?={ item.Agreement.Recorded }/> { data.T("engagement.agreement_recorded") }</label>
									if data.FilesEnabled {
										<label for={ "agreement-file-" + item.ID.String() }>{ data.T("engagement.agreement_file") }</label>
										<input class="input input-bordered" id={ "agreement-file-" + item.ID.String() } name="file_id" value={ item.Agreement.FileID }/>
									}
									<button class="btn btn-primary" type="submit">{ data.T("engagement.agreement_save") }</button>
								</form>
							}
							<p>{ data.T("engagement.quote") }: { data.T("engagement.quote_" + item.Quote.Status) } { item.Quote.Amount } { item.Quote.DateSent }</p>
							if data.CanEditClients {
								<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/quote" } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<label for={ "quote-status-" + item.ID.String() }>{ data.T("engagement.quote") }</label>
									<select class="select select-bordered" id={ "quote-status-" + item.ID.String() } name="status">
										for _, status := range []string{"not_sent", "sent", "pending", "accepted", "declined"} {
											<option value={ status } selected?={ item.Quote.Status == status }>{ data.T("engagement.quote_" + status) }</option>
										}
									</select>
									<label for={ "quote-amount-" + item.ID.String() }>{ data.T("engagement.quote_amount") }</label>
									<input class="input input-bordered" type="number" min="0" max="999999999999.99" step="0.01" id={ "quote-amount-" + item.ID.String() } name="amount" value={ item.Quote.Amount }/>
									<label for={ "quote-date-" + item.ID.String() }>{ data.T("engagement.quote_date") }</label>
									<input class="input input-bordered" type="date" id={ "quote-date-" + item.ID.String() } name="date_sent" value={ item.Quote.DateSent }/>
									<button class="btn btn-primary" type="submit">{ data.T("engagement.quote_save") }</button>
								</form>
							}
							if item.NextAction.Text != "" {
								<p>{ data.T("engagement.next_action") }: { item.NextAction.Text } { item.NextAction.DueDate }</p>
								for _, member := range data.EngagementMembers {
									if member.UserID == item.NextAction.OwnerID {
										<p>{ data.T("engagement.owner") }: { member.Email }</p>
									}
								}
							}
							if data.CanEditClients {
								<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/next-action" } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<label for={ "action-" + item.ID.String() }>{ data.T("engagement.next_action") }</label>
									<input class="input input-bordered" id={ "action-" + item.ID.String() } name="text" maxlength="5000" value={ item.NextAction.Text }/>
									<label for={ "due-" + item.ID.String() }>{ data.T("engagement.due_date") }</label>
									<input class="input input-bordered" type="date" id={ "due-" + item.ID.String() } name="due_date" value={ item.NextAction.DueDate }/>
									<label for={ "owner-" + item.ID.String() }>{ data.T("engagement.owner") }</label>
									<select class="select select-bordered" id={ "owner-" + item.ID.String() } name="owner_id"><option value="">—</option>
										for _, member := range data.EngagementMembers {
											<option value={ member.UserID.String() } selected?={ member.UserID == item.NextAction.OwnerID }>{ member.Email }</option>
										}
									</select>
									<button class="btn btn-primary" type="submit">{ data.T("engagement.save_action") }</button>
									if item.NextAction.Text != "" {
										<button class="btn btn-ghost" type="submit" name="clear" value="1">{ data.T("engagement.clear_action") }</button>
									}
								</form>
							}
						</li>
					}
				</ul>
			</section>
		}
	}
}

templ clientDetail(data viewmodel.PageData) {
	<section id="client-detail" class="client-panel card my-4 p-6" aria-labelledby="client-heading">
		<h2 id="client-heading" class="sr-only">{ data.T("clients.client") }</h2>
		if data.ErrorKey != "" {
			if strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") {
				<div data-timeline-error-summary>
					@molecules.ErrorAlert(data.T(data.ErrorKey))
					<a class="link" href="#timeline-text">{ data.T("clients.timeline_add") }</a>
				</div>
			} else {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
		}
		if data.CanEditClients {
			<form action={ data.CurrentPath + "/" + data.Client.ID.String() } method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
				@molecules.TextField("client-display-name", data.T("clients.display_name"), templ.Attributes{
					"name": "display_name", "required": true, "maxlength": "200",
					"value": data.Client.DisplayName, "data-trim": "",
				})
				@molecules.TextField("client-email", data.T("common.email")+" "+data.T("ui.optional"), templ.Attributes{
					"name": "email", "type": "email", "maxlength": "254", "value": data.Client.Email,
				})
				@molecules.TextField("client-phone", data.T("clients.phone")+" "+data.T("ui.optional"), templ.Attributes{
					"name": "phone", "maxlength": "50", "value": data.Client.Phone,
				})
				@molecules.TextareaField("client-notes", data.T("clients.notes")+" "+data.T("ui.optional"), data.Client.Notes, templ.Attributes{
					"name": "notes", "maxlength": "5000",
				})
				<div class="actions">
					@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.save"), Attrs: templ.Attributes{"type": "submit"}})
				</div>
			</form>
		} else {
			<p class="status-line">{ data.T("clients.read_only") }</p>
			<dl>
				<dt>{ data.T("clients.display_name") }</dt><dd>{ data.Client.DisplayName }</dd>
				<dt>{ data.T("common.email") }</dt><dd>{ data.Client.Email }</dd>
				<dt>{ data.T("clients.phone") }</dt><dd>{ data.Client.Phone }</dd>
				<dt>{ data.T("clients.notes") }</dt><dd>{ data.Client.Notes }</dd>
			</dl>
		}
		if data.Client.ArchivedAt != nil {
			@molecules.StatusLine(data.T("clients.archived_status"), nil)
		}
		if data.CanEditClients {
			<div class="client-lifecycle">
				if data.Client.ArchivedAt != nil {
					<form method="post" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/unarchive" }>
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@atoms.Button(atoms.ButtonProps{Class: "btn-secondary", Label: data.T("clients.unarchive"), Attrs: templ.Attributes{"type": "submit"}})
					</form>
				} else {
					<form method="post" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/archive" }>
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@atoms.Button(atoms.ButtonProps{Class: "btn-secondary", Label: data.T("clients.archive"), Attrs: templ.Attributes{"type": "submit"}})
					</form>
				}
				if data.CanDeleteClients {
					<div class="client-delete">
						<p class="warning alert alert-warning py-2">{ data.T("clients.delete_client_confirm") }</p>
						<form method="post" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/delete" }>
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							@atoms.Button(atoms.ButtonProps{Class: "btn-error", Label: data.T("clients.delete_client"), Attrs: templ.Attributes{"type": "submit", "data-confirm": data.T("clients.delete_client_confirm")}})
						</form>
					</div>
				}
			</div>
		}
		@clientValues(data)
		@clientTimeline(data)
	</section>
}

templ clientTimeline(data viewmodel.PageData) {
	<section class="client-timeline card my-4 p-6" aria-labelledby="client-timeline-heading">
		<div class="flex flex-wrap justify-between items-center gap-4 mb-6">
			<h2 id="client-timeline-heading" class="text-xl font-bold">{ data.T("clients.timeline_heading") }</h2>
			if data.CanEditClients {
				<button type="button" class="btn btn-primary" data-timeline-open hidden>{ data.T("clients.timeline_add") }</button>
			}
		</div>
		if len(data.ClientTimeline) == 0 {
			<p>{ data.T("clients.timeline_empty") }</p>
		}
		<ol class="timeline timeline-vertical timeline-compact timeline-snap-icon">
			for _, entry := range data.ClientTimeline {
				<li id={ "timeline-" + entry.ID.String() }>
					<div class="timeline-middle"><span class="block w-3 h-3 rounded-full bg-primary" aria-hidden="true"></span></div>
					<div class="timeline-end w-full py-4">
						<div class="flex gap-2 items-center flex-wrap">
							<strong class="badge badge-soft badge-primary">{ data.T("clients.timeline_type_" + entry.Type) }</strong>
							if entry.Channel != "" {
								<span class="text-sm">{ data.T("clients.timeline_channel_" + entry.Channel) }</span>
							}
							<time class="text-sm" datetime={ entry.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ entry.CreatedAt.Format("2006-01-02 15:04:05 UTC") }</time>
						</div>
						<p class="my-2 whitespace-pre-wrap">{ entry.Text }</p>
						if entry.CorrectsID != nil {
							<p class="text-sm">{ data.T("clients.timeline_corrects") }:
								if timelineContains(data.ClientTimeline, *entry.CorrectsID) {
									<a class="link" href={ "#timeline-" + entry.CorrectsID.String() }>{ entry.CorrectsID.String() }</a>
								} else {
									{ entry.CorrectsID.String() }
								}
							</p>
						}
						<p class="text-sm">{ data.T("clients.timeline_author") }:
							if entry.AuthorID != nil {
								{ entry.AuthorID.String() }
							} else {
								{ data.T("clients.timeline_deleted_author") }
							}
						</p>
					</div>
					<hr/>
				</li>
			}
		</ol>
		<nav aria-label={ data.T("clients.timeline_heading") }>
			if data.TimelinePage > 1 {
				<a href={ "?timeline_page=" + strconv.Itoa(data.TimelinePage-1) + "#client-timeline-heading" }>{ data.T("ui.previous_page") }</a>
			}
			if len(data.ClientTimeline) == 50 && data.TimelinePage < 1000000 {
				<a href={ "?timeline_page=" + strconv.Itoa(data.TimelinePage+1) + "#client-timeline-heading" }>{ data.T("items.next_page") }</a>
			}
		</nav>
		if data.CanEditClients {
			<div data-timeline-composer data-timeline-invalid?={ strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") }>
				<h3 id="timeline-form-heading" class="text-xl font-bold">{ data.T("clients.timeline_add") }</h3>
				<p class="text-sm">{ data.Client.DisplayName }</p>
				if strings.HasPrefix(data.ErrorKey, "clients.timeline_error_") {
					@molecules.ErrorAlert(data.T(data.ErrorKey))
				}
				<form action={ data.CurrentPath + "/" + data.Client.ID.String() + "/timeline?timeline_page=" + strconv.Itoa(data.TimelinePage) } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Textarea(atoms.TextareaProps{ID:"timeline-text", Name:"text", Label:data.T("clients.timeline_text"), Value:data.TimelineDraft.Text, Required:true, Class:"w-full min-h-32"})
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						@atoms.Select(atoms.SelectProps{ID:"timeline-type", Name:"type", Label:data.T("clients.timeline_type"), Options:timelineOptions(data, "type", data.TimelineDraft.Type, []string{"note", "call", "visit", "document", "update", "change", "delay"})})
						@atoms.Select(atoms.SelectProps{ID:"timeline-channel", Name:"channel", Label:data.T("clients.timeline_channel") + " " + data.T("ui.optional"), Options:timelineOptions(data, "channel", data.TimelineDraft.Channel, []string{"", "phone", "whatsapp", "email", "in_person", "other"})})
					</div>
					<details class="collapse collapse-arrow bg-base-200 mt-3" open?={ data.TimelineDraft.Corrects != "" }>
						<summary class="collapse-title font-semibold">{ data.T("clients.timeline_corrects") } { data.T("ui.optional") }</summary>
						<div class="collapse-content">
							<label for="timeline-corrects">{ data.T("clients.timeline_corrects") } { data.T("ui.optional") }</label>
							<select id="timeline-corrects" name="corrects" class="select w-full">
								<option value="">{ data.T("clients.timeline_none") }</option>
								if data.TimelineDraft.Corrects != "" && !timelineHasDraftCorrection(data.ClientTimeline, data.TimelineDraft.Corrects) {
									<option value={ data.TimelineDraft.Corrects } selected>{ data.TimelineDraft.Corrects }</option>
								}
								for _, entry := range data.ClientTimeline {
									<option value={ entry.ID.String() } selected?={ data.TimelineDraft.Corrects == entry.ID.String() }>{ entry.ID.String() } — { entry.Text }</option>
								}
							</select>
						</div>
					</details>
					<div class="modal-action">
						<button type="button" class="btn" data-timeline-close hidden>{ data.T("common.cancel") }</button>
						@atoms.Button(atoms.ButtonProps{Class:"btn-primary", Label:data.T("clients.timeline_add"), Attrs:templ.Attributes{"type":"submit"}})
					</div>
				</form>
			</div>
			<dialog class="modal" aria-labelledby="timeline-form-heading" data-timeline-dialog><div class="modal-box max-w-xl" data-timeline-modal-content></div></dialog>
		}
	</section>
}

templ clientValues(data viewmodel.PageData) {
	<section id="client-values" class="client-panel card my-4 p-6 client-values" aria-labelledby="client-values-heading">
		<h2 id="client-values-heading">{ data.T("clients.values_heading") }</h2>
		if len(data.ClientValues) > 0 {
			for _, value := range data.ClientValues {
				if data.CanEditClients {
					<form class="client-value card card-compact p-4 bg-base-200" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/values/" + value.FieldID.String() } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
						@atoms.Label(atoms.LabelProps{For: "value-" + value.FieldID.String(), Text: value.Label + " " + data.T("ui.optional")})
						if value.Type == "number" {
							@atoms.Input(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", Type: "number", Step: "any", Value: clientValueDisplayValue(value.Value)})
						} else if value.Type == "date" {
							@atoms.Input(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", Type: "date", Value: clientValueDisplayValue(value.Value)})
						} else if value.Type == "yes_no" {
							@atoms.Select(atoms.SelectProps{ID: "value-" + value.FieldID.String(), Name: "value", Options: clientValueYesNoOptions(data, value)})
						} else if value.Type == "single_choice" {
							@atoms.Select(atoms.SelectProps{ID: "value-" + value.FieldID.String(), Name: "value", Options: clientValueChoiceOptions(data, value)})
						} else {
							@atoms.Input(atoms.InputProps{ID: "value-" + value.FieldID.String(), Name: "value", MaxLength: "500", Value: clientValueDisplayValue(value.Value)})
						}
						<div class="actions">
							@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("clients.value_save"), Attrs: templ.Attributes{"type": "submit"}})
						</div>
					</form>
					if value.Value != nil {
						<form class="client-value-clear card card-compact mt-2 p-4 bg-base-200" action={ data.CurrentPath + "/" + data.Client.ID.String() + "/values/" + value.FieldID.String() + "/clear" } method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							<input type="hidden" name="version" value={ strconv.FormatInt(data.Client.Version, 10) }/>
							@atoms.Button(atoms.ButtonProps{Class: "btn-ghost", Label: data.T("clients.value_clear"), Attrs: templ.Attributes{"type": "submit"}})
						</form>
					}
				} else {
					<dl>
						<dt>{ value.Label }</dt>
						<dd>{ clientValueDisplay(data, value) }</dd>
					</dl>
				}
			}
		} else {
			<p class="status-line">{ data.T("clients.values_none") }</p>
		}
	</section>
}

