package web

import "example.com/dynamis-code/apps-template/internal/engagement"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

templ engagementDetailPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		for _, item := range data.Engagements {
			@molecules.PageHeading(item.Name, data.Client.DisplayName) {}
			<a class="link" href={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String()) }>{ data.Client.DisplayName }</a>
			<section class="card my-4 p-6">
				if data.CanEditClients {
					if data.ErrorKey != "" {
						@molecules.ErrorAlert(data.T(data.ErrorKey))
					}
					<form action={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/name") } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.TextField("engagement-name", data.T("engagement.name"), templ.Attributes{"name": "name", "value": item.Name, "required": true, "maxlength": "200"})
						@molecules.SubmitButton(data.T("engagement.save_name"), nil)
						<a class="btn btn-ghost" href={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String()) }>{ data.T("engagement.cancel") }</a>
					</form>
				}
				for _, stage := range data.EngagementStages {
					if stage.ID == item.StageID {
						<p>{ data.T("engagement.stage") }: { stage.Name }</p>
					}
				}
				if data.CanEditClients {
					<form action={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String() + "/stage") } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<input type="hidden" name="return_to" value="detail"/>
						<label for="engagement-stage">{ data.T("engagement.move") }</label>
						<select id="engagement-stage" name="stage" class="select select-bordered" required>
							<option value="">{ data.T("engagement.select_stage") }</option>
							for _, stage := range data.EngagementStages {
								if !stage.Archived {
									<option value={ stage.ID.String() } selected?={ stage.ID == item.StageID }>{ stage.Name }</option>
								}
							}
						</select>
						@molecules.SubmitButton(data.T("engagement.save_name"), nil)
						<a class="btn btn-ghost" href={ templ.SafeURL(data.CurrentPath + "/" + data.Client.ID.String() + "/engagements/" + item.ID.String()) }>{ data.T("engagement.cancel") }</a>
					</form>
				}
				<p>{ data.T("engagement.notes") }: { item.Notes }</p>
				for _, member := range data.EngagementMembers {
					if member.UserID == item.AssigneeID {
						<p>{ data.T("engagement.assignee") }: { member.Email }</p>
					}
				}
				<p>{ data.T("engagement.agreement") }:
					if item.Agreement.Recorded {
						<span>{ data.T("engagement.agreement_recorded") }</span>
					} else {
						<span>{ data.T("engagement.agreement_not_recorded") }</span>
					}
					{ item.Agreement.FileID }
				</p>
				<p>{ data.T("engagement.quote") }: { data.T("engagement.quote_" + item.Quote.Status) } { item.Quote.Amount } { item.Quote.DateSent }</p>
				<p>{ data.T("engagement.next_action") }: { item.NextAction.Text } { item.NextAction.DueDate }</p>
				for _, member := range data.EngagementMembers {
					if member.UserID == item.NextAction.OwnerID {
						<p>{ data.T("engagement.owner") }: { member.Email }</p>
					}
				}
				<ol data-engagement-history>
					for _, entry := range item.History {
						<li>
							for _, stage := range data.EngagementStages {
								if stage.ID == entry.FromStageID {
									<span>{ stage.Name }</span>
								}
							}
							<span> → </span>
							for _, stage := range data.EngagementStages {
								if stage.ID == entry.ToStageID {
									<span>{ stage.Name }</span>
								}
							}
							<span> — { entry.ActorUserID.String() } — { entry.CreatedAt }</span>
						</li>
					}
				</ol>
			</section>
		}
	}
}

templ dueEngagementsPage(data viewmodel.PageData, items []engagement.Engagement, clientsPath string) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.T("engagement.due_list"), data.T("clients.title")) {}
		<section class="card my-4 p-6"><ul>
			for _, item := range items {
				<li><a class="link" href={ templ.SafeURL(clientsPath + "/" + item.ClientID.String()) }>{ item.NextAction.Text }</a> — { item.NextAction.DueDate }</li>
			}
		</ul></section>
	}
}

templ engagementStagesPage(data viewmodel.PageData, stages []engagement.Stage, canManage bool) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.T("engagement.stages"), data.T("clients.title")) {}
		<section class="card my-4 p-6">
			if data.ErrorKey != "" {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
			if canManage {
				<form action={ templ.SafeURL(data.CurrentPath + "/label") } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.TextField("engagement-label", data.T("engagement.label"), templ.Attributes{"name": "label", "value": data.EngagementLabel, "maxlength": "100"})
					@molecules.SubmitButton(data.T("engagement.save_label"), nil)
				</form>
				<form action={ templ.SafeURL(data.CurrentPath) } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.TextField("stage-name", data.T("engagement.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "200"})
					@atoms.Select(atoms.SelectProps{ID: "stage-kind", Name: "kind", Label: data.T("engagement.kind"), Options: []atoms.SelectOption{{Label: data.T("engagement.open"), Value: "open"}, {Label: data.T("engagement.won"), Value: "won"}, {Label: data.T("engagement.lost"), Value: "lost"}}})
					@molecules.SubmitButton(data.T("engagement.add"), nil)
				</form>
			}
			if len(stages) == 0 {
				<p>{ data.T("engagement.none") }</p>
			} else {
				<ol class="list-decimal ml-6">
					for i, stage := range stages {
						<li>
							{ stage.Name } — { data.T("engagement." + stage.Kind) }
							if stage.Archived {
								<span>({ data.T("engagement.archived") })</span>
							}
							if canManage {
								<form action={ templ.SafeURL(data.CurrentPath + "/reorder") } method="post" class="inline">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									<input type="hidden" name="stage" value={ stage.ID.String() }/>
									if i > 0 {
										<button class="btn btn-ghost btn-xs" name="direction" value="up" aria-label={ data.T("engagement.up") + " " + stage.Name }>{ data.T("engagement.up") }</button>
									}
									if i < len(stages)-1 {
										<button class="btn btn-ghost btn-xs" name="direction" value="down" aria-label={ data.T("engagement.down") + " " + stage.Name }>{ data.T("engagement.down") }</button>
									}
								</form>
								if !stage.Archived {
									<form action={ templ.SafeURL(data.CurrentPath + "/" + stage.ID.String() + "/archive") } method="post" class="inline">
										<input type="hidden" name="csrf" value={ data.CSRF }/>
										<button class="btn btn-ghost btn-xs" aria-label={ data.T("engagement.archive") + " " + stage.Name }>{ data.T("engagement.archive") }</button>
									</form>
								}
							}
						</li>
					}
				</ol>
			}
		</section>
	}
}
