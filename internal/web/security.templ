package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

templ securityPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.AccountHeader(data), organisms.AccountNavigation(data)) {
		<div class="account-page" data-account-page aria-labelledby="security-heading">
			<header class="account-heading bg-base-100 border-b border-base-200">
				<p class="eyebrow">{ data.T("common.account") }</p>
				<h1 id="security-heading">{ data.T("security.security") }</h1>
				<p class="account-intro">{ data.T("security.description") }</p>
			</header>
			if data.Error != "" {
				@molecules.ErrorAlert(data.Error)
			}
			if data.MFAError != "" {
				@molecules.ErrorAlert(data.MFAError)
			}
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="security-mfa-heading">
				<h2 id="security-mfa-heading">{ data.T("security.mfa_title") }</h2>
				<p>{ data.T("security.mfa_description") }</p>
				if data.MFAStatus.Enabled {
					<p>{ data.T("security.mfa_passkeys") }{ ": " }{ data.MFAStatus.PasskeyCount }{ " · " }{ data.T("security.mfa_authenticator") }{ ": " }
					if data.MFAStatus.TOTPEnabled {
						{ data.T("security.mfa_enabled") }
					} else {
						{ data.T("security.mfa_not_enabled") }
					}
					{ " · " }{ data.T("security.mfa_recovery_remaining") }{ ": " }{ data.MFAStatus.RecoveryRemain }</p>
					<form id="passkey-enroll" x-data="passkeyEnroll" action="/api/v1/auth/mfa/passkeys/register/options" method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.TextField("passkey-password", data.T("security.mfa_password_optional"), templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password"})
						@molecules.SubmitButton(data.T("security.mfa_add_passkey"), nil)
					</form>
					if !data.MFAStatus.TOTPEnabled {
						<form action="/security/totp/start" method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							@molecules.TextField("totp-password", data.T("security.mfa_password_optional"), templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password"})
							@molecules.SubmitButton(data.T("security.mfa_setup_authenticator"), nil)
						</form>
					} else {
						<form action="/security/totp/remove" method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							@molecules.TextField("remove-totp-password", data.T("security.mfa_password_optional"), templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password"})
							@molecules.ConfirmButton(data.T("security.mfa_remove_authenticator"), data.T("security.mfa_remove_authenticator"), templ.Attributes{"class": "btn btn-error danger"})
						</form>
					}
					for _, passkey := range data.Passkeys {
						if passkey.RevokedAt == nil {
							<form action={ "/security/passkey/" + passkey.ID } method="post">
								<input type="hidden" name="csrf" value={ data.CSRF }/>
								@molecules.TextField("remove-"+passkey.ID, data.T("security.mfa_password_optional")+" — "+passkey.Name, templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password"})
								@molecules.ConfirmButton(data.T("security.mfa_remove_passkey"), data.T("security.mfa_remove_passkey"), templ.Attributes{"class": "btn btn-error danger"})
							</form>
						}
					}
					if data.TOTPEnrollment != nil {
						<p>{ data.T("security.mfa_setup_value") }{ ": " }<code>{ data.TOTPEnrollment.Secret }</code></p>
						<form action="/security/totp/complete" method="post">
							<input type="hidden" name="csrf" value={ data.CSRF }/>
							<input type="hidden" name="challenge" value={ data.TOTPEnrollment.Challenge }/>
							@molecules.TextField("totp-enrollment-code", data.T("security.mfa_authenticator_code"), templ.Attributes{"name": "code", "inputmode": "numeric", "autocomplete": "one-time-code", "minlength": "6", "maxlength": "9", "required": true, "data-mask": "digits", "data-mask-length": "6"})
							@molecules.SubmitButton(data.T("security.mfa_confirm_authenticator"), nil)
						</form>
					}
					if len(data.MFARecoveryCodes) > 0 {
						<h3>{ data.T("security.mfa_recovery_codes") }</h3>
						<p>{ data.T("security.mfa_store_recovery") }{ " " }{ data.T("security.mfa_each_recovery_once") }</p>
						@atoms.MockupCode(atoms.MockupCodeProps{Lines: recoveryCodeLines(data.MFARecoveryCodes)})
					}
					<div id="mfa-recovery-output" hidden>
						<h3>{ data.T("security.mfa_recovery_codes") }</h3>
						<p>{ data.T("security.mfa_store_recovery") }{ " " }{ data.T("security.mfa_each_recovery_once") }</p>
						<pre id="mfa-recovery-values"></pre>
					</div>
				}
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="security-linked-identity-heading">
				<h2 id="security-linked-identity-heading">{ data.T("security.linked_identity_title") }</h2>
				<p>{ data.T("security.linked_identity_description") }</p>
				if len(data.OIDCProviders) > 0 {
					<form action="/security" method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						{{ providerOptions := make([]atoms.SelectOption, 0, len(data.OIDCProviders)) }}
						{{ for _, provider := range data.OIDCProviders {
							providerOptions = append(providerOptions, atoms.SelectOption{Label: provider.Name, Value: provider.ID})
						} }}
						@atoms.Select(atoms.SelectProps{ID: "provider", Name: "provider", Label: data.T("security.provider"), Options: providerOptions})
						@molecules.TextField("reauth-password", data.T("security.password"), templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password", "required": true})
						@molecules.SubmitButton(data.T("security.link"), nil)
					</form>
				} else {
					<p>{ data.T("errors.no_oidc") }</p>
				}
			</section>
			<script defer src="/assets/alpine-components.js"></script>
			<script defer src="/assets/js/alpine.min.js"></script>
		</div>
	}
}

func recoveryCodeLines(codes []string) []atoms.CodeLine {
	lines := make([]atoms.CodeLine, 0, len(codes))
	for _, code := range codes {
		lines = append(lines, atoms.CodeLine{Code: code})
	}
	return lines
}
