package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/components"
import "example.com/dynamis-code/apps-template/internal/web/layouts"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "time"

templ sessionsPage(data viewmodel.PageData, currentSessionID string, now time.Time) {
	@layouts.DashboardShell(data, layouts.AccountHeader(data), nil) {
		<section class="account-page" aria-labelledby="sessions-heading">
			<header class="account-heading">
				<p class="eyebrow">{ data.T("navigation.security") }</p>
				<h1 id="sessions-heading">{ data.T("sessions.sessions") }</h1>
				<p class="account-intro">{ data.T("sessions.description") }</p>
			</header>
			if data.Saved {
				@components.SuccessAlert(data.T("sessions.revoked_feedback"))
			}
			if len(data.Sessions) == 0 {
				@components.EmptyState(data.T("sessions.empty"))
			} else {
				<ul class="session-list">
					for _, session := range data.Sessions {
						<li class="session-card">
							<div class="session-card-heading">
								<strong>{ data.AuthMethod(session.AuthMethod) }</strong>
								if session.OIDCProviderID != "" {
									<span class="session-provider">{ session.OIDCProviderID }</span>
								}
								if session.ID == currentSessionID {
									@atoms.Badge(atoms.BadgeProps{Class: "session-status", Label: data.T("sessions.current")})
								}
								if session.RevokedAt != nil {
									@atoms.Badge(atoms.BadgeProps{Class: "session-status session-status-revoked", Label: data.T("sessions.revoked")})
								} else if !now.Before(session.ExpiresAt) {
									@atoms.Badge(atoms.BadgeProps{Class: "session-status session-status-revoked", Label: data.T("sessions.expired")})
								} else {
									@atoms.Badge(atoms.BadgeProps{Class: "session-status session-status-active", Label: data.T("sessions.active")})
								}
							</div>
							<dl class="session-details">
								<div><dt>{ data.T("sessions.created") }</dt><dd><time datetime={ session.CreatedAt.Format(time.RFC3339) }>{ data.DateTime(session.CreatedAt) }</time></dd></div>
								<div><dt>{ data.T("sessions.expires") }</dt><dd><time datetime={ session.ExpiresAt.Format(time.RFC3339) }>{ data.DateTime(session.ExpiresAt) }</time></dd></div>
							</dl>
							if session.RevokedAt == nil && now.Before(session.ExpiresAt) {
								<form class="inline" data-webmcp-actions="session-revoke" data-webmcp-id={ session.ID } action={ "/sessions/" + session.ID } method="post">
									<input type="hidden" name="csrf" value={ data.CSRF }/>
									@atoms.Button(atoms.ButtonProps{
										Class: "btn-secondary secondary",
										Label: data.T("sessions.revoke"),
										Attrs: templ.Attributes{"type": "submit"},
									})
								</form>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
}
