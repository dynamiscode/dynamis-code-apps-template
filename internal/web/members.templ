package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "example.com/dynamis-code/apps-template/internal/identity"

templ membersPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.SettingsSidebar(data)) {
		@molecules.PageHeading(data.T("members.members"), data.T("navigation.settings_access"))
		@organisms.PeopleTabs(data)
		if data.Error != "" {
			@molecules.ErrorAlert(data.Error)
		}
		<p class="status-line">{ data.T("members.role_help") }</p>
		if data.CanTransfer {
			<p class="status-line">{ data.T("members.transfer_consequence") }</p>
		}
		<section id="member-list" aria-labelledby="members-heading">
			<h2 id="members-heading" class="sr-only">{ data.T("members.members") }</h2>
			<p class="status-line" role="status">
				if data.MemberTotal == 1 {
					{ data.T("members.count_one") }
				} else {
					{ data.T("members.count_other", map[string]any{"count": data.MemberTotal}) }
				}
			</p>
			@memberListView(data)
								</section>
		<script defer src="/assets/htmx.min.js"></script>
		}
}

templ memberListView(data viewmodel.PageData) {
	@organisms.ListScreen(data, "members.search", memberListTools(data), memberResults(data))
}

// memberListTools are the member list's own controls on the toolbar: the columns.
templ memberListTools(data viewmodel.PageData) {
	if data.ListHasContent() {
		@molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
	}
}

// memberResults is the Members results region: the table or cards and the empty state. A live search also
// refreshes the filter bar out of band.
templ memberResults(data viewmodel.PageData) {
	@organisms.ListResults(data, data.MemberListQuery.Limit, listPageSizeOptions(data.MemberListQuery.Limit, memberPageSizes), data.ClientQuerySuffix, memberRows(data), templ.NopComponent)
}

templ memberRows(data viewmodel.PageData) {
	// An empty list renders no table at all: the header row alone reads as a
	// stray bar where the table "would be".
	if len(data.ListRows) > 0 && data.HasVisibleClientColumns {
		@organisms.ListTable(data.T("members.members"), true) {
			@organisms.ListHeader(data, data.T("clients.actions"))
			<tbody>
				for _, row := range data.ListRows {
					@organisms.ListRow("") {
						@organisms.ListCells(data, row, "")
						<td class="list-actions-cell">@molecules.ListRowMenu(data) {
							@memberActions(data, row.Member, "table")
						}</td>
					}
				}
			</tbody>
		}
		@molecules.ListCards() {
			for _, row := range data.ListRows {
				@organisms.ListCardItem(data, row, "") {
					@organisms.ListRowMenuCard(data) {
						@memberActions(data, row.Member, "card")
					}
				}
			}
		}
	} else if len(data.ListRows) > 0 {
		@molecules.StatusLine(data.T("clients.columns_choose"), nil)
	}
	if data.MemberTotal == 0 {
		@molecules.NoMatchesAlert(molecules.NoMatchesAlertProps{ID: "member-results", Message: data.T("members.none"), Href: data.ClearClientFiltersPath, Label: data.T("clients.clear_filters")})
	}
}

templ memberActions(data viewmodel.PageData, member identity.MemberSummary, suffix string) {
	if data.CanManage && member.Role != identity.Owner {
		<div class="member-actions">
			<p class="sr-only">{ member.Email }</p>
			<form data-webmcp-actions="member-role-update" data-webmcp-id={ member.ID.String() } action={ "/workspaces/"+data.Workspace.ID.String()+"/settings/members" } method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="member_id" value={ member.ID.String() }/>
				@atoms.Select(atoms.SelectProps{
					ID: "role-"+member.ID.String()+"-"+suffix, Name: "role", Label: data.T("members.role"),
					Options: []atoms.SelectOption{
						{Label: data.T("members.admin"), Value: "admin", Selected: member.Role == identity.Admin},
						{Label: data.T("members.member"), Value: "member", Selected: member.Role == identity.Member},
						{Label: data.T("members.viewer"), Value: "viewer", Selected: member.Role == identity.Viewer},
					},
				})
				@atoms.Button(atoms.ButtonProps{Class: "btn-primary", Label: data.T("members.change_role"), Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "role"}})
			</form>
			<form data-webmcp-actions="member-remove" data-webmcp-id={ member.ID.String() } action={ "/workspaces/"+data.Workspace.ID.String()+"/settings/members" } method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="member_id" value={ member.ID.String() }/>
				<p id={ "remove-consequence-"+member.ID.String()+"-"+suffix } class="status-line">{ data.T("members.remove_consequence") }</p>
				<fieldset><legend>{ data.T("members.remove_confirm") }</legend>@atoms.Checkbox(atoms.CheckboxProps{
					ID:         "confirm-remove-" + member.ID.String() + "-" + suffix,
					Name:       "confirm_remove",
					LabelClass: "confirmation",
					After:      data.T("members.remove_confirm"),
					Attrs:      templ.Attributes{"value": "yes", "required": true, "aria-describedby": "remove-consequence-" + member.ID.String() + "-" + suffix},
				})@atoms.Button(atoms.ButtonProps{Class: "btn-error danger", Label: data.T("members.remove"), Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "remove"}})</fieldset>
			</form>
			if data.CanTransfer {
				<form data-webmcp-actions="ownership-transfer" data-webmcp-id={ member.ID.String() } action={ "/workspaces/"+data.Workspace.ID.String()+"/settings/members" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="member_id" value={ member.ID.String() }/>
					<fieldset><legend>{ data.T("members.transfer_consequence") }</legend>@molecules.ConfirmationField("confirm-transfer-"+member.ID.String()+"-"+suffix, "confirm_transfer", data.T("members.transfer_confirm"))@atoms.Button(atoms.ButtonProps{Class: "btn-error danger", Label: data.T("members.transfer"), Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "transfer"}})</fieldset>
				</form>
			}
		</div>
	}
}
