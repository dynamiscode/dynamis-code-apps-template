package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import (
	"time"

	"example.com/dynamis-code/apps-template/internal/identity"
)

templ invitationManagementView(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.SettingsSidebar(data)) {
		<div class="settings-page">
			@molecules.PageHeading(data.Workspace.Name + " · " + data.T("invitations.invitations"), data.T("navigation.settings"))
			@organisms.PeopleTabs(data)
			if data.DeliveryWarning != "" {
				@molecules.ErrorAlert(data.DeliveryWarning)
			}
			if data.InvitationURL != "" {
				<p role="status">{ data.T("invitations.copy_link") }</p>
				@atoms.Input(atoms.InputProps{Value: data.InvitationURL, Attrs: templ.Attributes{"readonly": true, "aria-label": data.T("invitations.copy_link")}})
			}
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="invitation-create-title">
				<h2 id="invitation-create-title">{ data.T("invitations.create") }</h2>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post" data-persist="invitation-create">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@atoms.Input(atoms.InputProps{
						ID:        "invite-email",
						Label:     data.T("common.email"),
						Name:      "email",
						Type:      "email",
						Required:  true,
						MaxLength: "320",
						Attrs:     templ.Attributes{"data-trim": true},
					})
					@atoms.Select(atoms.SelectProps{
						ID:    "invite-role",
						Name:  "role",
						Label: data.T("members.role"),
						Options: []atoms.SelectOption{
							{Label: data.T("members.member"), Value: "member"},
							{Label: data.T("members.admin"), Value: "admin"},
							{Label: data.T("members.viewer"), Value: "viewer"},
						},
					})
					<p class="status-line">{ data.T("members.role_help") }</p>
					@atoms.Input(atoms.InputProps{
						ID:    "invite-life",
						Label: data.T("invitations.lifetime") + " " + data.T("ui.optional"),
						Name:  "lifetime",
						Type:  "number",
						Min:   "1",
						Max:   "43200",
						Value: "10080",
					})
					@molecules.SubmitButton(data.T("invitations.create"), templ.Attributes{"name": "action", "value": "create"})
				</form>
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="invitation-list-title">
				<h2 id="invitation-list-title">{ data.T("invitations.invitations") }</h2>
				if len(data.Invitations) == 0 {
					@molecules.EmptyState(data.T("invitations.empty"))
				} else {
					@organisms.ListTable(data.T("invitations.invitations"), true) {
						<thead><tr><th scope="col">@atoms.HeaderText(data.T("common.email"), nil)</th><th scope="col">@atoms.HeaderText(data.T("members.role"), nil)</th><th scope="col">@atoms.HeaderText(data.T("invitations.status"), nil)</th><th scope="col">@atoms.HeaderText(data.T("invitations.expires"), nil)</th><th scope="col">@atoms.HeaderText(data.T("clients.actions"), nil)</th></tr></thead>
						<tbody>
							for _, invitation := range data.Invitations {
								<tr>
									<th scope="row">{ invitation.Email }</th>
									<td>{ data.Role(invitation.Role) }</td>
									<td>{ data.T(invitationStatusKey(invitation, time.Now())) }</td>
									<td>{ data.DateTime(invitation.ExpiresAt) }</td>
									<td>
										if invitation.Status(time.Now()) == identity.InvitationPending || invitation.Status(time.Now()) == identity.InvitationExpired {
											<form class="inline" action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post">
												<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="invitation_id" value={ invitation.ID.String() }/>
												@atoms.Button(atoms.ButtonProps{Label: data.T("invitations.resend"), Attrs: templ.Attributes{"type": "submit", "name": "action", "value": "resend"}})
											</form>
										}
										if invitation.Status(time.Now()) == identity.InvitationPending {
											<form class="inline" data-webmcp-actions="invitation-revoke" data-webmcp-id={ invitation.ID.String() } action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post">
												<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="invitation_id" value={ invitation.ID.String() }/>
												@molecules.ConfirmationField("revoke-" + invitation.ID.String(), "confirm_revoke", data.T("invitations.revoke_confirm"))
												@molecules.SubmitButton(data.T("invitations.revoke"), templ.Attributes{"name": "action", "value": "revoke"})
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					}
				}
			</section>
			</div>
	}
}

templ invitationView(data viewmodel.PageData) {
	@authLayout(data, data.T("invitations.workspace_invitation")) {
		<p class="eyebrow">{ data.T("invitations.workspace_invitation") }</p>
		<h2>{ data.T("invitations.workspace_invitation") }</h2>
		if data.ErrorKey != "" {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		if data.Invitation.Email != "" {
			<p>{ data.T("invitations.invited_as", map[string]any{"role": data.Role(data.Invitation.Role), "workspace": data.Invitation.WorkspaceID.String()}) }</p>
			<p>{ data.T("invitations.email") }: { data.Invitation.Email }</p>
			<p class="status-line">{ data.T("invitations.account_match_help") }</p>
			if data.InvitationAuthenticated {
				<form action={ "/invitations/" + data.InvitationSecret } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.SubmitButton(data.T("invitations.accept"), templ.Attributes{"name": "action", "value": "accept"})
				</form>
				<p>{ data.T("invitations.already_account") }</p>
				<form action={ "/invitations/" + data.InvitationSecret + "/sign-in" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.SubmitButton(data.T("invitations.sign_in_accept"), nil)
				</form>
				<form action="/logout" method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><button class="btn btn-outline" type="submit">{ data.T("navigation.sign_out") }</button></form>
			} else {
				<section aria-labelledby="invite-account-title">
					<h2 id="invite-account-title">{ data.T("invitations.new_account") }</h2>
					<p>{ data.T("invitations.existing_account_help") }</p>
					<form action={ "/invitations/" + data.InvitationSecret } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@atoms.Input(atoms.InputProps{
							ID:        "invite-password",
							Label:     data.T("common.password"),
							Name:      "password",
							Type:      "password",
							Required:  true,
							MinLength: "12",
							MaxLength: "1024",
							Attrs:     templ.Attributes{"autocomplete": "new-password", "data-strength": true},
						})
						@molecules.SubmitButton(data.T("invitations.create_account"), templ.Attributes{"name": "action", "value": "register"})
					</form>
				</section>
				<p>{ data.T("invitations.already_account") }</p>
				<form action={ "/invitations/" + data.InvitationSecret + "/sign-in" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@molecules.SubmitButton(data.T("invitations.sign_in_accept"), nil)
				</form>
			}
		} else {
			if data.ErrorKey == "invitations.unavailable" {
				<p>{ data.T("invitations.unavailable_help") }</p>
			}
			<p><a class="btn btn-outline btn-sm" href="/">{ data.T("navigation.home") }</a></p>
		}
	}
}

templ invitationContinueView(data viewmodel.PageData) {
	@authLayout(data, data.T("invitations.workspace_invitation")) {
		<h2>{ data.T("invitations.workspace_invitation") }</h2>
		if data.ErrorKey != "" {
			@molecules.ErrorAlert(data.T(data.ErrorKey))
		}
		if data.Invitation.Email != "" {
			<p>{ data.T("invitations.invited_as", map[string]any{"role": data.Role(data.Invitation.Role), "workspace": data.Invitation.WorkspaceID.String()}) }</p>
			<p>{ data.T("invitations.email") }: { data.Invitation.Email }</p>
			<p class="status-line">{ data.T("invitations.account_match_help") }</p>
			<form action="/invitations/continue" method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				@molecules.SubmitButton(data.T("invitations.accept"), nil)
			</form>
			<form action="/logout" method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><button class="btn btn-outline" type="submit">{ data.T("navigation.sign_out") }</button></form>
		} else {
			<p>{ data.T("invitations.unavailable_help") }</p>
			<p><a class="btn btn-outline btn-sm" href="/">{ data.T("navigation.home") }</a></p>
		}
	}
}

func invitationStatusKey(invitation identity.Invitation, now time.Time) string {
	switch invitation.Status(now) {
	case identity.InvitationAccepted:
		return "invitations.accepted"
	case identity.InvitationRevoked:
		return "invitations.revoked"
	case identity.InvitationExpired:
		return "invitations.expired"
	default:
		return "invitations.pending"
	}
}
