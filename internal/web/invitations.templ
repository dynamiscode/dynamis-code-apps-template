package web

import (
	"time"

	"example.com/dynamis-code/apps-template/internal/identity"
)

templ invitationManagementView(data pageData) {
	@dashboardShell(data, dashboardHeader(data), dashboardSettingsNavigation(data)) {
		<div class="settings-page">
			@pageHeading(data.Workspace.Name + " · " + data.T("invitations.invitations"), data.T("navigation.settings"))
			@peopleTabs(data)
			if data.DeliveryWarning != "" {
				@errorAlert(data.DeliveryWarning)
			}
			if data.InvitationURL != "" {
				<p role="status">{ data.T("invitations.copy_link") }</p>
				<input class="input" aria-label={ data.T("invitations.copy_link") } value={ data.InvitationURL } readonly/>
			}
			<section class="settings-panel" aria-labelledby="invitation-create-title">
				<h2 id="invitation-create-title">{ data.T("invitations.create") }</h2>
				<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post" data-persist="invitation-create">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					<label for="invite-email">{ data.T("common.email") }</label>
					<input class="input" id="invite-email" name="email" type="email" required maxlength="320" data-trim/>
					<label for="invite-role">{ data.T("members.role") }</label>
					<select class="select" id="invite-role" name="role">
						<option value="member">{ data.T("members.member") }</option>
						<option value="admin">{ data.T("members.admin") }</option>
						<option value="viewer">{ data.T("members.viewer") }</option>
					</select>
					<p class="status">{ data.T("members.role_help") }</p>
					<label for="invite-life">{ data.T("invitations.lifetime") } { data.T("ui.optional") }</label>
					<input class="input" id="invite-life" name="lifetime" type="number" min="1" max="43200" value="10080"/>
					@submitButton(data.T("invitations.create"), templ.Attributes{"name": "action", "value": "create"})
				</form>
			</section>
			<section class="settings-panel" aria-labelledby="invitation-list-title">
				<h2 id="invitation-list-title">{ data.T("invitations.invitations") }</h2>
				if len(data.Invitations) == 0 {
					@emptyState(data.T("invitations.empty"))
				} else {
					@listTable(data.T("invitations.invitations"), true) {
						<thead><tr><th scope="col">{ data.T("common.email") }</th><th scope="col">{ data.T("members.role") }</th><th scope="col">{ data.T("invitations.status") }</th><th scope="col">{ data.T("invitations.expires") }</th><th scope="col">{ data.T("clients.actions") }</th></tr></thead>
						<tbody>
							for _, invitation := range data.Invitations {
								<tr>
									<th scope="row">{ invitation.Email }</th>
									<td>{ data.Role(invitation.Role) }</td>
									<td>{ data.T(invitationStatusKey(invitation, time.Now())) }</td>
									<td>{ data.DateTime(invitation.ExpiresAt) }</td>
									<td>
										if invitation.Status(time.Now()) == identity.InvitationPending || invitation.Status(time.Now()) == identity.InvitationExpired {
											<form class="inline" action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post">
												<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="invitation_id" value={ invitation.ID.String() }/>
												<button class="btn" name="action" value="resend">{ data.T("invitations.resend") }</button>
											</form>
										}
										if invitation.Status(time.Now()) == identity.InvitationPending {
											<form class="inline" data-webmcp-actions="invitation-revoke" data-webmcp-id={ invitation.ID.String() } action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/invitations" } method="post">
												<input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="invitation_id" value={ invitation.ID.String() }/>
												@confirmationField("revoke-" + invitation.ID.String(), "confirm_revoke", data.T("invitations.revoke_confirm"))
												@submitButton(data.T("invitations.revoke"), templ.Attributes{"name": "action", "value": "revoke"})
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					}
				}
			</section>
			<script defer src="/assets/app.js"></script>
		</div>
	}
}

templ invitationView(data pageData) {
	@authLayout(data, data.T("invitations.workspace_invitation")) {
		<p class="eyebrow">{ data.T("invitations.workspace_invitation") }</p>
		<h1>{ data.T("invitations.workspace_invitation") }</h1>
		if data.ErrorKey != "" {
			@errorAlert(data.T(data.ErrorKey))
		}
		if data.Invitation.Email != "" {
			<p>{ data.T("invitations.invited_as", map[string]any{"role": data.Role(data.Invitation.Role), "workspace": data.Invitation.WorkspaceID.String()}) }</p>
			<p>{ data.T("invitations.email") }: { data.Invitation.Email }</p>
			<p class="status">{ data.T("invitations.account_match_help") }</p>
			if data.InvitationAuthenticated {
				<form action={ "/invitations/" + data.InvitationSecret } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@submitButton(data.T("invitations.accept"), templ.Attributes{"name": "action", "value": "accept"})
				</form>
				<p>{ data.T("invitations.already_account") }</p>
				<form action={ "/invitations/" + data.InvitationSecret + "/sign-in" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@submitButton(data.T("invitations.sign_in_accept"), nil)
				</form>
				<form action="/logout" method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><button class="btn" type="submit">{ data.T("navigation.sign_out") }</button></form>
			} else {
				<section aria-labelledby="invite-account-title">
					<h2 id="invite-account-title">{ data.T("invitations.new_account") }</h2>
					<p>{ data.T("invitations.existing_account_help") }</p>
					<form action={ "/invitations/" + data.InvitationSecret } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<label for="invite-password">{ data.T("common.password") }</label>
						<input class="input" id="invite-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required data-strength/>
						@submitButton(data.T("invitations.create_account"), templ.Attributes{"name": "action", "value": "register"})
					</form>
				</section>
				<p>{ data.T("invitations.already_account") }</p>
				<form action={ "/invitations/" + data.InvitationSecret + "/sign-in" } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@submitButton(data.T("invitations.sign_in_accept"), nil)
				</form>
			}
		} else {
			if data.ErrorKey == "invitations.unavailable" {
				<p>{ data.T("invitations.unavailable_help") }</p>
			}
			<p><a href="/">{ data.T("navigation.home") }</a></p>
		}
	}
}

templ invitationContinueView(data pageData) {
	@authLayout(data, data.T("invitations.workspace_invitation")) {
		<h1>{ data.T("invitations.workspace_invitation") }</h1>
		if data.ErrorKey != "" {
			@errorAlert(data.T(data.ErrorKey))
		}
		if data.Invitation.Email != "" {
			<p>{ data.T("invitations.invited_as", map[string]any{"role": data.Role(data.Invitation.Role), "workspace": data.Invitation.WorkspaceID.String()}) }</p>
			<p>{ data.T("invitations.email") }: { data.Invitation.Email }</p>
			<p class="status">{ data.T("invitations.account_match_help") }</p>
			<form action="/invitations/continue" method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				@submitButton(data.T("invitations.accept"), nil)
			</form>
			<form action="/logout" method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><button class="btn" type="submit">{ data.T("navigation.sign_out") }</button></form>
		} else {
			<p>{ data.T("invitations.unavailable_help") }</p>
			<p><a href="/">{ data.T("navigation.home") }</a></p>
		}
	}
}

func invitationStatusKey(invitation identity.Invitation, now time.Time) string {
	switch invitation.Status(now) {
	case identity.InvitationAccepted:
		return "invitations.accepted"
	case identity.InvitationRevoked:
		return "invitations.revoked"
	case identity.InvitationExpired:
		return "invitations.expired"
	default:
		return "invitations.pending"
	}
}
