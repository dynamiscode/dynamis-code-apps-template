package web

templ apiTokenSettingsPage(data pageData) {
	@dashboardShell(data, dashboardHeader(data), settingsSidebar(data)) {
		<div class="settings-page">
				@pageHeading(data.T("tokens.tokens"), data.T("navigation.settings_access"))
				<p class="settings-intro">{ data.T("tokens.description") }</p>
				if data.TokenSecret != "" {
					@successAlert(data.T("tokens.secret_warning")) {
						<code class="breakable">{ data.TokenSecret }</code>
					}
				}
				if data.Error != "" {
					@errorAlert(data.Error)
				}
				<section class="settings-panel" aria-labelledby="token-create-heading">
					<h2 id="token-create-heading">{ data.T("tokens.create") }</h2>
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/tokens" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@textField("token-name", data.T("tokens.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "100", "data-trim": true})
						<fieldset>
							<legend>{ data.T("tokens.scopes") }</legend>
							<label><input type="checkbox" name="scope" value="workspace:read" checked/>{ " " }{ data.T("tokens.workspace_read") }</label>
							<label><input type="checkbox" name="scope" value="workspace:update"/>{ " " }{ data.T("tokens.workspace_update") }</label>
							<label><input type="checkbox" name="scope" value="resources:read"/>{ " " }{ data.T("tokens.resources_read") }</label>
							<label><input type="checkbox" name="scope" value="resources:write"/>{ " " }{ data.T("tokens.resources_write") }</label>
							<label><input type="checkbox" name="scope" value="workspace:export"/>{ " " }{ data.T("tokens.workspace_export") }</label>
						</fieldset>
						@textField("token-expiry", data.T("tokens.expiration")+" "+data.T("ui.optional"), templ.Attributes{"name": "expires_at", "type": "date", "value": data.DefaultTokenExpiry()})
						@submitButton(data.T("tokens.create"), templ.Attributes{"name": "action", "value": "create"})
					</form>
				</section>
				<section class="settings-panel" aria-labelledby="token-list-heading">
					<h2 id="token-list-heading">{ data.T("tokens.tokens") }</h2>
					if len(data.Tokens) > 0 {
						<ul class="settings-records">
							for _, token := range data.Tokens {
								<li class="settings-record">
									<div><strong>{ token.Name }</strong><p>{ data.ScopeList(token.Scopes) }</p><p>{ data.T("sessions.created") } { data.DateTime(token.CreatedAt) }
										if token.RevokedAt != nil {
											{ " — " }{ data.T("invitations.revoked") }
										}
									</p></div>
									if token.RevokedAt == nil {
										<form class="inline" data-webmcp-actions="token-revoke" data-webmcp-id={ token.ID.String() } action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/tokens/" + token.ID.String() } method="post">
											<input type="hidden" name="csrf" value={ data.CSRF }/>
											@confirmButton(data.T("tokens.revoke"), data.T("tokens.revoke_confirm"), templ.Attributes{"name": "action", "value": "revoke"})
										</form>
									}
								</li>
							}
						</ul>
					} else {
						@emptyState(data.T("tokens.none"))
					}
				</section>
			</div>
	}
}

templ scimProvisioningSettingsPage(data pageData) {
	@dashboardShell(data, dashboardHeader(data), settingsSidebar(data)) {
			<div class="settings-page">
				@pageHeading(data.T("scim.title"), data.T("navigation.settings_access"))
				<p class="settings-intro">{ data.T("scim.description") }</p>
				if data.Error != "" {
					@errorAlert(data.Error)
				}
				<section class="settings-panel" aria-labelledby="scim-endpoint-heading">
					<h2 id="scim-endpoint-heading">{ data.T("scim.endpoint") }</h2>
					<p>{ data.T("scim.endpoint_description") }</p>
					<p><code class="breakable">{ data.SCIMEndpoint }</code></p>
				</section>
				<section class="settings-panel" aria-labelledby="scim-credential-heading">
					<h2 id="scim-credential-heading">{ data.T("scim.credential") }</h2>
					<p>{ data.T("scim.credential_description") }</p>
					if data.SCIMTokenSecret != "" {
						@successAlert(data.T("scim.secret_warning")) {
							<code class="breakable">{ data.SCIMTokenSecret }</code>
						}
					}
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/provisioning" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@submitButton(data.T("scim.create"), templ.Attributes{"name": "action", "value": "create"})
					</form>
				</section>
				<section class="settings-panel danger-panel" aria-labelledby="scim-revoke-heading">
					<h2 id="scim-revoke-heading">{ data.T("scim.revoke_title") }</h2>
					<p>{ data.T("scim.revoke_description") }</p>
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/provisioning" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@confirmButton(data.T("scim.revoke"), data.T("scim.revoke_confirm"), templ.Attributes{"name": "action", "value": "revoke"})
					</form>
				</section>
			</div>
	}
}
