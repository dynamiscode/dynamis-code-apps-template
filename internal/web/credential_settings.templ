package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

templ apiTokenSettingsPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.SettingsSidebar(data)) {
		<div class="settings-page">
				@molecules.PageHeading(data.T("tokens.tokens"), data.T("navigation.settings_access"))
				<p class="settings-intro">{ data.T("tokens.description") }</p>
				if data.TokenSecret != "" {
					@molecules.SuccessAlert(data.T("tokens.secret_warning")) {
						<code class="breakable">{ data.TokenSecret }</code>
					}
				}
				if data.Error != "" {
					@molecules.ErrorAlert(data.Error)
				}
				<section class="settings-panel card min-w-0 p-5" aria-labelledby="token-create-heading">
					<h2 id="token-create-heading">{ data.T("tokens.create") }</h2>
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/tokens" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.TextField("token-name", data.T("tokens.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "100", "data-trim": true})
						<fieldset>
							<legend>{ data.T("tokens.scopes") }</legend>
							@atoms.Checkbox(atoms.CheckboxProps{Name: "scope", Checked: true, After: data.T("tokens.workspace_read"), Attrs: templ.Attributes{"value": "workspace:read"}})
							@atoms.Checkbox(atoms.CheckboxProps{Name: "scope", After: data.T("tokens.workspace_update"), Attrs: templ.Attributes{"value": "workspace:update"}})
							@atoms.Checkbox(atoms.CheckboxProps{Name: "scope", After: data.T("tokens.resources_read"), Attrs: templ.Attributes{"value": "resources:read"}})
							@atoms.Checkbox(atoms.CheckboxProps{Name: "scope", After: data.T("tokens.resources_write"), Attrs: templ.Attributes{"value": "resources:write"}})
							@atoms.Checkbox(atoms.CheckboxProps{Name: "scope", After: data.T("tokens.workspace_export"), Attrs: templ.Attributes{"value": "workspace:export"}})
						</fieldset>
						@molecules.TextField("token-expiry", data.T("tokens.expiration")+" "+data.T("ui.optional"), templ.Attributes{"name": "expires_at", "type": "date", "value": data.DefaultTokenExpiry()})
						@molecules.SubmitButton(data.T("tokens.create"), templ.Attributes{"name": "action", "value": "create"})
					</form>
				</section>
				<section class="settings-panel card min-w-0 p-5" aria-labelledby="token-list-heading">
					<h2 id="token-list-heading">{ data.T("tokens.tokens") }</h2>
					if len(data.Tokens) > 0 {
						<ul class="settings-record card card-compact flex flex-wrap items-center justify-between gap-4 bg-base-200 px-4 py-3s">
							for _, token := range data.Tokens {
								<li class="settings-record card card-compact flex flex-wrap items-center justify-between gap-4 bg-base-200 px-4 py-3">
									<div><strong>{ token.Name }</strong><p>{ data.ScopeList(token.Scopes) }</p><p>{ data.T("sessions.created") } { data.DateTime(token.CreatedAt) }
										if token.RevokedAt != nil {
											{ " — " }{ data.T("invitations.revoked") }
										}
									</p></div>
									if token.RevokedAt == nil {
										<form class="inline" data-webmcp-actions="token-revoke" data-webmcp-id={ token.ID.String() } action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/tokens/" + token.ID.String() } method="post">
											<input type="hidden" name="csrf" value={ data.CSRF }/>
											@molecules.ConfirmButton(data.T("tokens.revoke"), data.T("tokens.revoke_confirm"), templ.Attributes{"name": "action", "value": "revoke"})
										</form>
									}
								</li>
							}
						</ul>
					} else {
						@molecules.EmptyState(data.T("tokens.none"))
					}
				</section>
			</div>
	}
}

templ scimProvisioningSettingsPage(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.SettingsSidebar(data)) {
			<div class="settings-page">
				@molecules.PageHeading(data.T("scim.title"), data.T("navigation.settings_access"))
				<p class="settings-intro">{ data.T("scim.description") }</p>
				if data.Error != "" {
					@molecules.ErrorAlert(data.Error)
				}
				<section class="settings-panel card min-w-0 p-5" aria-labelledby="scim-endpoint-heading">
					<h2 id="scim-endpoint-heading">{ data.T("scim.endpoint") }</h2>
					<p>{ data.T("scim.endpoint_description") }</p>
					<p><code class="breakable">{ data.SCIMEndpoint }</code></p>
				</section>
				<section class="settings-panel card min-w-0 p-5" aria-labelledby="scim-credential-heading">
					<h2 id="scim-credential-heading">{ data.T("scim.credential") }</h2>
					<p>{ data.T("scim.credential_description") }</p>
					if data.SCIMTokenSecret != "" {
						@molecules.SuccessAlert(data.T("scim.secret_warning")) {
							<code class="breakable">{ data.SCIMTokenSecret }</code>
						}
					}
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/provisioning" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.SubmitButton(data.T("scim.create"), templ.Attributes{"name": "action", "value": "create"})
					</form>
				</section>
				<section class="settings-panel card min-w-0 p-5 danger-panel" aria-labelledby="scim-revoke-heading">
					<h2 id="scim-revoke-heading">{ data.T("scim.revoke_title") }</h2>
					<p>{ data.T("scim.revoke_description") }</p>
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/provisioning" } method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.ConfirmButton(data.T("scim.revoke"), data.T("scim.revoke_confirm"), templ.Attributes{"name": "action", "value": "revoke"})
					</form>
				</section>
			</div>
	}
}
