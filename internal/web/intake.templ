package web

import "example.com/dynamis-code/apps-template/internal/intake"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"
import "strings"

templ intakeSettingsPage(data viewmodel.PageData, settings intake.Settings, message string, link string, linkMessage string) {
	@templates.DashboardShell(data, templates.DashboardSettings) {
		<div class="settings-page">
			@molecules.PageHeading(data.T("intake.title"), data.T("navigation.settings_setup")) {}
			<p class="settings-intro">{ data.T("intake.description") }</p>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="intake-readiness-title">
			<h2 id="intake-readiness-title">{ data.T("intake.readiness") }</h2>
			if data.Saved {
				@molecules.SuccessAlert(data.T("intake.saved"))
			}
			if !settings.HasOpenStage {
				<div class="alert alert-warning" role="status">
					<span>{ data.T("intake.no_open_stage") }</span>
					<a class="btn btn-outline btn-sm" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/intake") + "/engagement-stages") }>{ data.T("engagement.stages") }</a>
				</div>
			}
			if message != "" {
				@molecules.ErrorAlert(data.T(message))
			}
			if settings.Active && settings.HasOpenStage {
				<p>{ data.T("intake.active") }</p>
			} else if !settings.Active {
				<p>{ data.T("intake.disabled") }</p>
			}
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="intake-share-title">
			<h2 id="intake-share-title">{ data.T("intake.share") }</h2>
			if link != "" {
				<p>{ data.T("intake.copy") }</p>
				<p><input id="intake-link" class="input input-bordered w-full" aria-label={ data.T("intake.link") } readonly value={ link }/></p>
				if settings.HasOpenStage {
					<button type="button" class="btn btn-primary" data-copy-target="intake-link" data-copy-success={ data.T("intake.copied") }>{ data.T("intake.copy_button") }</button>
					<span role="status" aria-live="polite" data-copy-status></span>
					<a class="btn btn-outline" href={ templ.SafeURL(link) } target="_blank" rel="noopener noreferrer">{ data.T("intake.test_link") }</a>
				}
			} else if settings.Active {
				<p>{ data.T(linkMessage) }</p>
			} else {
				<p>{ data.T("intake.create_help") }</p>
			}
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="intake-consent-title">
			<h2 id="intake-consent-title">{ data.T("intake.consent") }</h2>
			<form action={ templ.SafeURL(data.CurrentPath) } method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				<p id="intake-consent-help">{ data.T("intake.consent_help") }</p>
				@molecules.TextareaField("intake-consent", data.T("intake.consent"), settings.ConsentText, templ.Attributes{"name": "consent", "required": true, "maxlength": "2000", "aria-describedby": "intake-consent-help"})
				if settings.ConsentText != "" {
					<p>{ data.T("intake.consent_preview") }</p>
					<blockquote class="border-l-4 border-base-300 pl-4">{ settings.ConsentText }</blockquote>
				}
				<button class={ "btn", templ.KV("btn-primary", settings.Active), templ.KV("btn-outline", !settings.Active) } name="action" value="consent">{ data.T("intake.save") }</button>
				if settings.Active {
					<button class="btn btn-outline btn-error" name="action" value="rotate" data-confirm={ data.T("intake.rotate_confirm") }>{ data.T("intake.rotate") }</button>
				} else {
					<button class="btn btn-primary" name="action" value="create">{ data.T("intake.create") }</button>
				}
			</form>
			if settings.Active {
				<form action={ templ.SafeURL(data.CurrentPath) } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					<button class="btn btn-outline btn-error" name="action" value="disable" data-confirm={ data.T("intake.disable_confirm") }>{ data.T("intake.disable") }</button>
				</form>
			}
			</section>
			<section class="settings-panel card min-w-0 p-5" aria-labelledby="intake-delivery-title">
			<h2 id="intake-delivery-title">{ data.T("intake.delivery") }</h2>
			<p>{ data.T("intake.delivery_help") }</p>
			<a class="btn btn-outline" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/settings/email") }>{ data.T("intake.email_settings") }</a>
			<a class="btn btn-outline" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/intake") + "/clients") }>{ data.T("intake.view_clients") }</a>
			</section>
		</div>
	}
}
