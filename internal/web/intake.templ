package web

import "example.com/dynamis-code/apps-template/internal/intake"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"
import "strings"

templ intakeSettingsPage(data viewmodel.PageData, settings intake.Settings, message string, link string) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.T("intake.title"), data.T("clients.title")) {}
		<section class="card my-4 p-6">
			<p>{ data.T("intake.description") }</p>
			<h2 class="mt-4">{ data.T("intake.readiness") }</h2>
			if data.Saved {
				@molecules.SuccessAlert(data.T("intake.saved"))
			}
			if !settings.HasOpenStage {
				<div class="alert alert-warning" role="status">
					<span>{ data.T("intake.no_open_stage") }</span>
					<a class="link" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/intake") + "/engagement-stages") }>{ data.T("engagement.stages") }</a>
				</div>
			}
			if message != "" {
				@molecules.ErrorAlert(data.T(message))
			}
			if settings.Active {
				<p>{ data.T("intake.active") }</p>
			} else {
				<p>{ data.T("intake.disabled") }</p>
			}
			<h2 class="mt-4">{ data.T("intake.share") }</h2>
			if link != "" {
				<p>{ data.T("intake.copy") }</p>
				<p><input id="intake-link" class="input input-bordered w-full" aria-label={ data.T("intake.link") } readonly value={ link }/></p>
				<button type="button" class="btn btn-secondary" data-copy-target="intake-link" data-copy-success={ data.T("intake.copied") }>{ data.T("intake.copy_button") }</button>
				<span role="status" aria-live="polite" data-copy-status></span>
				<a class="link" href={ templ.SafeURL(link) } target="_blank" rel="noopener noreferrer">{ data.T("intake.test_link") }</a>
			} else if settings.Active {
				<p>{ data.T("intake.link_unavailable") }</p>
			} else {
				<p>{ data.T("intake.create_help") }</p>
			}
			<form action={ templ.SafeURL(data.CurrentPath) } method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				<h2 class="mt-4">{ data.T("intake.consent") }</h2>
				<p id="intake-consent-help">{ data.T("intake.consent_help") }</p>
				@molecules.TextareaField("intake-consent", data.T("intake.consent"), settings.ConsentText, templ.Attributes{"name": "consent", "required": true, "maxlength": "2000", "aria-describedby": "intake-consent-help"})
				if settings.ConsentText != "" {
					<p>{ data.T("intake.consent_preview") }</p>
					<blockquote class="border-l-4 border-base-300 pl-4">{ settings.ConsentText }</blockquote>
				}
				<button class="btn" name="action" value="consent">{ data.T("intake.save") }</button>
				if settings.Active {
					<button class="btn" name="action" value="rotate" data-confirm={ data.T("intake.rotate_confirm") }>{ data.T("intake.rotate") }</button>
				} else {
					<button class="btn btn-primary" name="action" value="create">{ data.T("intake.create") }</button>
				}
			</form>
			if settings.Active {
				<form action={ templ.SafeURL(data.CurrentPath) } method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					<button class="btn" name="action" value="disable" data-confirm={ data.T("intake.disable_confirm") }>{ data.T("intake.disable") }</button>
				</form>
			}
			<h2 class="mt-4">{ data.T("intake.delivery") }</h2>
			<p>{ data.T("intake.delivery_help") }</p>
			<a class="link link-primary" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/settings/email") }>{ data.T("intake.email_settings") }</a>
			<a class="link link-primary" href={ templ.SafeURL(strings.TrimSuffix(data.CurrentPath, "/intake") + "/clients") }>{ data.T("intake.view_clients") }</a>
		</section>
	}
}
