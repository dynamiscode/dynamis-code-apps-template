package web

import "example.com/dynamis-code/apps-template/internal/clients"
import "example.com/dynamis-code/apps-template/internal/engagement"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

templ engagementNewPage(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 @templates.DashboardShell(data, templates.DashboardHome) {
  if data.Client.ID != 0 {
   @molecules.BackLink(clientContextURL("/workspaces/" + data.Workspace.ID.String() + "/clients/" + data.Client.ID.String(), data.ClientReturnQuery), data.T("clients.back"))
  } else {
   @molecules.BackLink(engagementNewReturn(data), data.T("engagement.back_to_list"))
  }
  @molecules.PageHeading(data.T("engagement.create"), data.T("engagement.title"))
  @engagementNewContent(data, choices, selected, stages, search, prev, next, pickerOpen)
 }
}

templ engagementNewDialog(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 <dialog class="modal" aria-labelledby="engagement-create-title" data-engagement-dialog data-engagement-discard-message={ data.T("ui.unsaved") }>
  <div class="modal-box max-w-4xl">
   <div class="flex items-start justify-between gap-3">
    <h2 id="engagement-create-title">{ data.T("engagement.create") }</h2>
    if data.Client.ID != 0 {
     <a class="btn btn-ghost btn-square shrink-0" href={ templ.SafeURL(clientContextURL("/workspaces/" + data.Workspace.ID.String() + "/clients/" + data.Client.ID.String(), data.ClientReturnQuery)) } data-engagement-cancel aria-label={ data.T("ui.close") }><span aria-hidden="true">×</span></a>
    } else {
     <a class="btn btn-ghost btn-square shrink-0" href={ templ.SafeURL(engagementNewReturn(data)) } data-engagement-cancel aria-label={ data.T("ui.close") }><span aria-hidden="true">×</span></a>
    }
   </div>
   @engagementNewContent(data, choices, selected, stages, search, prev, next, pickerOpen)
  </div>
 </dialog>
}

templ engagementNewContent(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 if data.ErrorKey != "" {
  @molecules.ErrorAlert(data.T(data.ErrorKey))
 }
 if len(stages) == 0 {
  @engagementNoStages(data)
 }
  <div class="card my-4 p-6">
   <form method="post" action={ templ.SafeURL(engagementContextURL(clientContextURL(data.CurrentPath + "/new", data.ClientReturnQuery), data.EngagementReturn)) } x-data="engagementClientPicker" data-dirty-track data-unsaved-warning data-dirty-on-load?={ data.EngagementName != "" || data.EngagementNotes != "" || data.EngagementStage != "" }>
    <input type="hidden" name="csrf" value={ data.CSRF }/>
    if data.Client.ID != 0 {
     <input type="hidden" name="from_client" value={ data.Client.ID.String() }/>
    }
    <input type="hidden" name="client" value={ selected.ID.String() } data-selected-client data-entry-required/>
    <div class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(14rem,1fr)]">
     <div class="min-w-0 flex flex-col gap-3">
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-name", Label: data.T("engagement.name"), Value: data.EngagementName}) {
       <input id="engagement-name" name="name" value={ data.EngagementName } required maxlength="200" { templ.Attributes{"aria-invalid": templ.KV("true", data.ErrorKey == "engagement.invalid_name"), "aria-describedby": templ.KV("engagement-name-error", data.ErrorKey == "engagement.invalid_name")}... }/>
      }
      if data.ErrorKey == "engagement.invalid_name" {
       <p id="engagement-name-error">{ data.T(data.ErrorKey) }</p>
      }
      {{ notesError := ""; if data.ErrorKey == "engagement.invalid_notes" { notesError = data.T(data.ErrorKey) } }}
      @molecules.NotesEditor(molecules.NotesEditorProps{
       Inline: true, ID: "engagement-notes", Name: "notes", Label: data.T("engagement.notes")+" "+data.T("ui.optional"),
       Value: data.EngagementNotes, MaxLength: "5000", Draft: data.ErrorKey == "engagement.invalid_notes", Error: notesError,
       Warning: data.T("notes.source_warning"), BoldLabel: data.T("engagement.bold"), ItalicLabel: data.T("engagement.italic"),
       ListLabel: data.T("engagement.bulleted_list"), SourceLabel: data.T("notes.source"),
       LinkLabel: data.T("notes.link"), LinkURLLabel: data.T("notes.link_url"), LinkApplyLabel: data.T("notes.link_apply"),
       LinkCancelLabel: data.T("notes.link_cancel"), LinkInvalidLabel: data.T("notes.link_invalid"),
      })
     </div>
     <div class="min-w-0 flex flex-col gap-3">
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-client-picker", Value: selected.DisplayName}) {
      <span id="engagement-client-label" class="entry-field-label">{ data.T("engagement.client") }</span>
      <details class="w-full" data-client-picker open?={ pickerOpen }>
       <summary id="engagement-client-picker" class="select select-bordered flex w-full items-center justify-between" aria-labelledby="engagement-client-label engagement-client-current" aria-describedby="engagement-create-requirements engagement-client-error" { templ.Attributes{"aria-invalid": templ.KV("true", data.ErrorKey == "engagement.invalid_client")}... }>
        <span id="engagement-client-current" data-client-current>
         if selected.ID == 0 {
          { data.T("engagement.choose_client") }
         } else {
          { selected.DisplayName }
         }
        </span>
        <span aria-hidden="true">▾</span>
       </summary>
       <div class="entry-picker-panel">
       if len(choices) > 5 || next != "" || prev != "" || search != "" {
       <div class="flex flex-wrap gap-3 items-end">
        <label class="form-control flex w-full flex-col gap-1" for="client-search"><span>{ data.T("engagement.search_clients") } { data.T("ui.optional") }</span></label>
        <input class="input input-bordered w-full" id="client-search" name="q" type="search" value={ search } maxlength="200" hx-get={ data.CurrentPath + "/new?part=client-results" } hx-trigger="input changed delay:300ms" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading"/>
        <button class="btn btn-outline" type="submit" name="picker_action" value="search" formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results" } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("ui.search") }</button>
        <span id="engagement-client-search-loading" class="htmx-indicator" role="status">{ data.T("ui.loading") }</span>
       </div>
       }
       <div id="engagement-client-results" aria-live="polite">
        @engagementClientResults(data, choices, search, prev, next)
       </div>
       </div>
      </details>
      }
      <p id="engagement-client-error">
       if data.ErrorKey == "engagement.invalid_client" {
        { data.T(data.ErrorKey) }
       }
      </p>
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-stage", Label: data.T("engagement.stage"), Value: data.EngagementStage, SearchLabel: data.T("ui.search")}) {
      <select id="engagement-stage" name="stage" class="select select-bordered" data-entry-picker required { templ.Attributes{"aria-invalid": templ.KV("true", data.ErrorKey == "engagement.invalid_stage"), "aria-describedby": templ.KV("engagement-stage-error", data.ErrorKey == "engagement.invalid_stage")}... }>
       <option value="">{ data.T("engagement.select_stage") }</option>
       for _, stage := range stages {
        <option value={ stage.ID.String() } selected?={ stage.ID.String() == data.EngagementStage }>{ stage.Name }</option>
       }
      </select>
      }
      if data.ErrorKey == "engagement.invalid_stage" {
       <p id="engagement-stage-error">{ data.T(data.ErrorKey) }</p>
      }
     </div>
    </div>
    <p id="engagement-create-requirements">{ data.T("engagement.create_requirements") }</p>
    <div class="modal-action flex-wrap"><button class="btn btn-primary" type="submit" aria-describedby="engagement-create-requirements">{ data.T("engagement.create") }</button></div>
   </form>
  </div>
}

templ engagementNoStages(data viewmodel.PageData) {
 <div class="card my-4 p-6">
  <p>{ data.T("engagement.no_open_stage") }</p>
  if data.CanManageFields {
   <a class="btn btn-outline" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/engagement-stages") }>{ data.T("engagement.setup_stages") }</a>
  } else {
   <p>{ data.T("engagement.ask_admin") }</p>
  }
 </div>
}

templ engagementClientResults(data viewmodel.PageData, choices []clients.Client, search string, prev string, next string) {
 if len(choices) == 0 {
  if search == "" {
   <p class="alert alert-warning" role="status">{ data.T("engagement.no_clients") }</p>
   <a class="btn btn-outline" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/clients/new") }>{ data.T("clients.new_client") }</a>
  } else {
   <p>{ data.T("engagement.no_client_matches") }</p>
  }
 } else {
  <ul class="grid gap-3 my-4">
   for _, client := range choices {
    <li><button class="btn btn-outline w-full justify-start" type="submit" name="picker_action" value={ "select:" + client.ID.String() } data-client-option data-client-id={ client.ID.String() } formnovalidate>{ client.DisplayName }</button></li>
   }
  </ul>
 }
 <nav aria-label={ data.T("ui.pages") }>
  if prev != "" {
   <button id="engagement-client-prev" class="btn btn-outline btn-sm" type="submit" name="picker_action" value={ "page:" + prev } formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results&page=" + prev } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("ui.previous_page") }</button>
  }
  if next != "" {
   <button id="engagement-client-next" class="btn btn-outline btn-sm" type="submit" name="picker_action" value={ "page:" + next } formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results&page=" + next } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("items.next_page") }</button>
  }
 </nav>
}

