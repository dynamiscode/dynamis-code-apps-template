package web

import "example.com/dynamis-code/apps-template/internal/clients"
import "example.com/dynamis-code/apps-template/internal/engagement"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

templ engagementNewPage(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 @templates.DashboardShell(data, templates.DashboardHome) {
  if data.Client.ID != 0 {
   @molecules.BackLink("/workspaces/" + data.Workspace.ID.String() + "/clients/" + data.Client.ID.String(), data.T("clients.back"))
  } else {
   @molecules.BackLink(data.CurrentPath, data.T("engagement.back_to_list"))
  }
  @molecules.PageHeading(data.T("engagement.create"), data.T("engagement.title"))
  @engagementNewContent(data, choices, selected, stages, search, prev, next, pickerOpen)
 }
}

templ engagementNewDialog(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 <dialog class="modal" aria-labelledby="engagement-create-title" data-engagement-dialog>
  <div class="modal-box max-w-4xl">
   <div class="flex items-start justify-between gap-3">
    <h2 id="engagement-create-title">{ data.T("engagement.create") }</h2>
    if data.Client.ID != 0 {
     <a class="btn btn-outline btn-square" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/clients/" + data.Client.ID.String()) } data-engagement-cancel aria-label={ data.T("ui.close") }><span aria-hidden="true">×</span></a>
    } else {
     <a class="btn btn-outline btn-square" href={ templ.SafeURL(data.CurrentPath) } data-engagement-cancel aria-label={ data.T("ui.close") }><span aria-hidden="true">×</span></a>
    }
   </div>
   @engagementNewContent(data, choices, selected, stages, search, prev, next, pickerOpen)
  </div>
 </dialog>
}

templ engagementNewContent(data viewmodel.PageData, choices []clients.Client, selected clients.Client, stages []engagement.Stage, search string, prev string, next string, pickerOpen bool) {
 if data.ErrorKey != "" {
  @molecules.ErrorAlert(data.T(data.ErrorKey))
 }
 if len(stages) == 0 && (len(choices) > 0 || selected.ID != 0) {
  @engagementNoStages(data)
 } else {
  <div class="card my-4 p-6">
   <form method="post" action={ templ.SafeURL(data.CurrentPath + "/new") } x-data="engagementClientPicker">
    <input type="hidden" name="csrf" value={ data.CSRF }/>
    if data.Client.ID != 0 {
     <input type="hidden" name="from_client" value={ data.Client.ID.String() }/>
    }
    <input type="hidden" name="client" value={ selected.ID.String() } data-selected-client data-entry-required/>
    <div class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(14rem,1fr)]">
     <div class="min-w-0">
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-name", Label: data.T("engagement.name"), Value: data.EngagementName}) {
       <input id="engagement-name" name="name" value={ data.EngagementName } required maxlength="200" { templ.Attributes{"aria-invalid": templ.KV("true", data.ErrorKey == "engagement.invalid_name"), "aria-describedby": templ.KV("engagement-name-error", data.ErrorKey == "engagement.invalid_name")}... }/>
      }
      if data.ErrorKey == "engagement.invalid_name" {
       <p id="engagement-name-error">{ data.T(data.ErrorKey) }</p>
      }
      @engagementNotesEditor(data, data.EngagementNotes)
     </div>
     <div class="min-w-0">
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-client-picker", Value: selected.DisplayName}) {
      <span id="engagement-client-label" class="entry-field-label">{ data.T("engagement.client") }</span>
      <details class="w-full" data-client-picker open?={ pickerOpen }>
       <summary id="engagement-client-picker" class="select select-bordered flex w-full items-center justify-between" aria-labelledby="engagement-client-label engagement-client-current">
        <span id="engagement-client-current" data-client-current>
         if selected.ID == 0 {
          { data.T("engagement.choose_client") }
         } else {
          { selected.DisplayName }
         }
        </span>
        <span aria-hidden="true">▾</span>
       </summary>
       <div class="entry-picker-panel">
       if len(choices) > 5 || next != "" || prev != "" || search != "" {
       <div class="flex flex-wrap gap-3 items-end">
        <label class="form-control flex w-full flex-col gap-1" for="client-search"><span>{ data.T("engagement.search_clients") } { data.T("ui.optional") }</span></label>
        <input class="input input-bordered w-full" id="client-search" name="q" type="search" value={ search } maxlength="200" hx-get={ data.CurrentPath + "/new?part=client-results" } hx-trigger="input changed delay:300ms" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading"/>
        <button class="btn btn-outline" type="submit" name="picker_action" value="search" formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results" } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("ui.search") }</button>
        <span id="engagement-client-search-loading" class="htmx-indicator" role="status">{ data.T("ui.loading") }</span>
       </div>
       }
       <div id="engagement-client-results" aria-live="polite">
        @engagementClientResults(data, choices, search, prev, next)
       </div>
       </div>
      </details>
      }
      @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-stage", Label: data.T("engagement.stage"), Value: data.EngagementStage, SearchLabel: data.T("ui.search")}) {
      <select id="engagement-stage" name="stage" class="select select-bordered" data-entry-picker required { templ.Attributes{"aria-invalid": templ.KV("true", data.ErrorKey == "engagement.invalid_stage"), "aria-describedby": templ.KV("engagement-stage-error", data.ErrorKey == "engagement.invalid_stage")}... }>
       <option value="">{ data.T("engagement.select_stage") }</option>
       for _, stage := range stages {
        <option value={ stage.ID.String() } selected?={ stage.ID.String() == data.EngagementStage }>{ stage.Name }</option>
       }
      </select>
      }
      if data.ErrorKey == "engagement.invalid_stage" {
       <p id="engagement-stage-error">{ data.T(data.ErrorKey) }</p>
      }
     </div>
    </div>
    <button class="btn btn-primary" type="submit">{ data.T("engagement.create") }</button>
   </form>
  </div>
 }
}

templ engagementNoStages(data viewmodel.PageData) {
 <div class="card my-4 p-6">
  <p>{ data.T("engagement.no_open_stage") }</p>
  if data.CanManageFields {
   <a class="btn btn-outline" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/engagement-stages") }>{ data.T("engagement.setup_stages") }</a>
  } else {
   <p>{ data.T("engagement.ask_admin") }</p>
  }
 </div>
}

templ engagementClientResults(data viewmodel.PageData, choices []clients.Client, search string, prev string, next string) {
 if len(choices) == 0 {
  if search == "" {
   <p class="alert alert-warning" role="status">{ data.T("engagement.no_clients") }</p>
   <a class="btn btn-outline" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/clients/new") }>{ data.T("clients.new_client") }</a>
  } else {
   <p>{ data.T("engagement.no_client_matches") }</p>
  }
 } else {
  <ul class="grid gap-3 my-4">
   for _, client := range choices {
    <li><button class="btn btn-outline w-full justify-start" type="submit" name="picker_action" value={ "select:" + client.ID.String() } data-client-option data-client-id={ client.ID.String() } formnovalidate>{ client.DisplayName }</button></li>
   }
  </ul>
 }
 <nav aria-label={ data.T("ui.pages") }>
  if prev != "" {
   <button id="engagement-client-prev" class="btn btn-outline btn-sm" type="submit" name="picker_action" value={ "page:" + prev } formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results&page=" + prev } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("ui.previous_page") }</button>
  }
  if next != "" {
   <button id="engagement-client-next" class="btn btn-outline btn-sm" type="submit" name="picker_action" value={ "page:" + next } formnovalidate hx-get={ data.CurrentPath + "/new?part=client-results&page=" + next } hx-include="#client-search" hx-target="#engagement-client-results" hx-swap="innerHTML" hx-sync="#engagement-client-results:replace" hx-indicator="#engagement-client-search-loading">{ data.T("items.next_page") }</button>
  }
 </nav>
}

templ engagementNotesEditor(data viewmodel.PageData, notes string) {
 <div class="form-control flex w-full flex-col gap-2" x-data="engagementNotesEditor" data-preview-url={ "/workspaces/" + data.Workspace.ID.String() + "/engagements/notes-preview" } data-preview-failed={ data.T("engagement.preview_failed") } data-preview-loading={ data.T("ui.loading") } data-preview-empty={ data.T("engagement.preview_empty") } data-count-label={ data.T("engagement.characters") }>
  @molecules.EntryField(molecules.EntryFieldProps{ID: "engagement-notes", Label: data.T("engagement.notes")+" "+data.T("ui.optional"), Value: notes}) {
  <div class="rounded-box border border-base-300 bg-base-100 text-base-content">
   <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-300 px-2" data-notes-controls hidden>
    <div role="tablist" aria-label={ data.T("engagement.notes") } class="tabs tabs-border">
     <button id="engagement-notes-write-tab" type="button" role="tab" class="tab tab-active" aria-selected="true" aria-controls="engagement-notes-write-panel" data-notes-write>{ data.T("engagement.write") }</button>
     <button id="engagement-notes-preview-tab" type="button" role="tab" class="tab" aria-selected="false" aria-controls="engagement-notes-preview-panel" tabindex="-1" data-notes-preview>{ data.T("engagement.preview") }</button>
    </div>
    <div class="flex flex-wrap items-center" role="group" aria-label={ data.T("engagement.formatting") } data-notes-tools>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.bold") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="bold" aria-label={ data.T("engagement.bold") } title={ data.T("engagement.bold") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M7 5h6a3.5 3.5 0 0 1 0 7H7zm0 7h7a3.5 3.5 0 0 1 0 7H7z"/></svg></button></span>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.italic") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="italic" aria-label={ data.T("engagement.italic") } title={ data.T("engagement.italic") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M14 5h5M5 19h5M15 5 9 19"/></svg></button></span>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.heading") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="heading" aria-label={ data.T("engagement.heading") } title={ data.T("engagement.heading") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 5v14M15 5v14M5 12h10M18 10l2-1v10M18 19h4"/></svg></button></span>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.bulleted_list") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="list" aria-label={ data.T("engagement.bulleted_list") } title={ data.T("engagement.bulleted_list") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg></button></span>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.link") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="link" aria-label={ data.T("engagement.link") } title={ data.T("engagement.link") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13a4 4 0 0 0 5.7 0l3-3A4 4 0 0 0 13 4.3l-1.7 1.7M14 11a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 19.7l1.7-1.7"/></svg></button></span>
     <span class="tooltip tooltip-bottom" data-tip={ data.T("engagement.code") }><button class="btn btn-outline btn-sm btn-square" type="button" data-markdown="code" aria-label={ data.T("engagement.code") } title={ data.T("engagement.code") }><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-12-2 14"/></svg></button></span>
    </div>
   </div>
   <div id="engagement-notes-write-panel" data-notes-write-panel>
    <textarea id="engagement-notes" name="notes" maxlength="5000" rows="10" class="textarea textarea-ghost w-full" placeholder={ data.T("engagement.notes_placeholder") } aria-describedby="engagement-notes-help">{ notes }</textarea>
   </div>
   <div id="engagement-notes-preview-panel" class="engagement-markdown min-h-40 p-4" role="tabpanel" aria-labelledby="engagement-notes-preview-tab" tabindex="0" aria-live="polite" data-notes-output hidden></div>
   <div class="flex flex-wrap items-center justify-between gap-2 border-t border-base-300 px-3 py-2">
    <p id="engagement-notes-help">{ data.T("engagement.markdown_help") }</p>
    <span data-notes-count hidden></span>
   </div>
  </div>
  }
 </div>
}
