package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/engagement"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "strconv"
templ workspaceSelection(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), nil) {
		@molecules.PageHeading(data.T("workspace.workspaces"), "")
		if data.Error != "" {
			@molecules.ErrorAlert(data.Error)
		}
		if len(data.Workspaces) > 0 {
			<ul class="cards grid list-none gap-4 p-0">
				for _, workspace := range data.Workspaces {
					@molecules.LinkedCard("/workspaces/" + workspace.ID.String(), workspace.Name, data.Role(workspace.Role))
				}
			</ul>
		} else {
			@molecules.EmptyState(data.T("workspace.no_memberships"))
		}
		if data.CanCreateWorkspace {
			<details class="collapse bg-base-100" if data.Error != "" { open }>
				<summary class="collapse-title font-semibold">{ data.T("workspace.create") }</summary>
				<div class="collapse-content">
					<form data-webmcp-actions="workspace-create" action="/workspaces" method="post">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@molecules.TextField("workspace-name", data.T("workspace.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "120"})
						@atoms.Select(atoms.SelectProps{
							ID: "workspace-locale", Name: "locale", Label: data.T("workspace.language_fallback"),
							Options: []atoms.SelectOption{
								{Label: data.T("common.english"), Value: "en", Selected: data.Locale == "en"},
								{Label: data.T("common.spanish"), Value: "es", Selected: data.Locale == "es"},
							},
						})
						@molecules.SubmitButton(data.T("workspace.create"), nil)
					</form>
				</div>
			</details>
		}
	}
}
templ dashboardActionPreview(data viewmodel.PageData, title, filter string, actions []engagement.ActionQueueEntry) {
	<section aria-label={ title }>
		<h3>{ title }</h3>
		if len(actions) == 0 {
			<p>{ data.T("queue.empty") }</p>
		} else {
			<ul>
				for _, action := range actions {
					<li>
						<a class="btn btn-outline btn-sm h-auto min-h-8 max-w-full whitespace-normal break-words" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/clients/" + action.ClientID.String() + "/engagements/" + action.EngagementID.String()) }>{ action.Action.Text }</a>
						<span> — { action.EngagementName } — { action.ClientName } — { action.Action.DueDate }</span>
					</li>
				}
			</ul>
		}
		<a class="btn btn-outline btn-sm h-auto min-h-8 max-w-full whitespace-normal break-words" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/engagements/due?filter=" + filter) }>{ data.T("dashboard.view_all") } — { title }</a>
	</section>
}

templ workspaceHome(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		@molecules.PageHeading(data.Workspace.Name, "")
		if data.EngagementDashboard != nil {
			<section aria-labelledby="engagement-dashboard-title">
				<h2 id="engagement-dashboard-title">{ data.T("dashboard.title") }</h2>
				<ul class="grid list-none gap-4 p-0 grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]">
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/engagements/due?filter=overdue", data.T("queue.filter_overdue"), strconv.Itoa(data.EngagementDashboard.Overdue))
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/engagements/due?filter=today", data.T("queue.filter_today"), strconv.Itoa(data.EngagementDashboard.Today))
				</ul>
				@dashboardActionPreview(data, data.T("queue.filter_overdue"), "overdue", data.EngagementDashboard.OverdueActions)
				@dashboardActionPreview(data, data.T("queue.filter_today"), "today", data.EngagementDashboard.TodayActions)
				<h3>{ data.T("dashboard.open_stages") }</h3>
				if len(data.EngagementDashboard.Stages) == 0 {
					<p>{ data.T("dashboard.empty_stages") }</p>
				}
				<ul class="grid list-none gap-4 p-0 grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]">
					for _, stage := range data.EngagementDashboard.Stages {
						<li class="card bg-base-100 p-4">
							<a class="btn btn-outline btn-sm h-auto min-h-8 max-w-full whitespace-normal break-words" href={ templ.SafeURL("/workspaces/" + data.Workspace.ID.String() + "/engagements?stage=" + stage.Stage.ID.String()) }>{ stage.Stage.Name }
								if stage.Stage.Archived {
									<span> ({ data.T("engagement.archived") })</span>
								}
								<span> — { strconv.Itoa(stage.Count) }</span>
							</a>
						</li>
					}
				</ul>
				<nav aria-label={ data.T("ui.pages") }>
					if data.DashboardPrevious != "" {
						<a class="btn btn-outline btn-sm" rel="prev" href={ templ.SafeURL(data.DashboardPrevious) }>{ data.T("ui.previous_page") }</a>
					}
					if data.DashboardNext != "" {
						<a class="btn btn-outline btn-sm" rel="next" href={ templ.SafeURL(data.DashboardNext) }>{ data.T("items.next_page") }</a>
					}
				</nav>
			</section>
		}
		// The home reflects the workspace's components: the items component
		// surfaces its own create form and newest rows, and the tiles below
		// mirror every enabled feature. The header already names the workspace.
		<section aria-labelledby="workspace-tools-title">
			<h2 id="workspace-tools-title">{ data.T("workspace.tools_title") }</h2>
			<ul class="cards workspace-cards grid list-none gap-4 p-0 grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]">
					if data.ClientsEnabled {
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/clients", data.T("clients.title"), data.T("workspace.clients_description"))
					if data.CanEditClients {
						@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/clients", data.T("engagement.create"), "")
					}
				}
				if data.CatalogEnabled {
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/catalog", data.T("catalog.title"), "")
				}
				if data.SchedulingEnabled {
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/scheduling", data.T("scheduling.title"), "")
				}
				if data.FilesEnabled {
					@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/files", data.T("files.files"), data.T("files.description"))
				}
				@molecules.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/settings", data.T("navigation.settings"), data.T("workspace.settings_description"))
			</ul>
		</section>
	}
}
