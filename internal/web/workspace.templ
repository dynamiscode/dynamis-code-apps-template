package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/components"
import "example.com/dynamis-code/apps-template/internal/web/layouts"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
templ workspaceSelection(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), nil) {
		@components.PageHeading(data.T("workspace.workspaces"), "")
		if data.Error != "" {
			@components.ErrorAlert(data.Error)
		}
		if len(data.Workspaces) > 0 {
			<ul class="cards">
				for _, workspace := range data.Workspaces {
					@components.LinkedCard("/workspaces/" + workspace.ID.String(), workspace.Name, data.Role(workspace.Role))
				}
			</ul>
		} else {
			@components.EmptyState(data.T("workspace.no_memberships"))
		}
		if data.CanCreateWorkspace {
			<section>
				<h2>{ data.T("workspace.create") }</h2>
				<form data-webmcp-actions="workspace-create" action="/workspaces" method="post">
					<input type="hidden" name="csrf" value={ data.CSRF }/>
					@components.TextField("workspace-name", data.T("workspace.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "120"})
					@atoms.Select(atoms.SelectProps{
						ID: "workspace-locale", Name: "locale", Label: data.T("workspace.language_fallback"),
						Options: []atoms.SelectOption{
							{Label: data.T("common.english"), Value: "en", Selected: data.Locale == "en"},
							{Label: data.T("common.spanish"), Value: "es", Selected: data.Locale == "es"},
						},
					})
					@components.SubmitButton(data.T("workspace.create"), nil)
				</form>
			</section>
		}
	}
}
templ workspaceHome(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), layouts.DashboardHomeNavigation(data)) {
					@components.PageHeading(data.Workspace.Name, data.T("workspace.home"))
					<section class="first-task" aria-labelledby="first-task-title">
						<div><p class="eyebrow">{ data.T("workspace.get_started") }</p><h2 id="first-task-title">{ data.T("workspace.first_task_title") }</h2><p>{ data.T("workspace.first_task_description") }</p></div>
						@components.LinkButton("/workspaces/" + data.Workspace.ID.String() + "/items", data.T("items.items"))
					</section>
					<section aria-labelledby="workspace-tools-title">
						<h2 id="workspace-tools-title">{ data.T("workspace.tools_title") }</h2>
						<ul class="cards workspace-cards">
							@components.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/items", data.T("items.items"), data.T("workspace.items_description"))
							if data.ClientsEnabled {
								@components.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/clients", data.T("clients.title"), data.T("workspace.clients_description"))
							}
							if data.FilesEnabled {
								@components.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/files", data.T("files.files"), data.T("files.description"))
							}
							@components.LinkedCard("/workspaces/" + data.Workspace.ID.String() + "/settings", data.T("navigation.settings"), data.T("workspace.settings_description"))
						</ul>
					</section>
	}
}
