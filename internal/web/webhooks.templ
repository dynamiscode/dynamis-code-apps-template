package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/components"
import "example.com/dynamis-code/apps-template/internal/web/layouts"

import (
	"fmt"
	"time"
)

templ webhooksPage(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.DashboardHeader(data), layouts.DashboardSettingsNavigation(data)) {
		<p class="eyebrow">{ data.T("navigation.settings_access") }</p>
		if data.SelectedWebhook.ID != 0 {
			<p><a href={ "/workspaces/" + data.Workspace.ID.String() + "/settings/webhooks" }>← { data.T("webhooks.back_to_webhooks") }</a></p>
			<h1>{ data.SelectedWebhook.Name } { data.T("webhooks.delivery_history") }</h1>
			if len(data.WebhookDeliveries) > 0 {
				<div class="table-scroll" role="region" tabindex="0" aria-label={ data.T("webhooks.delivery_history") }><table class="table">
					<caption>{ data.T("webhooks.delivery_history") }</caption>
					<thead><tr>
						<th scope="col">{ data.T("webhooks.event") }</th>
						<th scope="col">{ data.T("webhooks.status") }</th>
						<th scope="col" class="num">{ data.T("webhooks.attempts") }</th>
						<th scope="col" class="num">{ data.T("webhooks.http_status") }</th>
						<th scope="col">{ data.T("webhooks.created") }</th>
						<th scope="col">{ data.T("webhooks.delivered") }</th>
						<th scope="col">{ data.T("webhooks.error") }</th>
					</tr></thead>
					<tbody>
						for _, delivery := range data.WebhookDeliveries {
							<tr>
								<td><code>{ delivery.EventType }</code></td>
								<td>{ data.T("webhooks.status_" + string(delivery.Status)) }</td>
								<td class="num">{ fmt.Sprint(delivery.AttemptCount) }</td>
								<td class="num">{ webhookStatusCode(delivery.LastStatusCode) }</td>
								<td>{ data.DateTime(delivery.CreatedAt) }</td>
								<td>{ webhookDeliveredAt(data, delivery.DeliveredAt) }</td>
								<td>{ webhookLastError(delivery.LastError) }</td>
							</tr>
						}
					</tbody>
				</table></div>
			} else {
				@components.EmptyState(data.T("webhooks.no_deliveries"))
			}
		} else {
			@components.PageHeading(data.T("webhooks.webhooks"), data.T("navigation.settings_access"))
			<p class="settings-intro">{ data.T("webhooks.description") }</p>
			if data.ErrorKey != "" {
				@components.ErrorAlert(data.T(data.ErrorKey))
			} else if data.Error != "" {
				@components.ErrorAlert(data.Error)
			}
			if data.WebhookReadbackFailed {
				@components.ErrorAlert(data.T("webhooks.readback_warning"))
			}
			if data.CanManage && !data.WebhookSecretKeyConfigured {
				<div id="webhook-secret-key-warning" class="warning alert alert-warning" role="alert">
					<strong>{ data.T("webhooks.secret_key_missing_title") }</strong><p>{ data.T("webhooks.secret_key_missing") }</p>
				</div>
			}
			if data.WebhookSecret != "" {
				<p class="alert alert-warning warning" role="alert" tabindex="-1">{ data.T("webhooks.secret_warning") } <code class="webhook-secret">{ data.WebhookSecret }</code></p>
			}
			if data.CanManage {
				<section class="card" aria-labelledby="new-webhook-heading">
					<h2 id="new-webhook-heading">{ data.T("webhooks.new") }</h2>
					<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/webhooks" } method="post" data-persist="webhook-create" data-unsaved-warning>
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						@components.TextField("webhook-name", data.T("webhooks.name"), templ.Attributes{"name": "name", "required": true, "maxlength": "100", "data-trim": true})
						@components.TextField("webhook-url", data.T("webhooks.endpoint"), templ.Attributes{"name": "url", "type": "url", "required": true, "maxlength": "2048", "aria-describedby": "webhook-url-help", "data-trim": true})
						<p id="webhook-url-help">{ data.T("webhooks.endpoint_help") }</p>
						<fieldset aria-describedby="webhook-events-help"><legend>{ data.T("webhooks.events") }</legend><p id="webhook-events-help">{ data.T("webhooks.events_help") }</p>
							<label><input type="checkbox" name="events" value="item.created"/> <code>item.created</code></label>
							<label><input type="checkbox" name="events" value="item.updated"/> <code>item.updated</code></label>
							<label><input type="checkbox" name="events" value="item.deleted"/> <code>item.deleted</code></label>
							<label><input type="checkbox" name="events" value="client.created"/> <code>client.created</code></label>
							<label><input type="checkbox" name="events" value="client.updated"/> <code>client.updated</code></label>
							<label><input type="checkbox" name="events" value="client.archived"/> <code>client.archived</code></label>
							<label><input type="checkbox" name="events" value="client.deleted"/> <code>client.deleted</code></label>
						</fieldset>
						if data.WebhookSecretKeyConfigured {
							<button class="btn btn-primary" type="submit" name="action" value="create">{ data.T("webhooks.create") }</button>
						} else {
							<button class="btn btn-primary" type="submit" name="action" value="create" disabled aria-describedby="webhook-secret-key-warning">{ data.T("webhooks.create") }</button>
						}
					</form>
				</section>
			}
			if len(data.Webhooks) > 0 {
				<section aria-labelledby="registered-webhooks-heading">
					<h2 id="registered-webhooks-heading">{ data.T("webhooks.registered") }</h2>
					<ul class="webhook-list">
						for _, webhook := range data.Webhooks {
							<li class="card webhook-card">
								<h3>{ webhook.Name }</h3>
								<p><strong>{ data.T("webhooks.endpoint") }:</strong> <code class="webhook-endpoint">{ webhook.URL }</code></p>
								<p><strong>{ data.T("webhooks.events") }:</strong></p><ul>
									for _, event := range webhook.Events {
										<li><code>{ event }</code></li>
									}
								</ul>
								<p><a class="webhook-history-link" href={ "/workspaces/" + data.Workspace.ID.String() + "/settings/webhooks/" + webhook.ID.String() + "/deliveries" }>{ data.T("webhooks.view_deliveries") }</a></p>
								if data.CanManage {
									<div class="actions">
										<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/webhooks/" + webhook.ID.String() } method="post"><input type="hidden" name="csrf" value={ data.CSRF }/>
											if data.WebhookSecretKeyConfigured {
												<button class="btn" type="submit" name="action" value="rotate">{ data.T("webhooks.rotate") }</button>
											} else {
												<button class="btn" type="submit" name="action" value="rotate" disabled aria-describedby="webhook-secret-key-warning">{ data.T("webhooks.rotate") }</button>
											}
										</form>
										<form action={ "/workspaces/" + data.Workspace.ID.String() + "/settings/webhooks/" + webhook.ID.String() } method="post"><input type="hidden" name="csrf" value={ data.CSRF }/><label><input type="checkbox" name="confirm_delete" value="yes" required/> { data.T("webhooks.delete_confirm") }</label><button class="btn btn-error danger" type="submit" name="action" value="delete">{ data.T("webhooks.delete") }</button></form>
									</div>
								}
							</li>
						}
					</ul>
				</section>
			} else if !data.WebhookReadbackFailed {
				@components.EmptyState(data.T("webhooks.none"))
			}
		}
	}
}


func webhookStatusCode(code int) string {
	if code == 0 {
		return "—"
	}
	return fmt.Sprint(code)
}

func webhookDeliveredAt(data viewmodel.PageData, deliveredAt *time.Time) string {
	if deliveredAt == nil {
		return "—"
	}
	return data.DateTime(*deliveredAt)
}

func webhookLastError(message string) string {
	if message == "" {
		return "—"
	}
	return message
}
