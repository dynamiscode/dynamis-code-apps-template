package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

import "strconv"

templ auditHistory(data viewmodel.PageData) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardSettingsNavigation(data)) {
		<p class="eyebrow">{ data.T("navigation.settings_activity") }</p>
		@molecules.PageHeading(data.T("audit.history"), "")
		<p class="settings-intro">{ data.T("audit.description") }</p>
		if data.AuditLazy {
			<div id="audit-table" data-lazy-src={ data.CurrentPath + "?part=table" } aria-busy="true">
				<p class="loading" role="status">@atoms.Loading(atoms.LoadingProps{}) { data.T("ui.loading") }</p>
				<p><a href={ data.CurrentPath + "?all=1" }>{ data.T("audit.show") }</a></p>
			</div>
		} else {
			@auditTable(data)
		}
	}
}

templ auditTable(data viewmodel.PageData) {
	<div id="audit-table">
		if len(data.AuditHistory) > 0 {
			@organisms.AuditDataTable(data.T("audit.history"), data.T("audit.history")) {
				<thead><tr>
					<th scope="col">@atoms.HeaderText(data.T("audit.time"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.event"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.actor"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.auth_method"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.action"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.outcome"), nil)</th>
					<th scope="col">@atoms.HeaderText(data.T("audit.target"), nil)</th>
				</tr></thead>
				<tbody>
					for _, event := range data.AuditHistory {
						<tr>
							<td>{ data.DateTime(event.CreatedAt) }</td>
							<td><code>{ event.EventType }</code></td>
							<td>
								if event.ActorUserID > 0 {
									if data.AuditActor(event.ActorUserID) != "" {
										{ data.AuditActor(event.ActorUserID) }
									} else {
										<code>{ strconv.FormatInt(int64(event.ActorUserID), 10) }</code>
									}
								} else {
									{ data.T("audit.system") }
								}
							</td>
							<td><code>{ event.AuthMethod }</code></td>
							<td><code>{ event.Action }</code></td>
							<td>{ data.AuditOutcome(event.Outcome) }</td>
							<td><code>{ event.TargetType }</code></td>
						</tr>
					}
				</tbody>
			}
		} else {
			<p>{ data.T("audit.none") }</p>
		}
	</div>
}
