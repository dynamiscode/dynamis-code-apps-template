package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

templ filesPage(data viewmodel.PageData, canUpload bool) {
	@templates.DashboardShell(data, templates.DashboardHome) {
		<div class="feature-list-heading">
			@molecules.PageHeading(data.T("files.files"), "")
			if canUpload && data.ListHasContent() {
				<div class="feature-list-heading-actions">
					<div class="list-create"><a class="btn btn-primary" href="#file-upload-heading">{ data.T("files.upload") }</a></div>
				</div>
			}
		</div>
		<div class="files-page">
			if data.ErrorKey != "" {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
			if canUpload {
				<section class="file-upload-panel card my-4 mb-8 gap-2 p-4" aria-labelledby="file-upload-heading">
					<h2 id="file-upload-heading">{ data.T("files.upload") }</h2>
					<form class="file-upload-form" data-file-upload
						data-status-uploading={ data.T("files.status_uploading") }
						data-status-success={ data.T("files.status_success") }
						data-status-error={ data.T("files.status_error") }
						data-status-choose-file={ data.T("files.status_choose_file") }
						action={ data.CurrentPath } method="post" enctype="multipart/form-data">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<div class="file-upload-controls">
							@atoms.FileInput(atoms.FileInputProps{ID: "file-upload", Name: "file", Label: data.T("files.choose"), Required: true})
							@molecules.SubmitButton(data.T("files.upload"), nil)
						</div>
						@atoms.Progress(atoms.ProgressProps{Class: "upload-progress progress-primary w-full max-w-lg my-3 h-3", Value: 0, Max: 100, Label: data.T("files.progress"), Attrs: templ.Attributes{"data-upload-progress": true, "hidden": true}})
						<p class="status-line" role="status" aria-live="polite" data-upload-status hidden></p>
					</form>
				</section>
			}
			<section aria-labelledby="files-list-heading">
				<h2 id="files-list-heading" class="sr-only">{ data.T("files.recent") }</h2>
				@fileListView(data, canUpload)
			</section>
		</div>
		<script defer src="/assets/htmx.min.js"></script>
		if canUpload {
			}
	}
}

templ fileListView(data viewmodel.PageData, canUpload bool) {
	<div class="list-toolbar">
		if data.ListHasContent() {
			@molecules.ListSearch(data, "files.search", data.ListSearch)
		}
		if data.ListHasContent() || len(data.ListViews) > 0 {
			@organisms.ListViewSwitcher(data)
		}
		if data.ListHasContent() {
			@organisms.ListAddFilter(data)
		}
		@fileListTools(data)
	</div>
	@organisms.ListFilterBar(data)
	@fileResults(data, canUpload)
}

// fileListTools are the file list's own controls on the toolbar: the columns.
templ fileListTools(data viewmodel.PageData) {
	if data.ListHasContent() {
		@molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
	}
}

// fileResults is the Files results region, shared with every list: the table or cards and the footer.
templ fileResults(data viewmodel.PageData, canUpload bool) {
	<div id="list-results">
		@fileList(data, canUpload)
		@organisms.ListFooter(data, data.FileListQuery.Limit, listPageSizeOptions(data.FileListQuery.Limit, listPageSizes)) {
			@molecules.ListPager(data)
		}
	</div>
	if data.ListFragment {
		@organisms.ListFilterBarOOB(data)
		@molecules.ListColumnsBody(data, data.ClientQuerySuffix, true)
	}
}

templ fileList(data viewmodel.PageData, canUpload bool) {
	// An empty list renders no table at all: the header row alone reads as a
	// stray bar where the table "would be".
	if len(data.ListRows) > 0 && data.HasVisibleClientColumns {
		@organisms.ListTable(data.T("files.files"), true) {
			@organisms.ListHeader(data, data.T("clients.actions"))
			<tbody>
				for _, row := range data.ListRows {
					@organisms.ListRow(data.CurrentPath + "/" + row.ID + "/content") {
						@organisms.ListCells(data, row, data.CurrentPath + "/" + row.ID + "/content")
						@organisms.ListActionsCell(data, fileRowActions(data, row))
					}
				}
			</tbody>
		}
		@molecules.ListCards() {
			for _, row := range data.ListRows {
				@organisms.ListCardItem(data, row, data.CurrentPath + "/" + row.ID + "/content") {
					@organisms.ListActionsMenu(data, fileRowActions(data, row), true)
				}
			}
		}
	} else if len(data.ListRows) > 0 {
		@molecules.StatusLine(data.T("clients.columns_choose"), nil)
	}
	if len(data.Files) == 0 {
		if data.HasClientFilters || data.ListSearch != "" {
			@molecules.NoMatchesAlert(molecules.NoMatchesAlertProps{ID: "file-empty-state", Message: data.T("files.none"), Href: data.ClearClientFiltersPath, Label: data.T("clients.clear_filters")})
		} else if canUpload {
			@molecules.EmptyStateCardBody(molecules.EmptyStateCardProps{ID: "file-empty-state", Title: data.T("files.empty_title"), Description: data.T("files.empty_description")}) { @filesEmptyCTA(data) }
		} else {
			@molecules.EmptyStateCardBody(molecules.EmptyStateCardProps{ID: "file-empty-state", Title: data.T("files.empty_title"), Description: data.T("files.empty_description")})
		}
	}
}

// filesEmptyCTA anchors the empty state to the upload panel above it.
templ filesEmptyCTA(data viewmodel.PageData) {
	<a class="btn btn-primary btn-sm" href="#file-upload-heading">{ data.T("files.upload") }</a>
}
