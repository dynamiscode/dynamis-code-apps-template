package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import organisms "example.com/dynamis-code/apps-template/internal/web/components/organisms"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"

import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"

templ filesPage(data viewmodel.PageData, canUpload bool) {
	@templates.DashboardShell(data, organisms.DashboardHeader(data), organisms.DashboardHomeNavigation(data)) {
		<div class="files-page">
			if data.ErrorKey != "" {
				@molecules.ErrorAlert(data.T(data.ErrorKey))
			}
			if canUpload {
				<section class="file-upload-panel card" aria-labelledby="file-upload-heading">
					<h2 id="file-upload-heading">{ data.T("files.upload") }</h2>
					<form class="file-upload-form" data-file-upload
						data-status-uploading={ data.T("files.status_uploading") }
						data-status-success={ data.T("files.status_success") }
						data-status-error={ data.T("files.status_error") }
						data-status-choose-file={ data.T("files.status_choose_file") }
						action={ data.CurrentPath } method="post" enctype="multipart/form-data">
						<input type="hidden" name="csrf" value={ data.CSRF }/>
						<div class="file-upload-controls">
							@atoms.FileInput(atoms.FileInputProps{ID: "file-upload", Name: "file", Label: data.T("files.choose"), Required: true})
							@molecules.SubmitButton(data.T("files.upload"), nil)
						</div>
						@atoms.Progress(atoms.ProgressProps{Class: "upload-progress", Value: 0, Max: 100, Label: data.T("files.progress"), Attrs: templ.Attributes{"data-upload-progress": true, "hidden": true}})
						<p class="status" role="status" aria-live="polite" data-upload-status hidden></p>
					</form>
				</section>
			}
			<section aria-labelledby="files-list-heading">
				<h2 id="files-list-heading" class="visually-hidden">{ data.T("files.recent") }</h2>
				@organisms.ListScreen(data, "files.search", fileListTools(data), fileResults(data))
			</section>
		</div>
		<script defer src="/assets/htmx.min.js"></script>
		if canUpload {
			}
	}
}

// fileListTools are the file list's own controls on the toolbar: the columns.
templ fileListTools(data viewmodel.PageData) {
	@molecules.ListColumnsMenu(data, data.ClientQuerySuffix)
}

// fileResults is the Files results region, shared with every list: the table or cards and the footer.
templ fileResults(data viewmodel.PageData) {
	@organisms.ListResults(data, data.FileListQuery.Limit, listPageSizeOptions(data.FileListQuery.Limit, listPageSizes), data.ClientQuerySuffix, fileList(data), templ.NopComponent)
}

templ fileList(data viewmodel.PageData) {
	if data.HasVisibleClientColumns {
		@organisms.ListTable(data.T("files.files"), true) {
			@organisms.ListHeader(data, data.T("clients.actions"))
			<tbody>
				for _, row := range data.ListRows {
					@organisms.ListRow(data.CurrentPath + "/" + row.ID + "/content") {
						@organisms.ListCells(data, row, data.CurrentPath + "/" + row.ID + "/content")
						@organisms.ListActionsCell(data, fileRowActions(data, row))
					}
				}
			</tbody>
		}
		@molecules.ListCards() {
			for _, row := range data.ListRows {
				@organisms.ListCardItem(data, row, data.CurrentPath + "/" + row.ID + "/content") {
					@organisms.ListActionsMenu(data, fileRowActions(data, row), true)
				}
			}
		}
	} else {
		@molecules.StatusLine(data.T("clients.columns_choose"), nil)
	}
	if len(data.Files) == 0 {
		<div class="file-empty-state card" role="status">
			@molecules.EmptyState(data.T("files.none"))
			if data.HasClientFilters {
				<a href={ data.ClearClientFiltersPath }>{ data.T("clients.clear_filters") }</a>
			}
		</div>
	}
}
