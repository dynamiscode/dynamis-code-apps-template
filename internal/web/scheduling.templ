package web

import "example.com/dynamis-code/apps-template/internal/identity"
import "example.com/dynamis-code/apps-template/internal/scheduling"
import "example.com/dynamis-code/apps-template/internal/catalog"
import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"
import templates "example.com/dynamis-code/apps-template/internal/web/components/templates"
import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "strconv"

templ schedulingHoursRow(data viewmodel.PageData, h scheduling.WorkingHours, id string) {
 <fieldset class="flex flex-wrap gap-3 items-end">
  <legend class="sr-only">{ data.T("scheduling.range") }</legend>
  @molecules.EntryField(molecules.EntryFieldProps{ID: id + "-day", Label: data.T("scheduling.day"), Value: strconv.Itoa(h.Weekday), SearchLabel: data.T("ui.search")}) {
   <select id={ id + "-day" } class="select select-bordered w-full" name="weekday" data-entry-picker>
    for day := 0; day < 7; day++ {
     <option value={ strconv.Itoa(day) } selected?={ h.Weekday == day }>{ data.T("scheduling.day_"+strconv.Itoa(day)) }</option>
    }
   </select>
  }
  @molecules.EntryField(molecules.EntryFieldProps{ID: id + "-start", Label: data.T("scheduling.start"), Value: h.Start}) {
   <input id={ id + "-start" } class="input input-bordered w-full" type="time" name="start" value={ h.Start }/>
  }
  @molecules.EntryField(molecules.EntryFieldProps{ID: id + "-end", Label: data.T("scheduling.end"), Value: h.End}) {
   <input id={ id + "-end" } class="input input-bordered w-full" type="time" name="end" value={ h.End }/>
  }
 </fieldset>
}

templ schedulingUser(data viewmodel.PageData, members []identity.MemberSummary, selected, id string) {
 @molecules.EntryField(molecules.EntryFieldProps{ID: id, Label: data.T("scheduling.user"), Value: selected, SearchLabel: data.T("ui.search")}) {
  <select id={ id } class="select select-bordered" name="user_id" data-entry-picker><option value="">{ data.T("scheduling.no_user") }</option>
   for _, member := range members {
    <option value={ member.UserID.String() } selected?={ selected == member.UserID.String() }>{ member.Email }</option>
   }
  </select>
 }
}

templ schedulingEngagement(data viewmodel.PageData, options []scheduling.EngagementOption, selected, id string) {
 @molecules.EntryField(molecules.EntryFieldProps{ID: id, Label: data.T("scheduling.engagement"), Value: selected, SearchLabel: data.T("ui.search")}) {
  <select id={ id } class="select select-bordered" name="engagement_id" data-entry-picker>
   <option value="">{ data.T("scheduling.no_engagement") }</option>
   for _, option := range options {
    <option value={ option.ID.String() } selected?={ selected == option.ID.String() }>{ option.Label }</option>
   }
  </select>
 }
}

templ schedulingPage(data viewmodel.PageData, resources []scheduling.Resource, zone string, members []identity.MemberSummary, bookings map[scheduling.ResourceID][]scheduling.Booking, history map[scheduling.BookingID][]scheduling.BookingMove, entries []catalog.Entry, engagements []scheduling.EngagementOption, canWrite bool, canBook bool, invalid bool, draft schedulingDraft) {
 @templates.DashboardShell(data, templates.DashboardHome) {
  @molecules.PageHeading(data.T("scheduling.title"), "")
  if invalid {
   <div role="alert" tabindex="-1" autofocus class="alert alert-error">
    if draft.action == "booking" || draft.action == "move" {
     { data.T("scheduling."+draft.bookingError) }
    } else if draft.action == "zone" {
     { data.T("scheduling.invalid_zone") }
    } else if draft.action == "hours" {
     { data.T("scheduling.invalid_hours") }
    } else {
     { data.T("scheduling.invalid") }
    }
   </div>
  }
  <p>{ data.T("scheduling.zone") }: { zone }</p>
  if canWrite {
   {{ zoneInput := zone }}
   if draft.action == "zone" {
    {{ zoneInput = draft.zone }}
   }
   <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/time-zone") } class="card bg-base-100 p-4 space-y-3 max-w-xl">
    <input type="hidden" name="csrf" value={ data.CSRF }/>
    @molecules.EntryField(molecules.EntryFieldProps{ID: "scheduling-zone", Label: data.T("scheduling.zone"), Value: zoneInput}) {
     <input id="scheduling-zone" class="input input-bordered" name="time_zone" value={ zoneInput } required/>
    }
    <button class="btn btn-primary w-fit" type="submit">{ data.T("common.save") }</button>
   </form>
   {{ createName, createUser := "", "" }}
   if draft.action == "create" {
    {{ createName, createUser = draft.name, draft.userID }}
   }
   <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling") } class="card bg-base-100 p-4 space-y-3 max-w-xl">
    <input type="hidden" name="csrf" value={ data.CSRF }/>
    @molecules.EntryField(molecules.EntryFieldProps{ID: "scheduling-create-name", Label: data.T("scheduling.name"), Value: createName}) {
     <input id="scheduling-create-name" class="input input-bordered" name="name" value={ createName } required/>
    }
    @schedulingUser(data, members, createUser, "scheduling-create-user")
    <button class="btn btn-primary w-fit" type="submit">{ data.T("common.create") }</button>
   </form>
  }
  if len(resources) == 0 {
   @molecules.EmptyState(data.T("scheduling.empty"))
  } else {
   <ul class="space-y-2">
    for _, resource := range resources {
     <li class="card bg-base-100 p-4"><strong>{ resource.Name }</strong>
      <h2 class="font-semibold">{ data.T("scheduling.bookings") }</h2>
      if len(bookings[resource.ID]) == 0 {
       <p>{ data.T("scheduling.no_bookings") }</p>
      } else {
       <ul>
        for _, booking := range bookings[resource.ID] {
         <li>
          if canBook && booking.Status != scheduling.BookingCancelled && booking.Status != scheduling.BookingNoShow {
           {{ savedStart := booking.Start.Format("2006-01-02T15:04") }}
           {{ moveStart := savedStart }}
           {{ moveDraft := draft.action == "move" && draft.bookingID == booking.ID.String() }}
           if moveDraft {
            {{ moveStart = draft.start }}
           }
           @molecules.InlineEditor(molecules.InlineEditorProps{
            Saved: savedStart, Value: moveStart, Display: booking.Start.Format("2006-01-02 15:04"),
            Label: data.T("scheduling.start"), InputLabel: data.T("scheduling.start") + " (" + zone + ")",
            EditLabel: data.T("ui.edit"), SaveLabel: data.T("scheduling.move"), CancelLabel: data.T("common.cancel"),
            ID: "booking-start-" + booking.ID.String(), Name: "start", InputType: "datetime-local", Required: true,
            Action: "/workspaces/" + data.Workspace.ID.String() + "/scheduling/" + resource.ID.String() + "/bookings/" + booking.ID.String() + "/move",
            CancelURL: "/workspaces/" + data.Workspace.ID.String() + "/scheduling",
            CSRF: data.CSRF, Draft: moveDraft, FormDraft: moveDraft, Confirm: data.T("ui.confirm_change"),
           })
          } else {
           { booking.Start.Format("2006-01-02 15:04") }
          }
          –{ booking.End.Format("15:04") }: { booking.EntryName } ({ string(booking.Status) })
          if len(history[booking.ID]) > 0 {
           <details><summary class="btn btn-outline btn-sm">{ data.T("scheduling.history") }</summary><ul>
            for _, move := range history[booking.ID] {
             {{ actorName := move.ActorID.String() }}
             for _, member := range members {
              if member.UserID == move.ActorID {
               {{ actorName = member.Email }}
              }
             }
             <li>{ move.OldStart.Format("2006-01-02 15:04 UTC") }–{ move.OldEnd.Format("15:04 UTC") } → { move.NewStart.Format("2006-01-02 15:04 UTC") }–{ move.NewEnd.Format("15:04 UTC") }; { actorName }; { move.MovedAt.Format("2006-01-02 15:04 UTC") }</li>
            }
           </ul></details>
          }
          for _, option := range engagements {
           if booking.EngagementID != nil && *booking.EngagementID == option.ID {
            <a class="btn btn-outline btn-sm h-auto min-h-8 max-w-full whitespace-normal break-words" href={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/clients/"+option.ClientID.String()) }>{ option.Label }</a>
           }
          }
          if canBook && len(engagements) > 0 {
           <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/bookings/"+booking.ID.String()+"/engagement") } data-confirm-select>
            <input type="hidden" name="csrf" value={ data.CSRF }/>
            if booking.EngagementID != nil {
             @schedulingEngagement(data, engagements, booking.EngagementID.String(), "booking-engagement-" + booking.ID.String())
            } else {
             @schedulingEngagement(data, engagements, "", "booking-engagement-" + booking.ID.String())
            }
            <div data-confirm-select-fallback><button class="btn btn-sm" type="submit">{ data.T("common.save") }</button></div>
            @confirmSelectDialog(data, data.T("scheduling.engagement"))
           </form>
          }
          if canBook && booking.Status == scheduling.BookingBooked {
           <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/"+resource.ID.String()+"/bookings/"+booking.ID.String()+"/status") }>
            <input type="hidden" name="csrf" value={ data.CSRF }/>
            <button class="btn btn-sm" name="status" value="done">{ data.T("scheduling.done") }</button>
            <button class="btn btn-sm" name="status" value="cancelled">{ data.T("scheduling.cancelled") }</button>
            <button class="btn btn-sm" name="status" value="no-show">{ data.T("scheduling.no_show") }</button>
           </form>
          }
         </li>
        }
       </ul>
      }
      if canBook && len(entries) > 0 {
       <details open?={ draft.action == "booking" && draft.resourceID == resource.ID.String() }><summary class="btn btn-sm">{ data.T("scheduling.book") }</summary>
        <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/"+resource.ID.String()+"/bookings") } class="space-y-3">
         <input type="hidden" name="csrf" value={ data.CSRF }/>
         @molecules.EntryField(molecules.EntryFieldProps{ID: "booking-entry-" + resource.ID.String(), Label: data.T("scheduling.entry"), Value: draft.entryID, SearchLabel: data.T("ui.search")}) {
          <select id={ "booking-entry-" + resource.ID.String() } class="select select-bordered" name="entry_id" required data-entry-picker>
           for _, entry := range entries {
            <option value={ entry.ID.String() } selected?={ draft.entryID == entry.ID.String() }>{ entry.Name }</option>
           }
          </select>
         }
         if len(engagements) > 0 {
          @schedulingEngagement(data, engagements, draft.engagementID, "booking-new-engagement-" + resource.ID.String())
         }
         @molecules.EntryField(molecules.EntryFieldProps{ID: "booking-new-start-" + resource.ID.String(), Label: data.T("scheduling.start") + " (" + zone + ")", Value: draft.start}) {
          <input id={ "booking-new-start-" + resource.ID.String() } class="input input-bordered" type="datetime-local" name="start" value={ draft.start } required/>
         }
         <button class="btn btn-primary" type="submit">{ data.T("scheduling.book") }</button>
        </form>
       </details>
      }
      <p>{ data.T("scheduling.hours") }</p>
      if len(resource.WorkingHours) == 0 {
       <p>{ data.T("scheduling.no_hours") }</p>
      } else {
       <ul>
        for _, hours := range resource.WorkingHours {
         <li>{ data.T("scheduling.day_"+strconv.Itoa(hours.Weekday)) }: { hours.Start }–{ hours.End }</li>
        }
       </ul>
      }
      for _, member := range members {
       if resource.UserID != nil && *resource.UserID == member.UserID {
        <span>{ member.Email }</span>
       }
      }
      if canWrite {
       {{ hours := resource.WorkingHours }}
       if draft.action == "hours" && draft.resourceID == resource.ID.String() {
        {{ hours = draft.hours }}
       }
       <details open?={ draft.action == "hours" && draft.resourceID == resource.ID.String() }><summary class="btn btn-sm">{ data.T("scheduling.edit_hours") }</summary>
       <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/"+resource.ID.String()+"/working-hours") } class="space-y-3">
        <input type="hidden" name="csrf" value={ data.CSRF }/>
        <p>{ data.T("scheduling.hours_help") }</p>
        for i, hour := range hours {
         @schedulingHoursRow(data, hour, "scheduling-hours-" + resource.ID.String() + "-" + strconv.Itoa(i))
        }
        @schedulingHoursRow(data, scheduling.WorkingHours{}, "scheduling-hours-" + resource.ID.String() + "-new")
        <button class="btn btn-primary" type="submit">{ data.T("common.save") }</button>
       </form>
       </details>
       {{ name, userID := resource.Name, "" }}
       if resource.UserID != nil {
        {{ userID = resource.UserID.String() }}
       }
       if draft.resourceID == resource.ID.String() && draft.action != "hours" && draft.action != "booking" && draft.action != "move" {
        {{ name, userID = draft.name, draft.userID }}
       }
       <details open?={ draft.resourceID == resource.ID.String() && draft.action != "hours" && draft.action != "booking" && draft.action != "move" }><summary class="btn btn-sm">{ data.T("ui.edit") }</summary>
        <form method="post" action={ templ.SafeURL("/workspaces/"+data.Workspace.ID.String()+"/scheduling/"+resource.ID.String()+"/edit") } class="space-y-3">
         <input type="hidden" name="csrf" value={ data.CSRF }/>
         @molecules.EntryField(molecules.EntryFieldProps{ID: "scheduling-edit-name-" + resource.ID.String(), Label: data.T("scheduling.name"), Value: name}) {
          <input id={ "scheduling-edit-name-" + resource.ID.String() } class="input input-bordered" name="name" value={ name } required/>
         }
         @schedulingUser(data, members, userID, "scheduling-edit-user-" + resource.ID.String())
         <button class="btn btn-primary" type="submit">{ data.T("common.save") }</button>
        </form>
       </details>
      }
     </li>
    }
   </ul>
  }
 }
}
