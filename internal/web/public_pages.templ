package web

import molecules "example.com/dynamis-code/apps-template/internal/web/components/molecules"

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import atoms "example.com/dynamis-code/apps-template/internal/web/components/atoms"

templ mcpConsentPage(data viewmodel.PageData) {
	@authLayout(data, data.T("oauth.consent_title")) {
		<h1>{ data.T("oauth.consent_title") }</h1>
		if consent := data.MCPConsent; consent != nil {
			<p>{ data.T("oauth.consent_intro") }</p>
			<dl class="consent-details">
				<div><dt>{ data.T("oauth.client_label") }</dt><dd>{ consent.ClientName }</dd></div>
				<div>
					<dt>{ data.T("oauth.scopes_label") }</dt>
					<dd><ul>
						for _, scope := range consent.Scopes {
							<li>{ data.T(mcpScopeKey(scope)) }</li>
						}
					</ul></dd>
				</div>
			</dl>
			<form action="/oauth/authorize" method="post">
				<input type="hidden" name="csrf" value={ data.CSRF }/>
				<input type="hidden" name="response_type" value="code"/>
				<input type="hidden" name="client_id" value={ consent.Params.ClientID }/>
				<input type="hidden" name="redirect_uri" value={ consent.Params.RedirectURI }/>
				<input type="hidden" name="code_challenge" value={ consent.Params.CodeChallenge }/>
				<input type="hidden" name="code_challenge_method" value="S256"/>
				<input type="hidden" name="resource" value={ consent.Params.Resource }/>
				<input type="hidden" name="scope" value={ consent.Params.Scope }/>
				<input type="hidden" name="state" value={ consent.Params.State }/>
				<fieldset class="consent-workspaces">
					<legend>{ data.T("common.workspace") }</legend>
					@atoms.Radio(atoms.RadioProps{
						Name:     "workspace_id",
						Required: true,
						Options:  consentWorkspaceOptions(consent.Workspaces),
					})
				</fieldset>
				<p class="status-line">{ data.T("oauth.consent_help") } { data.T("oauth.consent_scope_note") }</p>
				<div class="consent-actions">
					@atoms.Button(atoms.ButtonProps{
						Class: "btn-primary",
						Label: data.T("oauth.approve"),
						Attrs: templ.Attributes{"type": "submit", "name": "decision", "value": "approve"},
					})
					@atoms.Button(atoms.ButtonProps{
						Class: "btn-outline",
						Label: data.T("oauth.deny"),
						Attrs: templ.Attributes{"type": "submit", "name": "decision", "value": "deny"},
					})
				</div>
			</form>
		}
	}
}

templ errorPage(data viewmodel.PageData) {
	@authLayout(data, data.Title) {
		<h1>{ data.Title }</h1>
		@molecules.ErrorAlert(data.Error)
		<p><a class="btn btn-outline btn-sm" href="/">{ data.T("navigation.home") }</a></p>
	}
}

func mcpScopeKey(scope string) string {
	if scope == "resources:write" {
		return "oauth.scope_write"
	}
	return "oauth.scope_read"
}

func consentWorkspaceOptions(workspaces []viewmodel.McpWorkspaceChoice) []atoms.RadioOption {
	options := make([]atoms.RadioOption, 0, len(workspaces))
	for i, workspace := range workspaces {
		options = append(options, atoms.RadioOption{Label: workspace.Name, Value: workspace.ID, Checked: i == 0})
	}
	return options
}
