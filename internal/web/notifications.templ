package web

import "example.com/dynamis-code/apps-template/internal/web/viewmodel"
import "example.com/dynamis-code/apps-template/internal/web/layouts"

templ notificationsPage(data viewmodel.PageData) {
	@layouts.DashboardShell(data, layouts.AccountHeader(data), nil) {
		<div class="notification-center" data-notification-cursor={ data.NotificationCursor }>
				<div class="workspace-heading"><div>
					<p class="eyebrow">{ data.T("common.account") }</p>
					<h1>{ data.T("notifications.notifications") }</h1>
					<p class="notification-description">{ data.T("notifications.description") }</p>
				</div></div>
				<p class="notification-summary" role="status" aria-live="polite">
					<span>{ data.T("notifications.unread") }</span>
					<span class="badge badge-primary"><strong data-unread-count>{ data.UnreadNotifications }</strong></span>
				</p>
				<p class="notification-live" role="status" aria-live="polite"
					data-notification-live
					data-updated={ data.T("notifications.live_updated") }
					data-disconnected={ data.T("notifications.live_disconnected") }></p>
				<p><a href="/notifications">{ data.T("notifications.refresh") }</a> · <a href="/account">{ data.T("notifications.manage_preferences") }</a></p>
				if len(data.Notifications) > 0 {
					<ul class="list notification-list">
						for _, notification := range data.Notifications {
							<li class="list-row notification-card">
								<div>
									<div class="notification-card-heading">
										<h2>{ notification.Title }</h2>
										if notification.ReadAt != nil {
											<span class="badge notification-read">{ data.T("notifications.read") }</span>
										} else {
											<span class="badge badge-primary notification-unread">{ data.T("notifications.unread_status") }</span>
										}
									</div>
									<p>{ notification.Body }</p>
									<time datetime={ notification.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ data.DateTime(notification.CreatedAt) }</time>
								</div>
								if notification.ReadAt == nil {
									<form class="inline" action={ "/notifications/" + notification.ID.String() } method="post">
										<input type="hidden" name="csrf" value={ data.CSRF }/>
										<button class="btn btn-secondary" type="submit">{ data.T("notifications.mark_read") }</button>
									</form>
								}
							</li>
						}
					</ul>
				} else {
					<section class="notification-empty" aria-labelledby="notification-empty-title">
						<h2 id="notification-empty-title">{ data.T("notifications.none") }</h2>
						<p>{ data.T("notifications.empty_description") }</p>
						<a href="/account">{ data.T("notifications.manage_preferences") }</a>
					</section>
				}
		</div>
	}
}
